<UserControl x:Class="SampleProject.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Shell}">
  <TextBlock Text="账号配置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,16" />
  <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding CanEdit}">
   <TextBlock Text="{Binding Editor.Id, StringFormat=当前编辑：{0}}" Style="{StaticResource Title}" />
   <TextBlock Text="连接与运行参数" FontWeight="SemiBold" Margin="0,0,0,14" />
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" /></Grid.RowDefinitions>
    <TextBlock Text="设备地址" /><TextBox Grid.Column="1" Text="{Binding Editor.DeviceUri, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="1" Text="绑定驱动" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.BindingDriverFileName, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="2" Text="进程名称" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Editor.ProcessName, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="3" Text="指定 PID（0=按名）" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Editor.ProcessId, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <TextBlock Grid.Row="4" Text="连接检查间隔 / ms" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Editor.ProbeIntervalMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
    <TextBlock Grid.Row="5" Text="重试基础间隔 / ms" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Editor.RetryDelayMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
   </Grid>
   <CheckBox Content="记录正式快照，供诊断和回放使用" IsChecked="{Binding Editor.RecordSnapshots}" Margin="0,16" />
   <TextBlock Text="DMA 附加参数（JSON 数组）" Margin="0,0,0,6" /><TextBox Text="{Binding Editor.ArgumentsJson, UpdateSourceTrigger=PropertyChanged}" />
   <TextBlock Text="模块参数（JSON 对象）" Margin="0,14,0,6" /><TextBox Text="{Binding Editor.ModuleSettingsJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
   <TextBlock Text="{Binding VerificationResult}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="清除设备绑定" Command="{Binding ClearBindingCommand}" /><Button Content="删除账号" Command="{Binding DeleteCommand}" /><Button Content="验证配置" Command="{Binding VerifyCommand}" /><Button Content="保存配置" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" /></StackPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding ConfigurationPath}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
