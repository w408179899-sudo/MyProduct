<UserControl x:Class="SampleProject.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,3" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style x:Key="CompactPrimary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,3" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="6,2" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Shell}">
  <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource CompactButton}" Content="新增账号" Command="{Binding NewCommand}" /><Button Style="{StaticResource CompactButton}" Content="导入" Command="{Binding ImportCommand}" /><Button Style="{StaticResource CompactButton}" Content="导出" Command="{Binding ExportCommand}" /></StackPanel><TextBlock Text="脚本主页" FontSize="20" FontWeight="SemiBold" /></DockPanel>
  <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
   <Border.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource CompactComboBox}" />
   </Border.Resources>
   <StackPanel>
   <Grid IsEnabled="{Binding CanEdit}" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /><ColumnDefinition Width="126" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="账号名称" /><TextBox Grid.Column="1" Text="{Binding Editor.Id, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Grid.Column="2" Text="运行模式" /><ComboBox Grid.Column="3" ItemsSource="{Binding Modes}" SelectedItem="{Binding Editor.Mode}" /><Button Grid.Column="4" Content="测试读角色" ToolTip="读取角色并验证配置，通过后才能保存" Command="{Binding VerifyCommand}" /><Button Grid.Column="5" Style="{StaticResource CompactPrimary}" Content="保存账号配置" Command="{Binding SaveCommand}" />
   </Grid>
   <TextBlock Text="{Binding VerificationResult}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6" />
   <Border Background="#EFF6F2" CornerRadius="5" Padding="7,4" Margin="0,0,0,8"><TextBlock Text="读到角色并完成 KMBox 握手后才能保存。单项诊断、Mock 验证均不代表真实角色验证。" Style="{StaticResource Hint}" TextWrapping="Wrap" /></Border>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="245" /></Grid.ColumnDefinitions>
   <Grid IsEnabled="{Binding CanUseHardware}" Margin="0,0,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="VMM 库" /><TextBox Grid.Column="1" Text="{Binding Editor.LibraryPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择与 DMA 驱动配套的 vmm.dll" /><Button Grid.Column="2" Content="浏览文件" Command="{Binding BrowseLibraryCommand}" />
    <TextBlock Grid.Row="1" Text="DMA 设备" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Label" /><Button Grid.Row="1" Grid.Column="2" Content="刷新设备" Command="{Binding DiscoverCommand}" />
    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Editor.BindingStatus}" Style="{StaticResource Hint}" Margin="0,2,0,4" />
    <TextBlock Grid.Row="3" Text="目标进程" /><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Label" /><Button Grid.Row="3" Grid.Column="2" Content="刷新进程" Command="{Binding ListProcessesCommand}" />
    <TextBlock Grid.Row="4" Text="目标模块" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Editor.ModuleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="填写主程序或需要读取的模块文件名" /><Button Grid.Row="4" Grid.Column="2" Content="模块诊断" Command="{Binding ProbeCommand}" />
    <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DmaResult}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
   </Grid>
   <Border Grid.Column="1" BorderBrush="#E4EBE7" BorderThickness="1,0,0,0" Padding="12,0,0,0"><StackPanel>
    <TextBlock Text="KMBox 输入设备" FontWeight="SemiBold" Margin="0,0,0,3" />
    <Grid IsEnabled="{Binding CanUseHardware}"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="IP" /><TextBox Grid.Column="1" Text="{Binding Editor.Address, UpdateSourceTrigger=PropertyChanged}" />
     <TextBlock Grid.Row="1" Text="Port" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.Port, UpdateSourceTrigger=PropertyChanged}" />
     <TextBlock Grid.Row="2" Text="MAC" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Editor.Mac, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" />
     <Button Grid.Row="3" Grid.Column="1" Content="测试连接" Command="{Binding TestInputCommand}" Margin="0,4,8,0" />
    </Grid>
    <TextBlock Text="{Binding InputResult}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
   </StackPanel></Border>
   </Grid>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="启动选中" Style="{StaticResource Primary}" Command="{Binding StartCommand}" /><Button Content="暂停" Command="{Binding PauseCommand}" /><Button Content="停止" Command="{Binding StopCommand}" /><Button Content="启动全部" Command="{Binding StartAllCommand}" Margin="18,0,4,0" /><Button Content="停止全部" Command="{Binding StopAllCommand}" /></StackPanel><TextBlock Text="账号运行" FontSize="16" FontWeight="SemiBold" /></DockPanel>
   <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Height="132" IsEnabled="{Binding CanEdit}">
    <DataGrid.Columns><DataGridTextColumn Header="账号" Binding="{Binding Id}" Width="*" /><DataGridTextColumn Header="已确认角色" Binding="{Binding TestedCharacter}" Width="140" /><DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="65" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="85" /><DataGridTextColumn Header="实际 PID" Binding="{Binding Pid}" Width="90" /><DataGridTextColumn Header="运行时长" Binding="{Binding Elapsed}" Width="100" /><DataGridTextColumn Header="循环" Binding="{Binding Ticks}" Width="70" /><DataGridTextColumn Header="动作" Binding="{Binding Actions}" Width="65" /></DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{Binding SelectedAccount.Error}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
