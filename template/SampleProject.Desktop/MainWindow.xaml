<Window x:Class="SampleProject.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Smart · 脚本控制台" Style="{StaticResource {x:Type Window}}" Width="1220" Height="860" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Background="#F3F6F5">
  <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DFE8E3" BorderThickness="0,0,0,1">
   <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Accent}" CornerRadius="8" Width="38" Height="38"><TextBlock Text="S" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="SMART  /  脚本控制台" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="设备连接 · 多账号运行 · 统一配置" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
    <Border Grid.Column="2" Background="#EAF5EF" CornerRadius="15" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="{Binding Overview}" Foreground="{StaticResource Accent}" /></Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="172" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DFE8E3" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,22,12,16">
     <StackPanel DockPanel.Dock="Bottom" Margin="12,0"><TextBlock Text="本地工作区" Style="{StaticResource Hint}" /><TextBlock Text="配置随账号独立保存" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
     <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent" VerticalAlignment="Top">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12" /><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavigationItem" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavigationItem" Property="Background" Value="#E8F3ED" /><Setter Property="Foreground" Value="#147D64" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Symbol}" Width="25" /><TextBlock Text="{Binding Title}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <ContentControl Grid.Column="1" Content="{Binding SelectedPage.Content}" Margin="24,20,24,4" />
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DFE8E3" BorderThickness="0,1,0,0" Padding="16,8">
   <DockPanel><Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" MinHeight="26" Padding="10,2" /><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#4B685C" /></DockPanel>
  </Border>
 </Grid>
</Window>
