<Application x:Class="SampleProject.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:SampleProject.Desktop.ViewModels"
 xmlns:views="clr-namespace:SampleProject.Desktop.Views">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries>
   <DataTemplate DataType="{x:Type vm:HomePage}"><views:HomeView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:SettingsPage}"><views:SettingsView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:DiagnosticsPage}"><views:DiagnosticsView /></DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
