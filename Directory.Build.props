<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <SmartFrameworkVersion>0.5.0</SmartFrameworkVersion>
    <Version>$(SmartFrameworkVersion)</Version>
    <SmartFrameworkProject>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^Smart\.(Contracts|Data|Runtime|Hosting(\.Windows)?|Adapters\.(Dma|KmBox))$'))</SmartFrameworkProject>
    <Description>Business-free DMA/VMM and KMBox runtime foundation.</Description>
  </PropertyGroup>
</Project>
