<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../tools/native-worker/*">
      <Link>native-worker/%(Filename)%(Extension)</Link><TargetPath>native-worker/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><Pack>false</Pack>
    </Content>
  </ItemGroup>
</Project>
