local state = {}

function M.refresh_flow_owner_snapshot(current_time, blackboard)
    blackboard = type(blackboard) == "table" and blackboard or M.current_blackboard(current_time)
    local owner = nil
    if type(M._leveling_flow_owner) == "table"
        and type(M._leveling_flow_owner.evaluate) == "function"
    then
        owner = M._leveling_flow_owner.evaluate(blackboard)
    end
    if type(owner) ~= "table" then
        owner = {
            priority = 900,
            owner = "idle",
            node = "idle",
            reason = "flow_owner_unavailable",
            blocks_main_task = false,
            allows_combat_sidecar = true,
            diagnostic_only = true
        }
    end
    state.current_flow_owner = owner
    if type(blackboard) == "table" then
        blackboard.scheduler = owner
    end
    return owner
end

function M.current_flow_owner(current_time)
    if type(state.current_flow_owner) ~= "table" then
        M.refresh_flow_owner_snapshot(current_time, state.current_blackboard)
    end
    return state.current_flow_owner
end

function M.current_flow_owner_allows(current_time, owner)
    local flow_owner = M.current_flow_owner(current_time)
    if type(M._leveling_flow_owner) == "table"
        and type(M._leveling_flow_owner.allows) == "function"
    then
        return M._leveling_flow_owner.allows(flow_owner, owner)
    end
    return true, "flow_owner_gate_unavailable"
end

function M.bt_infer_selector_owner(key, children)
    if type(M._leveling_flow_owner) == "table"
        and type(M._leveling_flow_owner.owner_for_selector_key) == "function"
    then
        local owner, source = M._leveling_flow_owner.owner_for_selector_key(key, children)
        owner = tostring(owner or "")
        if owner ~= "" then
            return owner, source
        end
    end
    if type(children) ~= "table" then
        return "", "ownerless"
    end
    for _, child in ipairs(children) do
        if type(child) == "table" then
            local owner = tostring(child.owner or "")
            if owner ~= "" then
                return owner, "first_child"
            end
        end
    end
    return "", "ownerless"
end

function M.bt_observe_owner_gate(current_time, key, owner, opts)
    opts = type(opts) == "table" and opts or {}
    owner = tostring(owner or "")
    key = tostring(key or "")
    if owner == "" then
        return true, "ownerless"
    end

    local allowed, reason = M.current_flow_owner_allows(current_time, owner)
    local flow_owner = type(state.current_flow_owner) == "table" and state.current_flow_owner or {}
    local status = {
        key = key,
        owner = owner,
        allowed = allowed == true,
        reason = tostring(reason or ""),
        scheduler_owner = tostring(flow_owner.owner or ""),
        scheduler_node = tostring(flow_owner.node or ""),
        scheduler_reason = tostring(flow_owner.reason or ""),
        scheduler_priority = tonumber(flow_owner.priority),
        source = tostring(opts.source or ""),
        at = tonumber(current_time) or 0,
        enforce = opts.enforce == true
    }

    if type(state.bt_owner_gate_statuses) ~= "table" then
        state.bt_owner_gate_statuses = {}
    end
    state.bt_owner_gate_statuses[key] = status
    state.bt_owner_gate_last = status

    if allowed ~= true and (opts.enforce == true or opts.count_mismatch == true) then
        state.bt_owner_gate_mismatch_count = (tonumber(state.bt_owner_gate_mismatch_count) or 0) + 1
        state.bt_owner_gate_last_mismatch = status
        if opts.enforce == true then
            state.bt_owner_gate_blocked_count = (tonumber(state.bt_owner_gate_blocked_count) or 0) + 1
            M.bt_record_node(current_time, "owner_gate." .. key, owner, "blocked", reason)
            return false, reason
        end
    end

    return true, reason
end

function M.bt_owner_gate_enforce_enabled(key, owner)
    key = tostring(key or "")
    owner = tostring(owner or "")
    local cfg = type(M._leveling_config) == "table"
        and M._leveling_config.LEVELING_BT_OWNER_GATE_ENFORCE
        or nil
    if cfg == true then
        return true
    end
    if type(cfg) ~= "table" then
        return false
    end

    if type(cfg.selectors) == "table" then
        local selector_value = cfg.selectors[key]
        if selector_value == false then
            return false
        elseif selector_value == true then
            return true
        end
    end

    if type(cfg.owners) == "table" then
        local owner_value = cfg.owners[owner]
        if owner_value == false then
            return false
        elseif owner_value == true then
            return true
        end
    end

    return cfg.all == true
end

function M.bt_active_owner_enforce_enabled()
    return type(M._leveling_config) == "table"
        and M._leveling_config.LEVELING_BT_ACTIVE_OWNER_ENFORCE == true
end

function M.bt_execution_enabled(key)
    key = tostring(key or "")
    local cfg = type(M._leveling_config) == "table"
        and M._leveling_config.LEVELING_BT_EXECUTION_ENABLED
        or nil
    if cfg == true then
        return true
    end
    if cfg == false or cfg == nil then
        return false
    end
    if type(cfg) ~= "table" then
        return false
    end

    if type(cfg.selectors) == "table" then
        local selector_value = cfg.selectors[key]
        if selector_value == false then
            return false
        elseif selector_value == true then
            return true
        end
    end

    return cfg.all == true
end

function M.refresh_blackboard_snapshot(current_time, opts)
    opts = type(opts) == "table" and opts or {}
    local blackboard = nil
    if type(M._leveling_blackboard) == "table"
        and type(M._leveling_blackboard.snapshot) == "function"
    then
        blackboard = M._leveling_blackboard.snapshot(state, current_time, opts)
    end
    if type(blackboard) ~= "table" then
        blackboard = {
            current_time = tonumber(current_time) or 0,
            now = tonumber(current_time) or 0,
            stage = tostring(state.stage or ""),
            state = state
        }
    end
    blackboard.root = state
    blackboard.bt_active_owner_enforce = M.bt_active_owner_enforce_enabled()
    state.current_blackboard = blackboard
    state.current_blackboard_tick = tonumber(current_time) or 0
    M.refresh_flow_owner_snapshot(current_time, blackboard)
    return blackboard
end

function M.current_blackboard(current_time, opts)
    local tick = tonumber(current_time) or 0
    if type(state.current_blackboard) ~= "table"
        or tonumber(state.current_blackboard_tick) ~= tick
    then
        M.refresh_blackboard_snapshot(current_time, opts)
    end

    if type(opts) ~= "table" then
        return state.current_blackboard
    end

    local overlay = {}
    local has_overlay = false
    for key, value in pairs(opts) do
        overlay[key] = value
        has_overlay = true
    end
    if not has_overlay then
        return state.current_blackboard
    end
    overlay.current_time = overlay.current_time or tick
    overlay.now = overlay.now or tick
    return setmetatable(overlay, { __index = state.current_blackboard })
end

function M.bt_begin_tick(current_time)
    if type(M._leveling_bt) == "table" and type(M._leveling_bt.begin_tick) == "function" then
        return M._leveling_bt.begin_tick(state, current_time)
    end
    return nil
end

function M.bt_record_node(current_time, key, owner, result, reason)
    if type(M._leveling_bt) == "table" and type(M._leveling_bt.record) == "function" then
        local flow_owner = type(state.current_flow_owner) == "table" and state.current_flow_owner or {}
        return M._leveling_bt.record(state, key, result, {
            owner = owner,
            current_time = current_time,
            stage = state.stage,
            reason = reason,
            scheduler = flow_owner,
            scheduler_owner = flow_owner.owner,
            scheduler_node = flow_owner.node,
            scheduler_reason = flow_owner.reason,
            scheduler_priority = flow_owner.priority
        })
    end
    return result
end

function M.bt_get_legacy_bool_node(key, owner, fn)
    if type(M._leveling_bt) ~= "table" or type(M._leveling_bt.legacy_bool_node) ~= "function" then
        return nil
    end
    if type(state.bt_node_cache) ~= "table" then
        state.bt_node_cache = {}
    end

    local cache_key = tostring(key or "") .. "|" .. tostring(owner or "")
    local cached = state.bt_node_cache[cache_key]
    if type(cached) == "table" and cached._legacy_fn == fn then
        return cached
    end

    local node = M._leveling_bt.legacy_bool_node({
        key = key,
        owner = owner,
        tick = function(_, blackboard)
            local args = type(blackboard) == "table" and blackboard.args or nil
            if type(args) ~= "table" then
                return false, "missing legacy args"
            end
            local unpack_fn = table.unpack or unpack
            return fn(unpack_fn(args))
        end
    })
    node._legacy_fn = fn
    state.bt_node_cache[cache_key] = node
    return node
end

function M.bt_run_legacy_bool_node(ctx, current_time, key, owner, fn, ...)
    if type(fn) ~= "function" then
        M.bt_record_node(current_time, key, owner, "failure", "missing handler")
        return false
    end
    local enforce_owner_gate = M.bt_owner_gate_enforce_enabled(key, owner)
    local owner_allowed = M.bt_observe_owner_gate(current_time, key, owner, {
        enforce = enforce_owner_gate,
        count_mismatch = enforce_owner_gate
    })
    if owner_allowed ~= true then
        return false
    end
    if M.bt_execution_enabled(key)
        and type(M._leveling_bt) == "table"
        and type(M._leveling_bt.run_node) == "function"
    then
        local node = M.bt_get_legacy_bool_node(key, owner, fn)
        if type(node) == "table" then
            local result = node:run(state, ctx, M.current_blackboard(current_time, {
                ctx = ctx,
                args = { ... }
            }))
            return result == M._leveling_bt.RUNNING or result == M._leveling_bt.SUCCESS
        end
    end
    local handled = fn(...)
    local result = handled
        and (type(M._leveling_bt) == "table" and M._leveling_bt.RUNNING or "running")
        or (type(M._leveling_bt) == "table" and M._leveling_bt.SKIPPED or "skipped")
    M.bt_record_node(current_time, key, owner, result, nil)
    return handled
end

function M.bt_run_priority_selector(ctx, current_time, key, children)
    children = type(children) == "table" and children or {}
    local selector_owner, selector_owner_source = M.bt_infer_selector_owner(key, children)
    local enforce_owner_gate = M.bt_owner_gate_enforce_enabled(key, selector_owner)
    local owner_allowed = M.bt_observe_owner_gate(current_time, key, selector_owner, {
        enforce = enforce_owner_gate,
        count_mismatch = enforce_owner_gate,
        source = selector_owner_source
    })
    if owner_allowed ~= true then
        return false
    end
    if M.bt_execution_enabled(key)
        and type(M._leveling_bt) == "table"
        and type(M._leveling_bt.priority_selector) == "function"
        and type(M._leveling_bt.legacy_bool_node) == "function"
        and type(M._leveling_bt.run_node) == "function"
    then
        local child_nodes = {}
        for index, child in ipairs(children) do
            if type(child) == "table" and type(child.run) == "function" then
                local child_def = child
                child_nodes[#child_nodes + 1] = M._leveling_bt.legacy_bool_node({
                    key = child_def.key or (tostring(key or "selector") .. "." .. tostring(index)),
                    owner = child_def.owner,
                    priority = child_def.priority or index,
                    transient = child_def.transient == true,
                    tick = function(_, blackboard)
                        return child_def.run(ctx, current_time, blackboard)
                    end
                })
            end
        end

        local selector = M._leveling_bt.priority_selector({
            key = key,
            owner = "",
            children = child_nodes
        })
        local result = selector:run(state, ctx, M.current_blackboard(current_time, {
            ctx = ctx
        }))
        return result == M._leveling_bt.RUNNING
            or result == M._leveling_bt.SUCCESS
    end

    for _, child in ipairs(children) do
        if type(child) == "table" and type(child.run) == "function" and child.run(ctx, current_time, M.current_blackboard(current_time, { ctx = ctx })) then
            M.bt_record_node(current_time, child.key, child.owner, "running", nil)
            return true
        end
    end
    M.bt_record_node(current_time, key, nil, "skipped", nil)
    return false
end

function M.bt_run_service_nodes(ctx, current_time, key, children)
    children = type(children) == "table" and children or {}
    if type(M._leveling_bt) == "table"
        and type(M._leveling_bt.service_selector) == "function"
        and type(M._leveling_bt.service) == "function"
    then
        local child_nodes = {}
        for index, child in ipairs(children) do
            if type(child) == "table" and type(child.run) == "function" then
                local child_def = child
                child_nodes[#child_nodes + 1] = M._leveling_bt.service({
                    key = child_def.key or (tostring(key or "service") .. "." .. tostring(index)),
                    priority = child_def.priority or index,
                    tick = function(_, blackboard)
                        local handled, reason = child_def.run(ctx, current_time, blackboard)
                        if handled then
                            return M._leveling_bt.SUCCESS, reason
                        end
                        return M._leveling_bt.SKIPPED, reason
                    end
                })
            end
        end

        local selector = M._leveling_bt.service_selector({
            key = key,
            children = child_nodes
        })
        selector:run(state, ctx, M.current_blackboard(current_time, {
            ctx = ctx
        }))
        return
    end

    for _, child in ipairs(children) do
        if type(child) == "table" and type(child.run) == "function" then
            local handled = child.run(ctx, current_time, M.current_blackboard(current_time, { ctx = ctx }))
            M.bt_record_node(current_time, child.key, nil, handled and "success" or "skipped", nil)
        end
    end
    M.bt_record_node(current_time, key, nil, "skipped", nil)
end

function M.is_task_detail_noise(value)
    local text = trim(tostring(value or ""))
    return text == "新" or text == "完成"
end

function M.is_task_detail_transition(value)
    local text = trim(tostring(value or ""))
    return text == "新" or text == "完成"
end

function M.should_suspend_treasure_task_refresh()
    return type(M._leveling_treasure) == "table"
        and type(M._leveling_treasure.should_suspend_task_refresh) == "function"
        and M._leveling_treasure.should_suspend_task_refresh(state) == true
end

function M.publish_current_task_name()
    _G.AVEPOINT_CURRENT_TASK_NAME = state.current_task_name
    _G.AVEPOINT_CURRENT_TASK_DETAIL = state.current_task_detail
    if type(M.maybe_confirm_task_advancing_action_success) == "function" then
        M.maybe_confirm_task_advancing_action_success(state.log_ctx, nil, "publish_current_task_name")
    end
    if type(state.current_task_detail) == "string"
        and trim(state.current_task_detail) ~= ""
        and not M.is_task_detail_transition(state.current_task_detail)
    then
        _G.AVEPOINT_LAST_TASK_DETAIL = state.current_task_detail
    end
    if type(state.current_task_name) == "string" and state.current_task_name ~= "" then
        local normalized = trim(tostring(state.current_task_name or ""))
        local generic_mainline = normalized:match("^主线%s+") ~= nil
        local side_task = normalized:match("^支线%s+") ~= nil
            or normalized:find("藏宝地", 1, true) ~= nil
        local looks_like_known_map = type(M.is_known_map_name) == "function" and M.is_known_map_name(normalized) or false
        if generic_mainline then
            local stripped = trim(normalized:gsub("^主线%s*", ""))
            if stripped ~= "" and not M.is_known_map_name(stripped) then
                _G.AVEPOINT_LAST_TASK_NAME = stripped
            end
            return
        end
        if side_task or looks_like_known_map then
            return
        end
        _G.AVEPOINT_LAST_TASK_NAME = state.current_task_name
    end
end

function M.current_task_log_name()
    local task_name = tostring(state.current_task_name or "")
    if task_name == "" or task_name:match("^主线%s+") then
        local fallback = tostring(_G.AVEPOINT_LAST_TASK_NAME or "")
        if fallback ~= ""
            and fallback:match("^支线%s+") == nil
            and fallback:find("藏宝地", 1, true) == nil
        then
            task_name = fallback
        end
    end
    return task_name
end

function M.current_task_log_detail()
    local task_detail = trim(tostring(state.current_task_detail or ""))
    if M.is_task_detail_noise(task_detail) then
        task_detail = ""
    end
    if task_detail == "" then
        task_detail = trim(tostring(_G.AVEPOINT_LAST_TASK_DETAIL or ""))
    end
    if M.is_task_detail_noise(task_detail) then
        task_detail = ""
    end
    return task_detail
end
