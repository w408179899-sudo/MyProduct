        click_main_task_button = click_main_task_button_candidate,
        fallback_reason = "no_matching_intent"
    })
end

local resolve_main_task_button_hint

function M.arm_linear_task_recipe(ctx, current_time, recipe)
    current_time = now_ms(ctx)
    local key = tostring(type(recipe) == "table" and (recipe.key or recipe.recipe_key) or "")
    if key == "" then
        key = tostring(M.current_task_log_name() or state.current_task_name or "linear_recipe")
    end
    if state.task_recipe_active_key == key and (tonumber(state.task_recipe_started_at) or 0) > 0 then
        return
    end

    M.clear_task_recipe_state()
    state.task_recipe_active_key = key
    state.task_recipe_step_index = 1
    state.task_recipe_started_at = current_time
    state.task_recipe_step_started_at = 0
    state.task_recipe_deadline_at = current_time + math.max(1000, tonumber(recipe.timeout_ms) or 30000)
    state.task_recipe_next_step_at = current_time
    state.task_recipe_previous_task_name = state.current_task_name
    state.task_recipe_previous_task_detail = state.current_task_detail

    logger(ctx).info(string.format(
        "[Leveling] task recipe armed | key=%s task=%s detail=%s steps=%d timeout=%dms",
        key,
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(M.current_task_log_detail() or state.current_task_detail or ""),
        type(recipe.steps) == "table" and #recipe.steps or 0,
        math.max(0, (tonumber(state.task_recipe_deadline_at) or current_time) - current_time)
    ))
end

function M.finish_task_recipe(ctx, current_time, recipe, reason)
    current_time = tonumber(current_time) or now_ms(ctx)
    local key = tostring(state.task_recipe_active_key or type(recipe) == "table" and recipe.key or "")
    local success = type(recipe) == "table" and recipe.success or nil
    local success_mode = type(success) == "table" and tostring(success.mode or "") or ""
    local previous_task_name = state.task_recipe_previous_task_name
    local previous_task_detail = state.task_recipe_previous_task_detail
    local recipe_type = type(recipe) == "table" and tostring(recipe.recipe_type or "") or ""
    local activation = type(recipe) == "table" and tostring(recipe.activation or "") or ""
    local entry_action_key = type(recipe) == "table" and tostring(recipe.entry_action_key or "") or ""
    local reason_text = tostring(reason or "")
    local should_clear_entry_action = entry_action_key ~= ""
        or activation == "entry_action_active"
        or recipe_type == "compat_entry_action"
        or reason_text:find("button_slot_clicked:task_entry_send", 1, true) ~= nil
    local locked_entry_key = tostring(state.task_entry_action_locked_key or "")

    logger(ctx).info(string.format(
        "[Leveling] task recipe completed | key=%s task=%s detail=%s reason=%s success=%s",
        key,
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(M.current_task_log_detail() or state.current_task_detail or ""),
        tostring(reason or ""),
        success_mode
    ))

    if should_clear_entry_action then
        M.clear_task_entry_action_state()
        logger(ctx).info(string.format(
            "[Leveling] task recipe cleared entry action lock | key=%s reason=%s entry_action_key=%s locked_key=%s",
            key,
            reason_text,
            entry_action_key,
            locked_entry_key
        ))
    end

    M.clear_task_recipe_state()

    if success_mode == "task_info_changed" then
        M.arm_task_info_stability_gate(ctx, current_time, {
            reason = "task_recipe_completed",
            previous_task_name = previous_task_name,
            previous_task_detail = previous_task_detail,
            timeout_ms = tonumber(success.timeout_ms) or tonumber(success.task_info_stability_timeout_ms) or 6500,
            flow_key = key
        })
    end
end

function M.fail_task_recipe_step(ctx, current_time, recipe, step, err)
    current_time = tonumber(current_time) or now_ms(ctx)
    local key = tostring(state.task_recipe_active_key or type(recipe) == "table" and recipe.key or "")
    local step_key = tostring(type(step) == "table" and (step.key or step.kind) or "")
    local recipe_type = type(recipe) == "table" and tostring(recipe.recipe_type or "") or ""
    local activation = type(recipe) == "table" and tostring(recipe.activation or "") or ""
    local entry_action_key = type(recipe) == "table" and tostring(recipe.entry_action_key or "") or ""
    local failure_route_action_key = trim(type(recipe) == "table"
        and (recipe.failure_route_action_key or recipe.on_failure_route_action_key)
        or "")
    local should_clear_entry_action = entry_action_key ~= ""
        or activation == "entry_action_active"
        or recipe_type == "compat_entry_action"
    local locked_entry_key = tostring(state.task_entry_action_locked_key or "")
    state.task_recipe_last_error = tostring(err or "")
    logger(ctx).warn(string.format(
        "[Leveling] task recipe step failed, fallback to main task refresh | key=%s step=%s err=%s",
        key,
        step_key,
        tostring(err or "")
    ))
    if should_clear_entry_action then
        M.clear_task_entry_action_state()
        logger(ctx).warn(string.format(
            "[Leveling] task recipe failure cleared entry action lock | key=%s step=%s entry_action_key=%s locked_key=%s",
            key,
            step_key,
            entry_action_key,
            locked_entry_key
        ))
    end
    M.clear_task_recipe_state()
    if failure_route_action_key ~= "" then
        local fallback_action, fallback_err = M.activate_route_point_action(
            ctx,
            current_time,
            failure_route_action_key,
            "task_recipe_failure"
        )
        if type(fallback_action) == "table" then
            state.require_task_button_refresh = false
            state.require_task_button_refresh_reason = nil
            logger(ctx).warn(string.format(
                "[Leveling] task recipe failure armed route action fallback | key=%s step=%s route_action=%s mode=%s err=%s",
                key,
                step_key,
                failure_route_action_key,
                tostring(fallback_action.mode or ""),
                tostring(err or "")
            ))
            return
        end
        logger(ctx).warn(string.format(
            "[Leveling] task recipe failure route action fallback failed | key=%s step=%s route_action=%s err=%s",
            key,
            step_key,
            failure_route_action_key,
            tostring(fallback_err or "")
        ))
    end
    state.require_task_button_refresh = true
    state.require_task_button_refresh_reason = "task_recipe_step_failed:" .. key .. ":" .. step_key
    state.next_task_button_click_at = current_time + math.max(300, tonumber(type(step) == "table" and step.retry_ms) or 900)
end

function M.advance_task_recipe_step(ctx, current_time, recipe, step, reason)
    current_time = tonumber(current_time) or now_ms(ctx)
    state.task_recipe_step_index = (tonumber(state.task_recipe_step_index) or 1) + 1
    state.task_recipe_step_started_at = 0
    state.task_recipe_next_step_at = current_time + math.max(0, tonumber(type(step) == "table" and step.settle_ms) or 0)
    logger(ctx).info(string.format(
        "[Leveling] task recipe step completed | key=%s next_step=%d kind=%s step_key=%s label=%s reason=%s",
        tostring(state.task_recipe_active_key or ""),
        tonumber(state.task_recipe_step_index) or 0,
        tostring(type(step) == "table" and step.kind or ""),
        tostring(type(step) == "table" and step.key or ""),
        tostring(type(step) == "table" and step.label or ""),
        tostring(reason or "")
    ))
end

function M.execute_linear_task_recipe_step(ctx, current_time, recipe, step)
    local kind = tostring(type(step) == "table" and step.kind or "")
    local function wait_world_map_panel_ready_if_needed(step_for_ready, source)
        if type(step_for_ready) ~= "table" or step_for_ready.require_world_map_panel_ready ~= true then
            return true
        end

        local map_ready, map_ready_reason = M.is_task_entry_world_map_panel_ready(
            ctx,
            current_time,
            tostring(source or "task_recipe")
        )
        if map_ready == true then
            state.task_recipe_world_map_panel_missing_since = 0
            state.task_recipe_world_map_panel_missing_step = nil
            return true
        end

        local step_key = tostring(step_for_ready.key or kind or "")
        local missing_step = tostring(state.task_recipe_world_map_panel_missing_step or "")
        local missing_since = tonumber(state.task_recipe_world_map_panel_missing_since) or 0
        if missing_since <= 0 or missing_step ~= step_key then
            missing_since = current_time
            state.task_recipe_world_map_panel_missing_since = missing_since
            state.task_recipe_world_map_panel_missing_step = step_key
        end

        local fallback_ms = tonumber(
            step_for_ready.world_map_panel_missing_fallback_ms
                or step_for_ready.map_panel_missing_fallback_ms
        ) or 0
        local elapsed_ms = math.max(0, current_time - missing_since)
        if (fallback_ms > 0 and elapsed_ms >= fallback_ms)
            or current_time >= (tonumber(state.task_recipe_deadline_at) or 0)
        then
            return false, string.format(
                "world map panel not visible before %s; elapsed=%dms reason=%s",
                tostring(step_key),
                elapsed_ms,
                tostring(map_ready_reason or "")
            )
        end

        local retry_ms = math.max(100, tonumber(step_for_ready.world_map_panel_retry_ms or step_for_ready.ready_retry_ms) or 300)
        state.task_recipe_next_step_at = current_time + retry_ms
        log_throttled(ctx, "task_recipe_wait_world_map_panel_" .. tostring(state.task_recipe_active_key or "") .. "_" .. step_key, "info", 600, string.format(
            "[Leveling] task recipe waiting world map panel before button step | key=%s step_key=%s retry=%dms elapsed=%dms reason=%s",
            tostring(state.task_recipe_active_key or ""),
            step_key,
            retry_ms,
            elapsed_ms,
            tostring(map_ready_reason or "")
        ))
        return nil
    end

    if kind == "wait_entry_action_elapsed" then
        local armed_at = tonumber(state.task_entry_action_button_click_at) or 0
        if armed_at <= 0 then
            return false, "entry action is not armed"
        end
        local duration_ms = math.max(0, tonumber(step.duration_ms) or tonumber(step.wait_ms) or 0)
        local elapsed_ms = math.max(0, current_time - armed_at)
        if elapsed_ms < duration_ms then
            state.task_recipe_next_step_at = current_time + math.max(50, duration_ms - elapsed_ms)
            log_throttled(ctx, "task_recipe_wait_entry_action_" .. tostring(state.task_recipe_active_key or ""), "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task recipe waiting entry action elapsed | key=%s elapsed=%dms wait=%dms",
                tostring(state.task_recipe_active_key or ""),
                elapsed_ms,
                duration_ms
            ))
            return true
        end
        M.advance_task_recipe_step(ctx, current_time, recipe, step, "entry_action_elapsed")
        return true
    end

    if kind == "wait_ms" then
        local started_at = tonumber(state.task_recipe_step_started_at) or 0
        if started_at <= 0 then
            local duration_ms = math.max(0, tonumber(step.duration_ms) or tonumber(step.wait_ms) or 0)
            state.task_recipe_step_started_at = current_time
            state.task_recipe_next_step_at = current_time + duration_ms
            log_throttled(ctx, "task_recipe_wait_" .. tostring(state.task_recipe_active_key or ""), "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task recipe waiting | key=%s duration=%dms",
                tostring(state.task_recipe_active_key or ""),
                duration_ms
            ))
            return true
        end
        if current_time < (tonumber(state.task_recipe_next_step_at) or current_time) then
            return true
        end
        M.advance_task_recipe_step(ctx, current_time, recipe, step, "wait_elapsed")
        return true
    end

    if kind == "click_fixed_client_point" then
        if step.require_world_map_panel_ready == true then
            local map_ready, map_ready_reason = M.is_task_entry_world_map_panel_ready(ctx, current_time, "task_recipe_fixed_click")
            if map_ready ~= true then
                local retry_ms = math.max(100, tonumber(step.world_map_panel_retry_ms or step.ready_retry_ms) or 300)
                state.task_recipe_next_step_at = current_time + retry_ms
                log_throttled(ctx, "task_recipe_wait_world_map_panel_" .. tostring(state.task_recipe_active_key or ""), "info", 600, string.format(
                    "[Leveling] task recipe waiting world map panel before fixed click | key=%s step_key=%s retry=%dms reason=%s",
                    tostring(state.task_recipe_active_key or ""),
                    tostring(step.key or ""),
                    retry_ms,
                    tostring(map_ready_reason or "")
                ))
                return true
            end
        end

        local click_step = {}
        for k, v in pairs(step) do
            click_step[k] = v
        end
        click_step.fixed_client_click = true
        logger(ctx).info(string.format(
            "[Leveling] task recipe fixed client step begin | key=%s step_key=%s label=%s ratio=(%s,%s) client=(%s,%s)",
            tostring(state.task_recipe_active_key or ""),
            tostring(step.key or ""),
            tostring(step.label or ""),
            tostring(step.fixed_ratio_x or ""),
            tostring(step.fixed_ratio_y or ""),
            tostring(step.fixed_client_x or step.client_x or ""),
            tostring(step.fixed_client_y or step.client_y or "")
        ))
        local target, target_err = fetch_locator_button_target(ctx, click_step)
        if type(target) ~= "table" then
            return false, target_err or "fixed client target unavailable"
        end
        local clicked, click_err = click_locator_button_target(ctx, click_step, target)
        if clicked ~= true then
            return false, click_err or "fixed client click failed"
        end
        M.advance_task_recipe_step(ctx, now_ms(ctx), recipe, step, "fixed_client_clicked")
        return true
    end

    if kind == "call_locator_button" then
        local ready, ready_err = wait_world_map_panel_ready_if_needed(step, "task_recipe_locator")
        if ready == nil then
            return true
        end
        if ready ~= true then
            return false, ready_err or "world map panel not visible"
        end

        local target, target_err, source, click_step = M.fetch_locator_button_target_with_configured_fallback(
            ctx,
            step,
            current_time,
            "task_recipe_locator"
        )
        if type(target) ~= "table" then
            return false, target_err or "locator button target unavailable"
        end
        local clicked, click_err = click_locator_button_target(ctx, click_step or step, target)
        if clicked ~= true then
            return false, click_err or "locator button click failed"
        end
        logger(ctx).info(string.format(
            "[Leveling] task recipe locator button clicked | key=%s step_key=%s label=%s source=%s addr=%s pos=(%s,%s)",
            tostring(state.task_recipe_active_key or ""),
            tostring(step.key or ""),
            tostring(step.label or ""),
            tostring(source or ""),
            tostring(target.addr or ""),
            tostring(target.x or ""),
            tostring(target.y or "")
        ))
        M.advance_task_recipe_step(ctx, now_ms(ctx), recipe, step, "locator_button_clicked:" .. tostring(source or ""))
        return true
    end

    if kind == "call_button_slot" then
        local slot = tostring(step.slot or "")
        local ready, ready_err = wait_world_map_panel_ready_if_needed(step, "task_recipe_" .. slot)
        if ready == nil then
            return true
        end
        if ready ~= true then
            return false, ready_err or "world map panel not visible"
        end

        local clicked, click_meta_or_err = M.call_button_slot(ctx, current_time, slot, step, {
            reason = "task_recipe_" .. slot
        })
        if clicked ~= true then
            return false, click_meta_or_err or "button slot click failed"
        end

        local click_meta = type(click_meta_or_err) == "table" and click_meta_or_err or {}
        local target = type(click_meta.target) == "table" and click_meta.target or nil
        local source = tostring(click_meta.source or "")
        local after_click_time = tonumber(click_meta.clicked_at) or now_ms(ctx)
        if slot == "task_entry_send" then
            state.task_entry_action_send_clicked_at = after_click_time
            if step.schedule_task_refresh_after_transition ~= false then
                schedule_task_refresh_after_transition(
                    ctx,
                    after_click_time,
                    tostring(step.transition_reason or "task_entry_world_map_send"),
                    tonumber(step.transition_wait_ms) or 1800,
                    {
                        force_task_call = step.force_task_call ~= false,
                        task_pos_reject_extra_ms = tonumber(step.task_pos_reject_extra_ms) or 3500,
                        task_info_stability_flow_key = tostring(state.task_recipe_active_key or "")
                    }
                )
            end
        end

        logger(ctx).info(string.format(
            "[Leveling] task recipe button slot clicked | key=%s slot=%s label=%s addr=%s pos=(%s,%s) source=%s",
            tostring(state.task_recipe_active_key or ""),
            slot,
            tostring(step.label or ""),
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or ""),
            source
        ))

        if step.finish_recipe == true then
            M.finish_task_recipe(ctx, after_click_time, recipe, "button_slot_clicked:" .. slot)
        else
            M.advance_task_recipe_step(ctx, after_click_time, recipe, step, "button_slot_clicked:" .. slot)
        end
        return true
    end

    if kind == "complete" then
        M.finish_task_recipe(ctx, current_time, recipe, "complete_step")
        return true
    end

    return false, "unsupported recipe step kind: " .. kind
end

function M.maybe_handle_linear_task_recipe(ctx, current_time, player_x, player_y, player_z, recipe)
    if type(recipe) ~= "table" or type(recipe.steps) ~= "table" or #recipe.steps <= 0 then
        return false
    end
    current_time = tonumber(current_time) or now_ms(ctx)
    M.arm_linear_task_recipe(ctx, current_time, recipe)

    if M.maybe_block_task_entry_for_skip_sequence(ctx, current_time, "task_recipe") then
        current_time = now_ms(ctx)
        state.task_recipe_deadline_at = math.max(
            tonumber(state.task_recipe_deadline_at) or 0,
            current_time + math.max(5000, tonumber(recipe.timeout_ms) or 12000)
        )
        state.task_recipe_next_step_at = current_time + 250
        hold_navigation(ctx, current_time, "task_recipe_skip_sequence")
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end
    current_time = now_ms(ctx)

    if current_time >= (tonumber(state.task_recipe_deadline_at) or 0) then
        local step_index = math.max(1, tonumber(state.task_recipe_step_index) or 1)
        local recipes = type(M._leveling_recipes) == "table" and M._leveling_recipes or nil
        local step = type(recipes) == "table" and type(recipes.step_at) == "function"
            and recipes.step_at(recipe, step_index)
            or recipe.steps[step_index]
        local kind = tostring(type(step) == "table" and step.kind or "")
        local slot = tostring(type(step) == "table" and step.slot or "")
        if kind == "call_button_slot" and slot ~= "" then
            logger(ctx).info(string.format(
                "[Leveling] task recipe timeout forcing pending button slot once | key=%s step=%d/%d slot=%s step_key=%s label=%s",
                tostring(state.task_recipe_active_key or ""),
                step_index,
                type(recipe.steps) == "table" and #recipe.steps or 0,
                slot,
                tostring(step.key or ""),
                tostring(step.label or "")
            ))
            state.task_recipe_next_step_at = current_time
            state.stage = "task_recipe"
            hold_navigation(ctx, current_time, "task_recipe_timeout_button_slot")
            local ok, err = M.execute_linear_task_recipe_step(ctx, current_time, recipe, step)
            if ok == true then
                return true
            end
            M.fail_task_recipe_step(ctx, current_time, recipe, step, err or "recipe timeout")
            return true
        end
        M.fail_task_recipe_step(ctx, current_time, recipe, nil, "recipe timeout")
        return true
    end
    if current_time < (tonumber(state.task_recipe_next_step_at) or 0) then
        hold_navigation(ctx, current_time, "task_recipe_wait")
        return true
    end

    local step_index = math.max(1, tonumber(state.task_recipe_step_index) or 1)
    local recipes = type(M._leveling_recipes) == "table" and M._leveling_recipes or nil
    local step = type(recipes) == "table" and type(recipes.step_at) == "function"
        and recipes.step_at(recipe, step_index)
        or recipe.steps[step_index]
    if type(step) ~= "table" then
        M.finish_task_recipe(ctx, current_time, recipe, "steps_exhausted")
        return true
    end

    state.stage = "task_recipe"
    hold_navigation(ctx, current_time, "task_recipe")
    log_throttled(ctx, "task_recipe_step_" .. tostring(state.task_recipe_active_key or ""), "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] task recipe step dispatch | key=%s step=%d/%d kind=%s step_key=%s label=%s task=%s detail=%s",
        tostring(state.task_recipe_active_key or ""),
        step_index,
        type(recipe.steps) == "table" and #recipe.steps or 0,
        tostring(step.kind or ""),
        tostring(step.key or ""),
        tostring(step.label or ""),
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(M.current_task_log_detail() or state.current_task_detail or "")
    ))

    local ok, err = M.execute_linear_task_recipe_step(ctx, current_time, recipe, step)
    if ok == true then
        return true
    end
    M.fail_task_recipe_step(ctx, current_time, recipe, step, err)
    return true
end

function M.maybe_handle_task_recipe(ctx, current_time, player_x, player_y, player_z, recipe)
    if type(recipe) ~= "table" then
        return false
    end

    local recipe_type = tostring(recipe.recipe_type or "")
    local key = tostring(recipe.key or "")
    if recipe_type == "compat_entry_action" then
        log_throttled(ctx, "task_recipe_compat_entry_action_" .. key, "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task recipe dispatch | key=%s type=%s entry_action_key=%s",
            key,
            recipe_type,
            tostring(recipe.entry_action_key or "")
        ))
        return M.maybe_handle_task_entry_action(ctx, current_time, player_x, player_y, player_z) == true
    end

    if recipe_type == "linear" then
        return M.maybe_handle_linear_task_recipe(ctx, current_time, player_x, player_y, player_z, recipe) == true
    end

    log_throttled(ctx, "task_recipe_unsupported_" .. key, "warn", LOG_THROTTLE_MS, string.format(
        "[Leveling] task recipe unsupported | key=%s type=%s",
        key,
        recipe_type
    ))
    return false
end

function M.dispatch_task_intent(ctx, current_time, player_x, player_y, player_z, intent)
    if type(intent) ~= "table" then
        return false
    end

    local kind = tostring(intent.kind or "")
    local matched_source = tostring(intent.matched_source or "")
    if kind == "" or kind == "none" then
        return false
    end

    if kind == "task_recipe" then
        return M.maybe_handle_task_recipe(ctx, current_time, player_x, player_y, player_z, intent.config) == true
    end

    if kind == "entry_action" then
        return M.maybe_handle_task_entry_action(ctx, current_time, player_x, player_y, player_z) == true
    end

    if kind == "post_dialogue_flow" then
        return M.maybe_handle_post_dialogue_flow(ctx, current_time) == true
    end

    if kind == "dialogue_jump" then
        return M.maybe_click_dialogue_jump_button(ctx, current_time) == true
    end

    local is_route_point_intent = kind == "route_point_boarding"
        or kind == "route_point_npc_dialogue"
        or kind == "route_point_recorded_route"
        or kind == "route_point_objective"
    if not is_route_point_intent then
        return false
    end

    local action = type(intent.config) == "table" and intent.config or M.find_route_point_action_by_key(intent.matched_key)
    if type(action) ~= "table" then
        return false
    end

    if matched_source == "route_point_candidate" then
        local armed_action = nil
        local arm_err = nil
        armed_action, arm_err = M.activate_route_point_action(
            ctx,
            current_time,
            tostring(intent.matched_key or action.key or action.label or ""),
            "task_intent"
        )
        if type(armed_action) ~= "table" then
            log_throttled(
                ctx,
                "task_intent_route_point_arm_failed_" .. tostring(intent.matched_key or ""),
                "warn",
                LOG_THROTTLE_MS,
                string.format(
                    "[Leveling] task intent route point arm failed | kind=%s key=%s err=%s",
                    kind,
                    tostring(intent.matched_key or ""),
                    tostring(arm_err or "")
                )
            )
            return false
        end
        action = armed_action
    end

    local mode = tostring(action.mode or "")
    if mode == "lift_transition" then
        return M.maybe_handle_route_point_action_boarding(ctx, current_time, player_x, player_y, player_z) == true
    end
    if mode == "npc_dialogue_point" then
        return M.maybe_handle_route_point_action_npc_dialogue(ctx, current_time, player_x, player_y, player_z) == true
    end
    if mode == "objective_button_flow_point" then
        return M.maybe_handle_route_point_action_objective(ctx, current_time, player_x, player_y, player_z) == true
    end
    if mode == "recorded_route_point" then
        if M.maybe_handle_route_point_action_route_wait(ctx, current_time, player_x, player_y, player_z) then
            return true
        end
        return M.maybe_handle_route_point_action_route(ctx, current_time, player_x, player_y, player_z) == true
    end

    return false
end

function M.maybe_dispatch_explicit_task_intent(ctx, current_time, player_x, player_y, player_z, opts, trace_target, trace_destination, goal_distance, objective_mode)
    local intent = M.resolve_current_task_intent(ctx, current_time, player_x, player_y, player_z, opts)
    if not M.dispatch_task_intent(ctx, current_time, player_x, player_y, player_z, intent) then
        return false
    end

    M.log_execution_trace(
        ctx,
        current_time,
        tostring(intent.kind or "task_intent"),
        trace_target,
        trace_destination,
        goal_distance,
        objective_mode,
        player_x,
        player_y,
        player_z
    )
    log_heartbeat(ctx, current_time, player_x, player_y, player_z)
    return true
end

function M.maybe_click_main_task_button_by_intent(ctx, current_time, player_x, player_y, player_z, opts)
    local intent = M.resolve_current_task_intent(ctx, current_time, player_x, player_y, player_z, opts)
    if M.dispatch_task_intent(ctx, current_time, player_x, player_y, player_z, intent) then
        M.log_execution_trace(ctx, current_time, tostring(intent.kind or "task_intent"), nil, nil, nil, nil, player_x, player_y, player_z)
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if tostring(intent.kind or "") == "click_main_task_button" then
        state.stage = "click_task_button"
        M.log_execution_trace(ctx, current_time, "click_task_button", nil, nil, nil, nil, player_x, player_y, player_z)
        click_main_task_button(ctx, current_time, {
            intent = intent
        })
        return false
    end

    log_throttled(ctx, "task_button_click_suppressed_by_task_intent", "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] main task reacquire suppressed by task intent | task=%s detail=%s intent=%s source=%s key=%s",
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(M.current_task_log_detail() or state.current_task_detail or ""),
        tostring(intent.kind or ""),
        tostring(intent.matched_source or ""),
        tostring(intent.matched_key or "")
    ))
    return false
end

function M.fetch_hint_button_target(ctx, step)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.find_button_near_point) ~= "function" then
        return nil, "button locator API is unavailable."
    end

    local hint_x = tonumber(step and step.hint_client_x)
    local hint_y = tonumber(step and step.hint_client_y)
    if hint_x == nil or hint_y == nil then
        return nil, "locator hint point is unavailable."
    end

    return nav_mod.find_button_near_point(hint_x, hint_y, {
        include_patterns = type(step) == "table" and step.include_patterns or nil,
        max_distance = tonumber(type(step) == "table" and step.hint_max_distance) or 80
    })
end

function M.locator_selected_target_matches_step(step, target)
    if type(step) ~= "table" or type(target) ~= "table" then
        return false, "invalid step or target"
    end

    local identity = (
        tostring(target.fullname or "")
            .. " "
            .. tostring(target.name or "")
            .. " "
            .. tostring(target.text or "")
    ):lower()
    local has_constraint = false

    local button_name = trim(step.distance_button_name or "")
    if button_name ~= "" then
        has_constraint = true
        if identity:find(button_name:lower(), 1, true) then
            return true
        end
    end

    if type(step.include_patterns) == "table" then
        for _, pattern in ipairs(step.include_patterns) do
            local needle = trim(pattern or "")
            if needle ~= "" then
                has_constraint = true
                if identity:find(needle:lower(), 1, true) then
                    return true
                end
            end
        end
    end

    if has_constraint then
        return false, "selected target identity mismatch: " .. identity
    end
    return true
end

function M.resolve_locator_selected_button_target(nav_mod, step)
    if type(nav_mod) ~= "table" or type(nav_mod.get_current_selected_button) ~= "function" then
        return nil, "nav.get_current_selected_button is unavailable."
    end

    local selected, selected_err = nav_mod.get_current_selected_button()
    if type(selected) ~= "table" then
        return nil, selected_err or "Current selected button not found."
    end

    local addr = tonumber(selected.addr)
    local x = tonumber(selected.x)
    local y = tonumber(selected.y)
    local fullname = tostring(selected.Fullname or selected.fullname or "")
    local name = tostring(selected.name or "")
    local selected_text = tostring(selected.text or "")
    if addr == nil or addr == 0 or x == nil or y == nil then
        return nil, string.format(
            "GetCurrentSelected returned invalid locator button data. addr=%s pos=(%s,%s) name=%s fullname=%s text=%s",
            tostring(selected.addr or ""),
            tostring(selected.x or ""),
            tostring(selected.y or ""),
            name,
            fullname,
            selected_text
        )
    end

    local target = {
        kind = "button",
        addr = addr,
        name = name,
        text = selected_text,
        fullname = fullname,
        x = x,
        y = y,
        related_text = tostring(selected.rel1_text or ""),
        related_distance = tonumber(selected.rel1_distance)
    }

    local matches, reject = M.locator_selected_target_matches_step(step, target)
    if matches ~= true then
        return nil, reject
    end

    local hint_x = tonumber(type(step) == "table" and step.hint_client_x or nil)
    local hint_y = tonumber(type(step) == "table" and step.hint_client_y or nil)
    if hint_x ~= nil and hint_y ~= nil then
        local distance = distance_2d(hint_x, hint_y, x, y)
        local max_distance = math.max(
            tonumber(type(step) == "table" and step.hint_max_distance) or 80,
            tonumber(type(step) == "table" and step.hover_capture_hint_max_distance) or 0
        )
        if distance > max_distance then
            return nil, string.format(
                "GetCurrentSelected locator button too far from hint: %.2f selected=(%.2f,%.2f) hint=(%.2f,%.2f)",
                tonumber(distance) or 0,
                x,
                y,
                tonumber(hint_x) or 0,
                tonumber(hint_y) or 0
            )
        end
        target.distance = distance
        target.hint_distance = distance
    end

    return target
end

function M.resolve_locator_hover_capture_bounds(step)
    if type(step) ~= "table" then
        return nil, "locator hover step unavailable."
    end
    if step.hover_capture_client_left ~= nil
        and step.hover_capture_client_top ~= nil
        and step.hover_capture_client_right ~= nil
        and step.hover_capture_client_bottom ~= nil
    then
        return M.resolve_main_task_hover_capture_bounds(step)
    end

    local hint_x = tonumber(step.hint_client_x)
    local hint_y = tonumber(step.hint_client_y)
    if hint_x == nil or hint_y == nil then
        return nil, "locator hover hint point unavailable."
    end

    local radius = math.max(6, tonumber(step.hover_capture_radius) or 14)
    return M.normalize_main_task_hover_bounds(
        hint_x - radius,
        hint_y - radius,
        hint_x + radius,
        hint_y + radius
    )
end

function M.try_capture_locator_button_via_hover(ctx, current_time, step, reason)
    if M.button_call_hover_capture_disabled() then
        return nil, "locator hover capture globally disabled."
    end

    if type(step) ~= "table" or step.hover_capture_enabled ~= true then
        return nil, "locator hover capture disabled."
    end

    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.move_mouse_to_client) ~= "function" then
        return nil, "nav.move_mouse_to_client is unavailable."
    end

    local capture_bounds, bounds_summary = M.resolve_locator_hover_capture_bounds(step)
    if type(capture_bounds) ~= "table" then
        return nil, bounds_summary
    end

    local original_cursor = nil
    if type(nav_mod.cursor_client_pos) == "function" then
        original_cursor = select(1, nav_mod.cursor_client_pos({
            allow_outside = true
        }))
    end

    local capture_candidate, capture_summary = M.choose_main_task_hover_candidate(
        "capture",
        original_cursor,
        capture_bounds,
        step,
        "locator_button"
    )
    if type(capture_candidate) ~= "table" then
        return nil, capture_summary
    end

    local moved, move_result = nav_mod.move_mouse_to_client(capture_candidate.x, capture_candidate.y, {
        mouse_mode = "api",
        min_duration_ms = capture_candidate.move_min_ms,
        max_duration_ms = capture_candidate.move_max_ms,
        hover_ms = capture_candidate.hover_ms,
        set_foreground = true
    })
    if not moved then
        return nil, string.format(
            "locator hover move failed=%s hover=%s bounds=%s capture_summary=%s",
            tostring(move_result or ""),
            M.format_main_task_hover_candidate_brief(capture_candidate),
            tostring(bounds_summary or ""),
            tostring(capture_summary or "")
        )
    end

    local capture_entry = {
        x = capture_candidate.x,
        y = capture_candidate.y,
        zone = capture_candidate.zone,
        angle_deg = capture_candidate.angle_deg,
        move_min_ms = capture_candidate.move_min_ms,
        move_max_ms = capture_candidate.move_max_ms,
        hover_ms = capture_candidate.hover_ms,
        move_duration_ms = tonumber(type(move_result) == "table" and move_result.duration_ms),
        move_style = tostring(type(move_result) == "table" and move_result.move_style or ""),
        sample_attempt = capture_candidate.sample_attempt,
        score = capture_candidate.score,
        outcome = "hover_probe"
    }
    M.push_main_task_hover_history("capture", capture_entry, capture_candidate.history_limit, "locator_button")

    local selected_target, selected_err = M.resolve_locator_selected_button_target(nav_mod, step)
    if type(selected_target) ~= "table" then
        return nil, string.format(
            "locator hover selected failed=%s hover=%s move_style=%s move_duration=%s bounds=%s capture_summary=%s",
            tostring(selected_err or ""),
            M.format_main_task_hover_candidate_brief(capture_candidate),
            tostring(type(move_result) == "table" and move_result.move_style or ""),
            tostring(type(move_result) == "table" and move_result.duration_ms or ""),
            tostring(bounds_summary or ""),
            tostring(capture_summary or "")
        )
    end

    logger(ctx).info(string.format(
        "[Leveling] locator button target captured via hover | label=%s reason=%s hover=%s move_style=%s move_duration=%s target=%s bounds=%s capture_summary=%s",
        tostring(step.label or ""),
        tostring(reason or ""),
        M.format_main_task_hover_candidate_brief(capture_candidate),
        tostring(type(move_result) == "table" and move_result.move_style or ""),
        tostring(type(move_result) == "table" and move_result.duration_ms or ""),
        M.format_main_task_click_target_brief(selected_target),
        tostring(bounds_summary or ""),
        tostring(capture_summary or "")
    ))
    selected_target._hover_capture_return_after_click = step.hover_capture_return_after_click ~= false
    selected_target._hover_capture_namespace = tostring(step.hover_capture_namespace or step.button_slot or step.slot or "locator_button")
    selected_target._hover_capture_reason = tostring(reason or "")
    return selected_target
end

function M.resolve_fixed_client_click_target(ctx, step)
    if type(step) ~= "table" or step.fixed_client_click ~= true then
        return nil
    end

    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.window_hwnd) ~= "function" then
        return nil, "nav.window_hwnd is unavailable."
    end

    local hwnd, hwnd_err = nav_mod.window_hwnd()
    if not hwnd then
        return nil, hwnd_err or "game window not found."
    end

    local wnd_api = type(ctx) == "table" and ctx.wnd or wnd
    if type(wnd_api) ~= "table" or type(wnd_api.client_rect) ~= "function" then
        return nil, "wnd.client_rect is unavailable."
    end

    local origin_x, origin_y, client_w, client_h = wnd_api.client_rect(hwnd)
    if type(origin_x) ~= "number"
        or type(origin_y) ~= "number"
        or type(client_w) ~= "number"
        or type(client_h) ~= "number"
        or client_w <= 0
        or client_h <= 0
    then
        return nil, "wnd.client_rect failed."
    end

    local client_x = tonumber(step.fixed_client_x)
    local client_y = tonumber(step.fixed_client_y)
    local ratio_x = tonumber(step.fixed_ratio_x)
    local ratio_y = tonumber(step.fixed_ratio_y)
    if step.fixed_prefer_ratio ~= false and ratio_x ~= nil and ratio_y ~= nil then
        client_x = ratio_x * client_w
        client_y = ratio_y * client_h
    end
    if client_x == nil or client_y == nil then
        return nil, "fixed client point is unavailable."
    end

    if step.allow_outside ~= true
        and (client_x < 0 or client_y < 0 or client_x > client_w or client_y > client_h)
    then
        return nil, string.format(
            "fixed client point outside window. client=(%.2f, %.2f) size=(%.2f, %.2f)",
            tonumber(client_x) or 0,
            tonumber(client_y) or 0,
            tonumber(client_w) or 0,
            tonumber(client_h) or 0
        )
    end

    return {
        kind = "client_point",
        name = "fixed_client_click",
        text = tostring(step.label or ""),
        fullname = tostring(step.key or ""),
        x = client_x,
        y = client_y,
        hwnd = hwnd,
        click_screen_x = math.floor(origin_x + client_x + 0.5),
        click_screen_y = math.floor(origin_y + client_y + 0.5),
        click_button = tostring(step.click_button or "left"),
        click_mode = tostring(step.mouse_mode or step.click_mode or "api"),
        click_delay = tonumber(step.click_delay_ms) or tonumber(step.click_delay) or 50,
        hover_delay_ms = tonumber(step.hover_delay_ms) or 80
    }
end

function fetch_locator_button_target(ctx, step)
    local fixed_target, fixed_err = M.resolve_fixed_client_click_target(ctx, step)
    if fixed_target then
        return fixed_target
    end
    if type(step) == "table" and step.fixed_client_click == true then
        return nil, fixed_err
    end

    local function try_hover_capture_if_enabled(fetch_err)
        if type(step) ~= "table" or step.hover_capture_enabled ~= true then
            return nil, fetch_err
        end
        local captured_target, capture_err = M.try_capture_locator_button_via_hover(
            ctx,
            now_ms(ctx),
            step,
            "fetch_locator_button_target"
        )
        if captured_target then
            return captured_target
        end
        return nil, capture_err or fetch_err
    end

    if type(fetch_button_for_step) == "function" then
        local ok, target, fetch_err = safe_call(fetch_button_for_step, step)
        if ok and target then
            return target
        end
        if ok and type(step) == "table" and type(step.image_preset) == "table" then
            return try_hover_capture_if_enabled(fetch_err or "image target not found.")
        end
        if ok
            and type(step) == "table"
            and step.prefer_hint_fallback == true
        then
            local hint_target, hint_err = M.fetch_hint_button_target(ctx, step)
            if hint_target then
                return hint_target
            end
            return try_hover_capture_if_enabled(hint_err or fetch_err)
        end
        if ok and type(step) == "table" and (step.distance_anchor_exact_text == nil or tostring(step.distance_anchor_exact_text) == "") then
            local hint_target, hint_err = M.fetch_hint_button_target(ctx, step)
            if hint_target then
                return hint_target
            end
            return try_hover_capture_if_enabled(hint_err or fetch_err)
        end
        if ok then
            return try_hover_capture_if_enabled(fetch_err)
        end
        return nil, target
    end

    local hint_target, hint_err = M.fetch_hint_button_target(ctx, step)
    if hint_target then
        return hint_target
    end
    return try_hover_capture_if_enabled(hint_err)
end

function M.fetch_locator_button_target_with_configured_fallback(ctx, step, current_time, reason)
    if type(step) ~= "table" then
        return nil, "locator step unavailable.", "missing_step", step
    end

    local retry_count = math.max(
        1,
        math.floor(
            tonumber(step.poll_retry_count)
                or tonumber(step.target_poll_retry_count)
                or tonumber(step.locator_poll_retry_count)
                or 1
        )
    )
    local poll_interval_ms = math.max(
        0,
        math.floor(
            tonumber(step.poll_interval_ms)
                or tonumber(step.target_poll_interval_ms)
                or tonumber(step.locator_poll_interval_ms)
                or 0
        )
    )
    local last_err = nil
    local poll_started_at = tonumber(current_time) or now_ms(ctx)

    for attempt = 1, retry_count do
        local target, fetch_err = fetch_locator_button_target(ctx, step)
        if type(target) == "table" then
            if attempt > 1 then
                logger(ctx).info(string.format(
                    "[Leveling] locator button found after poll | reason=%s label=%s attempt=%d/%d elapsed=%dms",
                    tostring(reason or ""),
                    tostring(step.label or ""),
                    attempt,
                    retry_count,
                    math.max(0, now_ms(ctx) - poll_started_at)
                ))
            end
            return target, nil, attempt > 1 and "live_poll" or "live", step
        end
        last_err = fetch_err
        if attempt < retry_count and poll_interval_ms > 0 then
            sleep_ms(ctx, poll_interval_ms)
        end
    end

    local fixed_client_x = tonumber(step.fixed_fallback_client_x or step.fallback_fixed_client_x)
    local fixed_client_y = tonumber(step.fixed_fallback_client_y or step.fallback_fixed_client_y)
    local fixed_ratio_x = tonumber(step.fixed_fallback_ratio_x or step.fallback_fixed_ratio_x)
    local fixed_ratio_y = tonumber(step.fixed_fallback_ratio_y or step.fallback_fixed_ratio_y)
    if (fixed_client_x ~= nil and fixed_client_y ~= nil) or (fixed_ratio_x ~= nil and fixed_ratio_y ~= nil) then
        local fixed_step = {}
        for k, v in pairs(step) do
            fixed_step[k] = v
        end
        fixed_step.fixed_client_click = true
        fixed_step.fixed_client_x = fixed_client_x
        fixed_step.fixed_client_y = fixed_client_y
        fixed_step.fixed_ratio_x = fixed_ratio_x
        fixed_step.fixed_ratio_y = fixed_ratio_y
        fixed_step.fixed_prefer_ratio = step.fixed_fallback_prefer_ratio ~= false
        fixed_step.prefer_screen_click = step.fixed_fallback_prefer_screen_click ~= false
        fixed_step.mouse_mode = tostring(step.fixed_fallback_mouse_mode or step.mouse_mode or step.click_mode or "api")
        fixed_step.click_button = tostring(step.fixed_fallback_click_button or step.click_button or "left")
        fixed_step.click_delay_ms = tonumber(step.fixed_fallback_click_delay_ms or step.click_delay_ms) or 50
        fixed_step.hover_delay_ms = tonumber(step.fixed_fallback_hover_delay_ms or step.hover_delay_ms) or 80

        local fixed_target, fixed_err = M.resolve_fixed_client_click_target(ctx, fixed_step)
        if type(fixed_target) == "table" then
            logger(ctx).warn(string.format(
                "[Leveling] locator button poll exhausted, using fixed client fallback | reason=%s label=%s attempts=%d interval=%dms client=(%.2f, %.2f) err=%s",
                tostring(reason or ""),
                tostring(step.label or ""),
                retry_count,
                poll_interval_ms,
                tonumber(fixed_target.x) or 0,
                tonumber(fixed_target.y) or 0,
                tostring(last_err or "")
            ))
            return fixed_target, nil, "fixed_fallback", fixed_step
        end
        return nil, string.format(
            "%s; fixed fallback failed: %s",
            tostring(last_err or "locator target unavailable"),
            tostring(fixed_err or "")
        ), "missing", step
    end

    return nil, last_err or "locator target unavailable.", "missing", step
end

function click_locator_button_target(ctx, step, target)
    if type(target) == "table" and tostring(target.kind or "") == "client_point" then
        logger(ctx).info(string.format(
            "[Leveling] fixed client click dispatch | step_key=%s label=%s client=(%.2f, %.2f) screen=(%s, %s) hwnd=%s mode=%s",
            tostring(type(step) == "table" and step.key or ""),
            tostring(type(step) == "table" and step.label or ""),
            tonumber(target.x) or 0,
            tonumber(target.y) or 0,
            tostring(target.click_screen_x or ""),
            tostring(target.click_screen_y or ""),
            tostring(target.hwnd or ""),
            tostring(target.click_mode or "")
        ))
    end

    local click_step = step
    if type(target) == "table" and tostring(target.kind or "") == "client_point" and type(step) == "table" then
        click_step = {}
        for k, v in pairs(step) do
            click_step[k] = v
        end
        click_step.prefer_screen_click = true
    end

    if type(click_fetched_target) == "function" and type(target) == "table" then
        local ok, clicked, click_err, retryable = safe_call(click_fetched_target, click_step, target)
        if ok then
            if clicked == true
                and target._hover_capture_return_after_click == true
                and tostring(target.kind or "") ~= "client_point"
            then
                local nav_mod = nav_api(ctx)
                local returned, return_err = M.return_mouse_to_button_safe_point(
                    ctx,
                    nav_mod,
                    click_step,
                    tostring(target._hover_capture_namespace or "locator_button"),
                    tostring(target._hover_capture_reason or "post_click")
                )
                if not returned then
                    log_throttled(ctx, "locator_button_hover_safe_return_failed", "info", LOG_THROTTLE_MS,
                        "[Leveling] locator button hover safe return failed: " .. tostring(return_err or ""))
                end
            end
            return clicked == true, click_err, retryable
        end
        return false, clicked
    end

    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.control_click) ~= "function" then
        return false, "nav.control_click is unavailable."
    end

    if type(target) ~= "table" or tonumber(target.addr) == nil then
        return false, "Invalid locator button target."
    end

    local click_ok, click_err = nav_mod.control_click(target.addr)
    if click_ok
        and type(target) == "table"
        and target._hover_capture_return_after_click == true
    then
        local returned, return_err = M.return_mouse_to_button_safe_point(
            ctx,
            nav_mod,
            step,
            tostring(target._hover_capture_namespace or "locator_button"),
            tostring(target._hover_capture_reason or "post_click")
        )
        if not returned then
            log_throttled(ctx, "locator_button_hover_safe_return_failed", "info", LOG_THROTTLE_MS,
                "[Leveling] locator button hover safe return failed: " .. tostring(return_err or ""))
        end
    end

    return click_ok, click_err
end

function M.apply_button_slot_step_defaults(slot, step)
    slot = tostring(slot or "")
    if slot == "task_entry_send" then
        return M.apply_task_entry_send_step_defaults(step)
    end
    if slot == "dialogue_jump" then
        return M.apply_dialogue_jump_step_defaults(step)
    end
    if slot == "interaction_prompt" then
        return M.apply_interaction_prompt_step_defaults(step)
    end
    if slot == "main_task" then
        return M.apply_main_task_button_step_defaults(step)
    end
    if slot == "treasure_task" then
        return M.apply_treasure_task_button_step_defaults(step)
    end
    if M.is_generic_cached_button_slot(slot) then
        return M.apply_registered_button_slot_step_defaults(slot, step)
    end
    return step
end

function M.resolve_cached_button_slot_target(ctx, nav_mod, current_time, slot, opts)
    slot = tostring(slot or "")
    opts = type(opts) == "table" and opts or {}
    if type(nav_mod) ~= "table" then
        return nil, "nav api unavailable"
    end

    if slot == "task_entry_send" then
        return M.resolve_cached_task_entry_send_button_target(nav_mod, current_time)
    end
    if slot == "dialogue_jump" then
        return M.resolve_cached_dialogue_jump_button_target(nav_mod, current_time)
    end
    if slot == "interaction_prompt" then
        return M.resolve_cached_interaction_prompt_button_target(nav_mod, current_time)
    end
    if slot == "main_task" then
        return M.resolve_cached_main_task_button_target(nav_mod, current_time, {
            allow_session_restore = opts.allow_session_restore ~= false
        })
    end
    if slot == "treasure_task" then
        return M.resolve_cached_treasure_task_button_target(nav_mod, current_time, opts.query)
    end
    if M.is_generic_cached_button_slot(slot) then
        return M.resolve_cached_registered_button_slot_target(nav_mod, current_time, slot, opts)
    end

    return nil, "unsupported button slot: " .. slot
end

function M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, opts)
    slot = tostring(slot or "")
    opts = type(opts) == "table" and opts or {}
    local reason = tostring(opts.reason or "button_slot_capture")
    if type(nav_mod) ~= "table" then
        return nil, "nav api unavailable"
    end

    if slot == "main_task" and M.main_task_button_cache_disabled() then
        M.clear_cached_main_task_button_target()
    end

    step = M.apply_button_slot_step_defaults(slot, step)
    if slot == "task_entry_send" then
        return M.try_capture_task_entry_send_button_via_hover(ctx, nav_mod, current_time, step, reason)
    end
    if slot == "dialogue_jump" then
        return M.try_capture_dialogue_jump_button_via_hover(ctx, nav_mod, current_time, step, reason)
    end
    if slot == "interaction_prompt" then
        return M.try_capture_interaction_prompt_button_via_hover(ctx, nav_mod, current_time, step, reason, {
            ignore_retry_gate = opts.ignore_retry_gate == true
        })
    end
    if slot == "main_task" then
        local hint_x = tonumber(opts.hint_x or (type(step) == "table" and step.hint_client_x))
        local hint_y = tonumber(opts.hint_y or (type(step) == "table" and step.hint_client_y))
        if hint_x == nil or hint_y == nil then
            return nil, "main_task capture requires hint point"
        end
        return M.try_capture_main_task_button_via_hover(ctx, nav_mod, current_time, hint_x, hint_y, reason, {
            no_cache = opts.no_cache == true
        })
    end
    if slot == "treasure_task" then
        return M.try_capture_treasure_task_button_via_hover(ctx, nav_mod, current_time, opts.query, reason)
    end
    if M.is_generic_cached_button_slot(slot) then
        return M.try_capture_registered_button_slot_via_hover(ctx, nav_mod, current_time, slot, step, reason, opts)
    end

    return nil, "unsupported button slot: " .. slot
end

function M.clear_button_slot_cache(ctx, slot, reason)
    slot = tostring(slot or "")
    if slot == "task_entry_send" then
        M.clear_cached_task_entry_send_button_target()
    elseif slot == "dialogue_jump" then
        M.clear_cached_dialogue_jump_button_target()
    elseif slot == "interaction_prompt" then
        M.clear_cached_interaction_prompt_button_target()
    elseif slot == "main_task" then
        M.clear_cached_main_task_button_target()
    elseif slot == "treasure_task" then
        M.clear_cached_treasure_task_button_target()
    elseif M.is_generic_cached_button_slot(slot) then
        M.clear_cached_registered_button_slot_target(slot)
    else
        return false, "unsupported button slot: " .. slot
    end

    logger(ctx).info(string.format(
        "[Leveling] cleared button slot cache | slot=%s reason=%s",
        slot,
        tostring(reason or "")
    ))
    return true
end

function M.describe_button_slot_runtime_cache(slot)
    slot = tostring(slot or "")
    local target = nil
    local global_target = nil
    if slot == "task_entry_send" then
        target = state.cached_task_entry_send_target
    elseif slot == "dialogue_jump" then
        target = state.cached_dialogue_jump_button_target
    elseif slot == "interaction_prompt" then
        target = state.cached_interaction_prompt_target
    elseif slot == "main_task" then
        target = state.cached_main_task_button_target
        global_target = _G.AVEPOINT_CACHED_MAIN_TASK_BUTTON_TARGET
    elseif slot == "treasure_task" then
        target = state.cached_treasure_task_button_target
    elseif M.is_generic_cached_button_slot(slot) then
        local mem = type(state.cached_button_slot_targets) == "table" and state.cached_button_slot_targets or nil
        local global = type(_G.AVEPOINT_CACHED_BUTTON_SLOT_TARGETS) == "table" and _G.AVEPOINT_CACHED_BUTTON_SLOT_TARGETS or nil
        target = type(mem) == "table" and mem[slot] or nil
        global_target = type(global) == "table" and global[slot] or nil
    end

    local mem = type(target) == "table"
    local global_mem = type(global_target) == "table"
    local summary_target = mem and target or (global_mem and global_target or nil)
    return string.format(
        "mem=%s global=%s addr=%s source=%s captured_at=%s",
        mem and "true" or "false",
        global_mem and "true" or "false",
        type(summary_target) == "table" and tostring(summary_target.addr or "") or "",
        type(summary_target) == "table" and tostring(summary_target.source or "") or "",
        type(summary_target) == "table" and tostring(summary_target.captured_at or "") or ""
    )
end

function M.log_button_slot_target_resolved(ctx, slot, source, target, step, extra)
    logger(ctx).info(string.format(
        "[Leveling] button slot target resolved | slot=%s label=%s source=%s target=%s extra=%s",
        tostring(slot or ""),
        tostring(type(step) == "table" and step.label or ""),
        tostring(source or ""),
        M.format_main_task_click_target_brief(type(target) == "table" and target or {}),
        tostring(extra or "")
    ))
end

function M.call_button_slot(ctx, current_time, slot, step, opts)
    slot = tostring(slot or "")
    opts = type(opts) == "table" and opts or {}
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" then
        return false, "nav api unavailable"
    end

    step = M.apply_button_slot_step_defaults(slot, step)
    local cache_disabled = M.button_call_cache_disabled()
    local try_cached = opts.try_cached == true and not cache_disabled
    local hover_capture_disabled = M.button_call_hover_capture_disabled()
    local allow_hover_capture = opts.allow_hover_capture == true and not hover_capture_disabled
    logger(ctx).info(string.format(
        "[Leveling] button slot call begin | slot=%s label=%s reason=%s try_cached=%s cache_policy=%s hover_capture=%s cache_context=%s cache=%s task=%s detail=%s",
        slot,
        tostring(type(step) == "table" and step.label or ""),
        tostring(opts.reason or ""),
        try_cached and "true" or "false",
        cache_disabled and "disabled" or "enabled",
        allow_hover_capture and "enabled" or (hover_capture_disabled and "disabled" or "off"),
        tostring(opts.cache_context or ""),
        M.describe_button_slot_runtime_cache(slot),
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(M.current_task_log_detail() or state.current_task_detail or "")
    ))
    if slot == "dialogue_jump" then
        local cached_err = nil
        if try_cached then
            local cached_clicked, cached_target_or_err = M.try_cached_dialogue_jump_button_click(
                ctx,
                nav_mod,
                current_time,
                step,
                tostring(opts.reason or "button_slot_dialogue_jump")
            )
            if cached_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "cached_addr", cached_target_or_err, step, "clicked=true")
                return true, {
                    target = cached_target_or_err,
                    source = "cached_addr",
                    clicked_at = now_ms(ctx)
                }
            end
            cached_err = cached_target_or_err
            if trim(cached_err or "") ~= "" then
                log_throttled(ctx, "button_slot_dialogue_jump_cached_miss", "info", LOG_THROTTLE_MS,
                    "[Leveling] button slot cached target miss | slot=dialogue_jump err=" .. tostring(cached_err))
            end
        end

        local live_target, live_err = fetch_locator_button_target(ctx, step)
        local target = nil
        local source = "locator"
        if type(live_target) == "table" then
            target = live_target
            M.cache_dialogue_jump_button_target(ctx, live_target, current_time, "locator_fetch", step)
        else
            log_throttled(ctx, "button_slot_dialogue_jump_live_miss", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] button slot live target miss | slot=%s label=%s err=%s",
                slot,
                tostring(type(step) == "table" and step.label or ""),
                tostring(live_err or "")
            ))

            if not allow_hover_capture then
                return false, live_err or cached_err or "button slot live target unavailable; hover capture disabled"
            end

            local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
                reason = tostring(opts.reason or "button_slot_" .. slot)
            })
            if type(captured) ~= "table" then
                return false, capture_err or live_err or cached_err or "button slot target unavailable"
            end
            target = captured
            source = "hover_capture"
        end

        M.log_button_slot_target_resolved(ctx, slot, source, target, step, "")
        local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
        if clicked ~= true then
            return false, click_err or "button slot click failed", retryable, "click_failed"
        end

        local after_click_time = now_ms(ctx)
        M.cache_dialogue_jump_button_target(ctx, target, current_time, source == "hover_capture" and "hover_capture_click" or "locator_click", step)
        logger(ctx).info(string.format(
            "[Leveling] button slot click dispatch | slot=%s label=%s addr=%s pos=(%s,%s) source=%s",
            slot,
            tostring(type(step) == "table" and step.label or ""),
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or ""),
            source
        ))
        return true, {
            target = target,
            source = source,
            clicked_at = after_click_time
        }
    end

    if slot == "interaction_prompt" then
        local cached_err = nil
        if try_cached then
            local cached_clicked, cached_target_or_err = M.try_cached_interaction_prompt_button_click(
                ctx,
                nav_mod,
                current_time,
                step,
                tostring(opts.reason or "button_slot_interaction_prompt")
            )
            if cached_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "cached_addr", cached_target_or_err, step, "clicked=true")
                return true, {
                    target = cached_target_or_err,
                    source = "cached_addr",
                    clicked_at = now_ms(ctx)
                }
            end
            cached_err = cached_target_or_err
            if trim(cached_err or "") ~= "" then
                log_throttled(ctx, "button_slot_interaction_prompt_cached_miss", "info", LOG_THROTTLE_MS,
                    "[Leveling] button slot cached target miss | slot=interaction_prompt err=" .. tostring(cached_err))
            end
        end

        local target = nil
        local source = ""
        if type(opts.initial_target) == "table" then
            target = M.cache_interaction_prompt_button_target(
                ctx,
                opts.initial_target,
                current_time,
                tostring(opts.initial_source or "callsite_target"),
                step
            )
            if type(target) == "table" then
                source = tostring(opts.initial_source or "callsite_target")
            end
        end

        local live_err = nil
        if type(target) ~= "table" then
            local live_target, fetch_err = fetch_locator_button_target(ctx, step)
            live_err = fetch_err
            if type(live_target) == "table" then
                target = M.cache_interaction_prompt_button_target(ctx, live_target, current_time, "locator_fetch", step)
                    or live_target
                source = "locator"
            else
                log_throttled(ctx, "button_slot_interaction_prompt_live_miss", "info", LOG_THROTTLE_MS, string.format(
                    "[Leveling] button slot live target miss | slot=%s label=%s err=%s",
                    slot,
                    tostring(type(step) == "table" and step.label or ""),
                    tostring(fetch_err or "")
                ))
            end
        end

        if type(target) ~= "table" then
            if not allow_hover_capture then
                return false, live_err or cached_err or "button slot live target unavailable; hover capture disabled"
            end

            local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
                reason = tostring(opts.reason or "button_slot_" .. slot),
                ignore_retry_gate = opts.ignore_hover_capture_cooldown ~= false
            })
            if type(captured) ~= "table" then
                return false, capture_err or live_err or cached_err or "button slot target unavailable"
            end
            target = captured
            source = "hover_capture"
        end

        M.log_button_slot_target_resolved(ctx, slot, source, target, step, "")
        local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
        if clicked ~= true then
            return false, click_err or "button slot click failed", retryable, "click_failed"
        end

        local after_click_time = now_ms(ctx)
        logger(ctx).info(string.format(
            "[Leveling] button slot click dispatch | slot=%s label=%s addr=%s pos=(%s,%s) source=%s",
            slot,
            tostring(type(step) == "table" and step.label or ""),
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or ""),
            source
        ))
        return true, {
            target = target,
            source = source,
            clicked_at = after_click_time
        }
    end

    if slot == "main_task" then
        logger(ctx).info("[Leveling] main task button slot disabled | reason=live_enum_text_distance_owns_main_task_call")
        return false, "main task hover capture disabled; use live enum text-distance"
    end

    if slot == "main_task_legacy" then
        if type(step) ~= "table" then
            step = M.apply_main_task_button_step_defaults(MAIN_TASK_BUTTON_STEP)
        end
        if type(step) ~= "table" then
            return false, "main task button step unavailable"
        end

        local hint_x = tonumber(opts.hint_x or step.hint_client_x)
        local hint_y = tonumber(opts.hint_y or step.hint_client_y)
        if hint_x == nil or hint_y == nil then
            return false, "main task button hint unavailable"
        end

        local ops = type(opts.ops) == "table" and opts.ops or nil
        if type(ops) ~= "table" then
            return false, "main task button slot requires click ops"
        end

        local preserve_target = opts.preserve_target == true
        local force_hover_capture = opts.force_hover_capture == true or M.MAIN_TASK_BUTTON_HOVER_EACH_CALL == true
        if force_hover_capture then
            M.clear_cached_main_task_button_target()
        end
        local allow_session_restore = opts.allow_session_restore ~= false and not force_hover_capture
        local cached_err = nil
        local has_live_cached_target = type(state.cached_main_task_button_target) == "table"
            or type(_G.AVEPOINT_CACHED_MAIN_TASK_BUTTON_TARGET) == "table"
        local allow_direct_session_restore = opts.allow_direct_session_restore == true
        logger(ctx).info(string.format(
            "[Leveling] main task button slot state | hint=(%.2f,%.2f) preserve=%s force_hover=%s allow_session_restore=%s allow_direct_session_restore=%s has_live_cached=%s cache=%s",
            tonumber(hint_x) or 0,
            tonumber(hint_y) or 0,
            preserve_target and "true" or "false",
            force_hover_capture and "true" or "false",
            allow_session_restore and "true" or "false",
            allow_direct_session_restore and "true" or "false",
            has_live_cached_target and "true" or "false",
            M.describe_button_slot_runtime_cache(slot)
        ))

        if not force_hover_capture and (has_live_cached_target or (allow_session_restore and allow_direct_session_restore)) then
            local cached_clicked, cached_target_or_err = M.try_cached_main_task_addr_click(
                ctx,
                nav_mod,
                current_time,
                hint_x,
                hint_y,
                tostring(opts.reason or "button_slot_main_task"),
                preserve_target,
                {
                    validate_main_task_anchor_target = ops.validate_main_task_anchor_target,
                    attempt_main_task_control_click = ops.attempt_main_task_control_click,
                    apply_main_task_click_result = ops.apply_main_task_click_result,
                    allow_session_restore = allow_session_restore and (has_live_cached_target or allow_direct_session_restore)
                }
            )
            if cached_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "cached_addr", cached_target_or_err, step, "clicked=true")
                return true, {
                    target = cached_target_or_err,
                    source = "cached_addr",
                    clicked_at = now_ms(ctx)
                }
            end
            cached_err = cached_target_or_err
            if trim(cached_err or "") ~= "" then
                log_throttled(ctx, "button_slot_main_task_cached_miss", "info", LOG_THROTTLE_MS,
                    "[Leveling] button slot cached target miss | slot=main_task err=" .. tostring(cached_err))
            end
        end

        local has_cached_target = type(state.cached_main_task_button_target) == "table"
            or type(_G.AVEPOINT_CACHED_MAIN_TASK_BUTTON_TARGET) == "table"
        if force_hover_capture or not has_cached_target then
            logger(ctx).info(string.format(
                "[Leveling] button slot hover capture required | slot=%s reason=%s hint=(%.2f,%.2f)",
                slot,
                tostring(opts.reason or ""),
                tonumber(hint_x) or 0,
                tonumber(hint_y) or 0
            ))
            local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
                hint_x = hint_x,
                hint_y = hint_y,
                reason = tostring(opts.reason or "button_slot_" .. slot),
                no_cache = force_hover_capture or opts.no_cache == true
            })
            if type(captured) ~= "table" then
                return false, capture_err or cached_err or "button slot target unavailable"
            end

            if force_hover_capture then
                local allowed, reject = ops.validate_main_task_anchor_target(
                    captured,
                    "legacy_hover_capture_fresh",
                    hint_x,
                    hint_y
                )
                if not allowed then
                    return false, reject or "legacy hover main task target rejected"
                end

                local clicked, click_err = ops.attempt_main_task_control_click(
                    "legacy_hover_capture_fresh",
                    captured,
                    tostring(opts.reason or "")
                )
                if not clicked then
                    return false, click_err or "legacy hover main task addr click failed", nil, "click_failed"
                end

                local verified, verify_detail = M.verify_main_task_activation_for_click(
                    ctx,
                    nav_mod,
                    "legacy_hover_capture_fresh"
                )
                if not verified then
                    local accept_verify_miss, accept_reason = M.should_accept_main_task_verify_miss()
                    if accept_verify_miss then
                        verify_detail = "verify_miss_accepted:" .. tostring(accept_reason or "")
                            .. ":" .. tostring(verify_detail or "")
                    else
                        verify_detail = "verify_miss_deferred:" .. tostring(verify_detail or "")
                    end
                end

                ops.apply_main_task_click_result(captured, hint_x, hint_y)
                logger(ctx).info(string.format(
                    "[Leveling] legacy main task hover verify result | verified=%s detail=%s target=%s",
                    verified and "true" or "false",
                    tostring(verify_detail or ""),
                    M.format_main_task_click_target_brief(captured)
                ))
                logger(ctx).info(string.format(
                    "[Leveling] main task button clicked | task=%s mode=%s source=legacy_hover_capture_fresh addr=%s pos=(%s,%s) hint=(%.2f,%.2f) verify=%s cache_source=disabled",
                    tostring(M.current_task_log_name() or ""),
                    preserve_target == true and "soft_refresh" or "hard_refresh",
                    tostring(captured.addr or ""),
                    tostring(captured.x or ""),
                    tostring(captured.y or ""),
                    tonumber(hint_x) or 0,
                    tonumber(hint_y) or 0,
                    tostring(verify_detail or "")
                ))
                M.log_button_slot_target_resolved(ctx, slot, "legacy_hover_capture_fresh", captured, step, "clicked=true no_cache=true")
                return true, {
                    target = captured,
                    source = "legacy_hover_capture_fresh",
                    clicked_at = now_ms(ctx)
                }
            end

            local hover_clicked, hover_target_or_err = M.try_cached_main_task_addr_click(
                ctx,
                nav_mod,
                current_time,
                hint_x,
                hint_y,
                "post_hover_capture",
                preserve_target,
                {
                    validate_main_task_anchor_target = ops.validate_main_task_anchor_target,
                    attempt_main_task_control_click = ops.attempt_main_task_control_click,
                    apply_main_task_click_result = ops.apply_main_task_click_result,
                    allow_session_restore = true
                }
            )
            if hover_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "hover_capture", captured, step, "post_hover_click=true")
                return true, {
                    target = captured,
                    source = "hover_capture",
                    clicked_at = now_ms(ctx)
                }
            end
            return false, hover_target_or_err or "hover-captured main task addr click failed", nil, "click_failed"
        end

        return false, cached_err or "cached main task button target unavailable"
    end

    if slot == "treasure_task" then
        if type(step) ~= "table" then
            step = M.apply_treasure_task_button_step_defaults(
                type(M.TREASURE_TASK_BUTTON_STEP) == "table" and M.TREASURE_TASK_BUTTON_STEP or nil
            )
        end
        if type(step) ~= "table" then
            return false, "treasure task button step unavailable"
        end

        local query = opts.query
        local cached_err = nil
        if try_cached then
            local cached_clicked, cached_target_or_err = M.try_cached_treasure_task_button_click(
                ctx,
                nav_mod,
                current_time,
                query,
                tostring(opts.reason or "button_slot_treasure_task")
            )
            if cached_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "cached_addr", cached_target_or_err, step, "clicked=true")
                return true, {
                    target = cached_target_or_err,
                    source = "cached_addr",
                    clicked_at = now_ms(ctx)
                }
            end
            cached_err = cached_target_or_err
            if trim(cached_err or "") ~= "" then
                log_throttled(ctx, "button_slot_treasure_task_cached_miss", "info", LOG_THROTTLE_MS,
                    "[Leveling] button slot cached target miss | slot=treasure_task query="
                        .. tostring(query or "")
                        .. " err=" .. tostring(cached_err))
            end
        end

        local target = nil
        local source = "live_locator"
        local live_target, live_err = fetch_locator_button_target(ctx, step)
        if type(live_target) == "table" then
            target = live_target
        else
            log_throttled(ctx, "button_slot_treasure_task_live_miss", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] button slot live target miss | slot=%s query=%s err=%s",
                slot,
                tostring(query or ""),
                tostring(live_err or "")
            ))
            if not allow_hover_capture then
                return false, live_err or cached_err or "button slot live target unavailable; hover capture disabled"
            end

            local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
                query = query,
                reason = tostring(opts.reason or "button_slot_" .. slot)
            })
            if type(captured) ~= "table" then
                return false, capture_err or cached_err or "button slot target unavailable"
            end
            target = captured
            source = "hover_capture"
        end

        M.log_button_slot_target_resolved(ctx, slot, source, target, step, "query=" .. tostring(query or ""))
        local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
        if clicked ~= true then
            return false, click_err or "button slot click failed", retryable, "click_failed"
        end

        local after_click_time = now_ms(ctx)
        logger(ctx).info(string.format(
            "[Leveling] button slot click dispatch | slot=%s query=%s addr=%s pos=(%s,%s) source=%s",
            slot,
            tostring(query or ""),
            tostring(target.addr or ""),
            tostring(target.x or ""),
            tostring(target.y or ""),
            source
        ))
        return true, {
            target = target,
            source = source,
            clicked_at = after_click_time
        }
    end

    if M.is_generic_cached_button_slot(slot) then
        if type(step) ~= "table" then
            return false, "registered button slot step unavailable"
        end
        step = M.apply_registered_button_slot_step_defaults(slot, step)

        local cached_err = nil
        if try_cached then
            local cached_clicked, cached_target_or_err = M.try_cached_registered_button_slot_click(
                ctx,
                nav_mod,
                current_time,
                slot,
                step,
                tostring(opts.reason or "button_slot_" .. slot),
                opts
            )
            if cached_clicked == true then
                M.log_button_slot_target_resolved(ctx, slot, "cached_addr", cached_target_or_err, step, "clicked=true")
                return true, {
                    target = cached_target_or_err,
                    source = "cached_addr",
                    clicked_at = now_ms(ctx)
                }
            end
            cached_err = cached_target_or_err
            if trim(cached_err or "") ~= "" then
                log_throttled(ctx, "button_slot_registered_cached_miss_" .. slot, "info", LOG_THROTTLE_MS,
                    "[Leveling] button slot cached target miss | slot="
                        .. tostring(slot)
                        .. " err="
                        .. tostring(cached_err))
            end
        end

        local target = nil
        local source = "live_locator"
        local live_target, live_err = fetch_locator_button_target(ctx, step)
        if type(live_target) == "table" then
            target = live_target
        else
            log_throttled(ctx, "button_slot_registered_live_miss_" .. slot, "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] button slot live target miss | slot=%s label=%s err=%s",
                slot,
                tostring(type(step) == "table" and step.label or ""),
                tostring(live_err or "")
            ))
            if not allow_hover_capture then
                return false, live_err or cached_err or "button slot live target unavailable; hover capture disabled"
            end

            local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
                reason = tostring(opts.reason or "button_slot_" .. slot)
            })
            if type(captured) ~= "table" then
                return false, capture_err or cached_err or "button slot target unavailable"
            end
            target = captured
            source = "hover_capture"
        end

        M.log_button_slot_target_resolved(ctx, slot, source, target, step, "")
        local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
        if clicked ~= true then
            if M.is_control_click_hard_failure(click_err) then
                M.clear_cached_registered_button_slot_addr_with_log(ctx, slot, click_err or "button slot click failed")
            end
            return false, click_err or "button slot click failed", retryable, "click_failed"
        end

        local after_click_time = now_ms(ctx)
        if source == "hover_capture" then
            M.cache_registered_button_slot_target(ctx, slot, target, after_click_time, "hover_capture_click", step, opts)
        end
        logger(ctx).info(string.format(
            "[Leveling] button slot click dispatch | slot=%s label=%s addr=%s pos=(%s,%s) source=%s",
            slot,
            tostring(type(step) == "table" and step.label or ""),
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or ""),
            source
        ))
        return true, {
            target = target,
            source = source,
            clicked_at = after_click_time
        }
    end

    if slot ~= "task_entry_send" then
        return false, "button slot call is not migrated yet: " .. slot
    end

    local live_target, live_err, live_source, live_step = M.fetch_locator_button_target_with_configured_fallback(
        ctx,
        step,
        current_time,
        "task_entry_send"
    )
    local target = nil
    local source = "live_locator"
    if type(live_target) == "table" then
        target = live_target
        source = tostring(live_source or "live_locator")
        if tostring(target.kind or "") ~= "client_point" then
            M.cache_task_entry_send_button_target(ctx, live_target, current_time, source, live_step or step)
        end
    else
        log_throttled(ctx, "button_slot_task_entry_send_live_miss", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] button slot live target miss | slot=%s label=%s err=%s",
            slot,
            tostring(type(step) == "table" and step.label or ""),
            tostring(live_err or "")
        ))

        if not allow_hover_capture then
            return false, live_err or "button slot live target unavailable; hover capture disabled"
        end

        local captured, capture_err = M.capture_button_slot_target(ctx, nav_mod, current_time, slot, step, {
            reason = tostring(opts.reason or "button_slot_" .. slot)
        })
        if type(captured) ~= "table" then
            return false, capture_err or live_err or "button slot target unavailable"
        end
        target = captured
        source = "hover_capture"
    end

    local click_step = live_step or step
    M.log_button_slot_target_resolved(ctx, slot, source, target, click_step, "")
    local clicked, click_err, retryable = click_locator_button_target(ctx, click_step, target)
    if clicked ~= true then
        return false, click_err or "button slot click failed", retryable, "click_failed"
    end

    local after_click_time = now_ms(ctx)
    logger(ctx).info(string.format(
        "[Leveling] button slot click dispatch | slot=%s label=%s addr=%s pos=(%s,%s) source=%s",
        slot,
        tostring(type(step) == "table" and step.label or ""),
        tostring(type(target) == "table" and target.addr or ""),
        tostring(type(target) == "table" and target.x or ""),
        tostring(type(target) == "table" and target.y or ""),
        source
    ))

    return true, {
        target = target,
        source = source,
        clicked_at = after_click_time
    }
end

function M.resolve_window_client_point(ctx, ratio_x, ratio_y)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.window_hwnd) ~= "function" then
        return nil, nil, nil, "nav.window_hwnd is unavailable."
    end

    local hwnd, hwnd_err = nav_mod.window_hwnd()
    if not hwnd then
        return nil, nil, nil, hwnd_err or "game window not found."
    end

    local wnd_api = type(ctx) == "table" and ctx.wnd or wnd
    if type(wnd_api) ~= "table" or type(wnd_api.client_rect) ~= "function" then
        return nil, nil, nil, "wnd.client_rect is unavailable."
    end

    local _, _, client_w, client_h = wnd_api.client_rect(hwnd)
    if type(client_w) ~= "number" or type(client_h) ~= "number" then
        return nil, nil, nil, "wnd.client_rect failed."
    end

    local client_x = math.floor(client_w * (tonumber(ratio_x) or 0.5) + 0.5)
    local client_y = math.floor(client_h * (tonumber(ratio_y) or 0.5) + 0.5)
    return hwnd, client_x, client_y
end

function M.click_window_client_point(ctx, current_time, label, ratio_x, ratio_y, opts)
    local hwnd, client_x, client_y, point_err = M.resolve_window_client_point(ctx, ratio_x, ratio_y)
    if not hwnd then
        return false, point_err
    end

    release_async_combat_inputs(ctx, current_time, true)

    local use_human_center_click = false
    local click_mode = "api"
    if type(opts) == "table" then
        use_human_center_click = opts.center_use_human_mouse == true or opts.use_human_mouse == true
        if opts.center_mouse_mode ~= nil or opts.mouse_mode ~= nil then
            use_human_center_click = true
            click_mode = tostring(opts.center_mouse_mode or opts.mouse_mode or "api")
        end
    end
    if use_human_center_click then
        if click_mode == "" or click_mode == "human" then
            click_mode = "api"
        end
        local click_step = {
            key = tostring(label or "task_entry_center"),
            label = tostring(label or "task_entry_center"),
            fixed_client_click = true,
            fixed_ratio_x = tonumber(ratio_x) or 0.5,
            fixed_ratio_y = tonumber(ratio_y) or 0.5,
            fixed_prefer_ratio = true,
            prefer_screen_click = true,
            mouse_mode = tostring(click_mode),
            click_button = tostring(type(opts) == "table" and (opts.center_click_button or opts.click_button) or "left"),
            click_delay_ms = tonumber(type(opts) == "table" and (opts.center_click_delay_ms or opts.click_delay_ms)) or 50,
            hover_delay_ms = tonumber(type(opts) == "table" and (opts.center_hover_delay_ms or opts.hover_delay_ms)) or 80,
            allow_outside = type(opts) == "table" and opts.center_allow_outside == true
        }
        local target, target_err = M.resolve_fixed_client_click_target(ctx, click_step)
        if type(target) ~= "table" then
            return false, target_err
        end

        local clicked, click_err, retryable = click_locator_button_target(ctx, click_step, target)
        if clicked then
            logger(ctx).info(string.format(
                "[Leveling] task entry center clicked | label=%s client=(%d,%d) screen=(%s,%s) route=human_mouse mode=%s",
                tostring(label or ""),
                tonumber(client_x) or 0,
                tonumber(client_y) or 0,
                tostring(target.click_screen_x or ""),
                tostring(target.click_screen_y or ""),
                tostring(click_mode or "")
            ))
            return true
        end
        return false, click_err or (retryable and "retryable click failed" or "human center click failed.")
    end

    local nav_mod = nav_api(ctx)
    if type(nav_mod) == "table" and type(nav_mod.click_window_to_move) == "function" then
        local clicked, click_err = nav_mod.click_window_to_move(hwnd, client_x, client_y, {
            button = "left",
            delay = 50,
            wait = false
        })
        if clicked then
            logger(ctx).info(string.format(
                "[Leveling] task entry center clicked | label=%s client=(%d,%d)",
                tostring(label or ""),
                tonumber(client_x) or 0,
                tonumber(client_y) or 0
            ))
            return true
        end
        return false, click_err
    end

    local mouse_api = type(ctx) == "table" and ctx.mouse or mouse
    if type(mouse_api) == "table" and type(mouse_api.post_click) == "function" then
        local clicked = mouse_api.post_click(hwnd, client_x, client_y, "left", 50)
        if clicked then
            logger(ctx).info(string.format(
                "[Leveling] task entry center clicked | label=%s client=(%d,%d)",
                tostring(label or ""),
                tonumber(client_x) or 0,
                tonumber(client_y) or 0
            ))
            return true
        end
        return false, "mouse.post_click failed."
    end

    return false, "window center click API is unavailable."
end

function M.click_current_mouse_position(ctx, current_time, label, opts)
    current_time = tonumber(current_time) or now_ms(ctx)
    opts = type(opts) == "table" and opts or {}

    release_async_combat_inputs(ctx, current_time, true)

    local prepared, prepare_err = prepare_inputs(ctx, current_time, {
        need_mouse = true
    })
    if not prepared then
        return false, prepare_err or "mouse input prepare failed."
    end

    local mouse_api = select(2, input_apis(ctx))
    if type(mouse_api) ~= "table" then
        return false, "mouse api unavailable."
    end

    local click_button = tostring(opts.button or opts.click_button or "left")
    local click_delay_ms = tonumber(opts.delay_ms or opts.click_delay_ms) or 50
    if type(mouse_api.click) == "function" then
        local ok, result = safe_call(mouse_api.click, click_button, click_delay_ms)
        if ok and result ~= false then
            logger(ctx).info(string.format(
                "[Leveling] current mouse position clicked | label=%s route=mouse_click_current",
                tostring(label or "")
            ))
            return true
        end
    end

    return false, string.format("mouse.click(%s) failed.", click_button)
end

function M.maybe_block_task_entry_for_skip_sequence(ctx, current_time, source)
    current_time = tonumber(current_time) or now_ms(ctx)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_ui) ~= "function" then
        return false
    end

    local ui, ui_err = nav_mod.enum_ui()
    if type(ui) ~= "table" then
        log_throttled(ctx, "task_entry_skip_enum_failed", "info", LOG_THROTTLE_MS,
            "[Leveling] task entry skip guard enum failed: " .. tostring(ui_err or ""))
        return false
    end

    local skip_target = nil
    local skip_match = nil
    local skip_layer_seen = false
    local function scan(items, kind)
        for _, item in ipairs(items or {}) do
            local identity = ui_item_text(item)
            if identity ~= "" then
                local is_skip_button = identity:find("skiplevelsequence_c.widgettree.skipbutton", 1, true) ~= nil
                    or identity:find("noviceguidemainui_c.widgettree.c_skipbutton", 1, true) ~= nil
                local is_skip_layer = is_skip_button
                    or identity:find("skiplevelsequence_c", 1, true) ~= nil
                    or identity:find("cinematic", 1, true) ~= nil
                    or identity:find("movie", 1, true) ~= nil
                if is_skip_layer then
                    skip_layer_seen = true
                    skip_match = skip_match or string.format("%s:%s", tostring(kind or "ui"), identity)
                end
                if is_skip_button and skip_target == nil then
                    local addr = tonumber(item and item.addr)
                    if addr ~= nil and addr ~= 0 then
                        skip_target = {
                            addr = addr,
                            x = as_number(item and item.x),
                            y = as_number(item and item.y),
                            identity = identity
                        }
                    end
                end
            end
        end
    end

    scan(ui.buttons, "button")
    scan(ui.images, "image")
    scan(ui.texts, "text")

    if skip_layer_seen ~= true then
        return false
    end

    state.stage = tostring(source or "task_entry_skip_sequence")
    release_async_combat_inputs(ctx, current_time, true)
    hold_navigation(ctx, current_time, "skip_level_sequence")
    state.next_task_button_click_at = math.max(tonumber(state.next_task_button_click_at) or 0, current_time + 500)
    state.task_path_wait_until = math.max(tonumber(state.task_path_wait_until) or 0, current_time + 500)

    if current_time < (tonumber(state.next_guide_skip_click_at) or 0) then
        log_throttled(ctx, "task_entry_skip_sequence_wait", "info", 600, string.format(
            "[Leveling] task entry action blocked by skip sequence | source=%s match=%s retry_in=%dms",
            tostring(source or ""),
            tostring(skip_match or ""),
            math.max(0, (tonumber(state.next_guide_skip_click_at) or current_time) - current_time)
        ))
        return true
    end

    if skip_target ~= nil and type(nav_mod.control_click) == "function" then
        local ok, err = nav_mod.control_click(skip_target.addr)
        state.next_guide_skip_click_at = current_time + 800
        state.pause_combat_until = math.max(tonumber(state.pause_combat_until) or 0, current_time + POST_UI_PAUSE_MS)
        logger(ctx)[ok and "info" or "warn"](string.format(
            "[Leveling] task entry skip sequence control_click %s | source=%s addr=%s pos=(%s,%s) match=%s err=%s",
            ok and "sent" or "failed",
            tostring(source or ""),
            tostring(skip_target.addr or ""),
            tostring(skip_target.x or ""),
            tostring(skip_target.y or ""),
            tostring(skip_match or skip_target.identity or ""),
            tostring(err or "")
        ))
        return true
    end

    state.next_guide_skip_click_at = current_time + 350
    log_throttled(ctx, "task_entry_skip_sequence_no_button", "info", 600, string.format(
        "[Leveling] task entry action blocked by skip sequence, waiting skip button | source=%s match=%s",
        tostring(source or ""),
        tostring(skip_match or "")
    ))
    return true
end

function M.is_task_entry_world_map_panel_ready(ctx, current_time, source)
    current_time = tonumber(current_time) or now_ms(ctx)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_ui) ~= "function" then
        return true, "nav.enum_ui unavailable; allow legacy world map entry"
    end

    local ui, ui_err = nav_mod.enum_ui()
    if type(ui) ~= "table" then
        return true, "enum_ui failed; allow legacy world map entry: " .. tostring(ui_err or "")
    end

    local found = nil
    local function scan(items, kind)
        for _, item in ipairs(items or {}) do
            local x = as_number(item and item.x)
            local y = as_number(item and item.y)
            local visible = x ~= nil and y ~= nil and not (math.abs(x) < 0.01 and math.abs(y) < 0.01)
            if visible then
                local identity = ui_item_text(item)
                if identity ~= ""
                    and identity:find("minimap", 1, true) == nil
                    and (
                        identity:find("worldmap", 1, true) ~= nil
                        or identity:find("world_map", 1, true) ~= nil
                    )
                then
                    found = string.format("%s:%s", tostring(kind or "ui"), identity)
                    return true
                end
            end
        end
        return false
    end

    if scan(ui.buttons, "button")
        or scan(ui.images, "image")
        or scan(ui.texts, "text")
    then
        return true, found
    end

    return false, "world map panel not visible for " .. tostring(source or "task_entry")
end

function M.task_entry_action_hotkey_vk(entry_action)
    if type(entry_action) ~= "table" then
        return nil
    end
    local vk = tonumber(entry_action.hotkey_vk or entry_action.key_vk or entry_action.vk)
    if vk ~= nil then
        return vk
    end
    local key_name = string.upper(trim(entry_action.hotkey or entry_action.hotkey_key or entry_action.press_key or ""))
    if key_name == "A" then
        return M.VK_A
    end
    if key_name == "D" then
        return VK_D
    end
    return nil
end

function M.maybe_handle_task_entry_key_sequence(ctx, current_time, player_x, player_y, player_z, entry_action, task_name)
    if type(entry_action) ~= "table" then
        return false
    end

    local button_click_at = tonumber(state.task_entry_action_button_click_at) or tonumber(state.last_task_button_click_at) or 0
    if button_click_at <= 0 then
        return false
    end

    local effective_time = tonumber(current_time) or now_ms(ctx)
    if button_click_at > effective_time then
        effective_time = button_click_at
    end

    local timeout_ms = math.max(5000, tonumber(entry_action.timeout_ms) or 5000)
    local initial_delay_ms = math.max(0, tonumber(entry_action.initial_delay_ms or entry_action.delay_ms) or 250)
    local action_elapsed_ms = effective_time - button_click_at

    if action_elapsed_ms > timeout_ms then
        local locked_entry_key = tostring(state.task_entry_action_locked_key or entry_action.key or "")
        M.clear_task_entry_action_state()
        log_throttled(ctx, "task_entry_key_sequence_timeout", "warn", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry key sequence timeout, fallback to normal path | task=%s key=%s elapsed=%dms",
            tostring(task_name or state.current_task_name or ""),
            tostring(locked_entry_key),
            tonumber(action_elapsed_ms) or 0
        ))
        return false
    end

    state.stage = "task_entry_action"
    release_async_combat_inputs(ctx, current_time, true)
    hold_navigation(ctx, current_time, "task_entry_key_sequence")
    state.task_path_wait_until = math.max(tonumber(state.task_path_wait_until) or 0, effective_time + 800)
    state.next_task_button_click_at = math.max(tonumber(state.next_task_button_click_at) or 0, effective_time + 800)

    if action_elapsed_ms < initial_delay_ms then
        log_throttled(ctx, "task_entry_key_sequence_initial_delay", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry key sequence waiting initial delay | task=%s key=%s elapsed=%dms wait=%dms",
            tostring(task_name or state.current_task_name or ""),
            tostring(entry_action.key or ""),
            tonumber(action_elapsed_ms) or 0,
            tonumber(initial_delay_ms) or 0
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    local hotkey_vk = M.task_entry_action_hotkey_vk(entry_action)
    if hotkey_vk == nil then
        local locked_entry_key = tostring(state.task_entry_action_locked_key or entry_action.key or "")
        M.clear_task_entry_action_state()
        logger(ctx).warn(string.format(
            "[Leveling] task entry key sequence missing hotkey, cleared lock | task=%s key=%s",
            tostring(task_name or state.current_task_name or ""),
            tostring(locked_entry_key)
        ))
        return false
    end

    local repeat_count = math.max(1, math.floor(tonumber(entry_action.repeat_count or entry_action.key_repeat_count or entry_action.count) or 1))
    local interval_ms = math.max(0, tonumber(entry_action.interval_ms or entry_action.key_interval_ms or entry_action.repeat_interval_ms) or 120)
    local label = tostring(entry_action.hotkey_label or entry_action.label or entry_action.key or "task entry key sequence")
    for index = 1, repeat_count do
        local press_time = now_ms(ctx)
        local ok, err = press_keyboard_hotkey(ctx, press_time, hotkey_vk, label)
        if not ok then
            local locked_entry_key = tostring(state.task_entry_action_locked_key or entry_action.key or "")
            M.clear_task_entry_action_state()
            logger(ctx).warn(string.format(
                "[Leveling] task entry key sequence failed, cleared lock | task=%s key=%s index=%d/%d err=%s",
                tostring(task_name or state.current_task_name or ""),
                tostring(locked_entry_key),
                index,
                repeat_count,
                tostring(err or "")
            ))
            return false
        end
        if index < repeat_count and interval_ms > 0 then
            sleep_ms(ctx, interval_ms)
        end
    end

    local after_key_time = now_ms(ctx)
    local locked_entry_key = tostring(state.task_entry_action_locked_key or entry_action.key or "")
    M.clear_task_entry_action_state()
    state.next_task_refresh_at = math.min(tonumber(state.next_task_refresh_at) or after_key_time, after_key_time)
    logger(ctx).info(string.format(
        "[Leveling] task entry key sequence completed, cleared lock | task=%s key=%s vk=0x%02X count=%d",
        tostring(task_name or state.current_task_name or ""),
        tostring(locked_entry_key),
        tonumber(hotkey_vk) or 0,
        repeat_count
    ))
    log_heartbeat(ctx, after_key_time, player_x, player_y, player_z)
    return true
end

function M.maybe_handle_task_entry_action(ctx, current_time, player_x, player_y, player_z)
    local entry_action, task_name = M.current_task_entry_action_config()
    if type(entry_action) ~= "table" then
        return false
    end

    local mode = tostring(entry_action.mode or "")
    if mode == "key_sequence" then
        return M.maybe_handle_task_entry_key_sequence(ctx, current_time, player_x, player_y, player_z, entry_action, task_name)
    end
    if mode ~= "world_map_send" then
        return false
    end

    if type(state.task_target) == "table" then
        return false
    end

    local button_click_at = tonumber(state.last_task_button_click_at) or 0
    local armed_button_click_at = tonumber(state.task_entry_action_button_click_at) or 0
    if armed_button_click_at > 0 then
        if button_click_at > armed_button_click_at and (tonumber(state.task_entry_action_send_clicked_at) or 0) <= 0 then
            log_throttled(ctx, "task_entry_action_ignore_new_button_click", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task entry action keeps current session, ignore newer task button click | task=%s armed_at=%d newer_at=%d",
                tostring(task_name or state.current_task_name or ""),
                tonumber(armed_button_click_at) or 0,
                tonumber(button_click_at) or 0
            ))
        end
        button_click_at = armed_button_click_at
    end
    if button_click_at <= 0 then
        return false
    end

    local effective_time = tonumber(current_time) or now_ms(ctx)
    if button_click_at > effective_time then
        effective_time = button_click_at
    end

    local timeout_ms = math.max(5000, tonumber(entry_action.timeout_ms) or 12000)
    local base_map_open_wait_ms = math.max(200, tonumber(entry_action.map_open_wait_ms) or 900)
    local map_open_wait_jitter_ms = math.max(0, tonumber(entry_action.map_open_wait_jitter_ms) or 0)
    local map_open_wait_ms = math.max(
        200,
        tonumber(state.task_entry_action_map_open_wait_ms) or base_map_open_wait_ms
    )
    local center_retry_ms = math.max(400, tonumber(entry_action.center_retry_ms) or 1200)
    local center_settle_ms = math.max(150, tonumber(entry_action.center_settle_ms) or 450)
    local transition_wait_ms = math.max(TASK_BUTTON_SETTLE_MS, tonumber(entry_action.transition_wait_ms) or 1800)
    local action_elapsed_ms = effective_time - button_click_at

    if (tonumber(state.task_entry_action_send_clicked_at) or 0) > 0 then
        return false
    end

    if armed_button_click_at <= 0 then
        if map_open_wait_jitter_ms > 0 then
            map_open_wait_ms = base_map_open_wait_ms + math.random(0, math.floor(map_open_wait_jitter_ms))
        else
            map_open_wait_ms = base_map_open_wait_ms
        end
        state.task_entry_action_button_click_at = button_click_at
        state.task_entry_action_center_clicked_at = 0
        state.task_entry_action_map_open_wait_ms = map_open_wait_ms
        state.task_entry_action_next_center_click_at = button_click_at + map_open_wait_ms
        state.task_entry_action_pre_clicked_at = 0
        state.task_entry_action_send_clicked_at = 0
        state.task_entry_action_world_map_panel_missing_since = 0
        logger(ctx).info(string.format(
            "[Leveling] task entry action armed | task=%s mode=%s key=%s timeout=%dms map_wait=%dms jitter_max=%dms",
            tostring(task_name or state.current_task_name or ""),
            tostring(entry_action.mode or ""),
            tostring(entry_action.key or ""),
            tonumber(timeout_ms) or 0,
            tonumber(map_open_wait_ms) or 0,
            tonumber(map_open_wait_jitter_ms) or 0
        ))
    end

    if M.maybe_block_task_entry_for_skip_sequence(ctx, effective_time, "task_entry_action") then
        state.task_entry_action_button_click_at = effective_time
        state.task_entry_action_center_clicked_at = 0
        state.task_entry_action_next_center_click_at = effective_time + map_open_wait_ms
        state.task_entry_action_pre_clicked_at = 0
        state.task_entry_action_world_map_panel_missing_since = 0
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if action_elapsed_ms > timeout_ms then
        M.clear_task_entry_action_state()
        log_throttled(ctx, "task_entry_action_timeout", "warn", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry action timeout, fallback to normal task retry | task=%s mode=%s elapsed=%dms",
            tostring(task_name or state.current_task_name or ""),
            tostring(entry_action.mode or ""),
            tonumber(action_elapsed_ms) or 0
        ))
        return false
    end

    state.stage = "task_entry_action"
    release_async_combat_inputs(ctx, current_time, true)
    hold_navigation(ctx, current_time, "task_entry_action")
    state.task_path_wait_until = math.max(tonumber(state.task_path_wait_until) or 0, effective_time + 1000)
    state.next_task_button_click_at = math.max(tonumber(state.next_task_button_click_at) or 0, effective_time + 1000)

    if (tonumber(state.task_entry_action_send_clicked_at) or 0) > 0 then
        local send_elapsed_ms = effective_time - (tonumber(state.task_entry_action_send_clicked_at) or 0)
        if send_elapsed_ms < transition_wait_ms then
            log_throttled(ctx, "task_entry_action_wait_transition", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task entry action waiting transition after send | task=%s elapsed=%dms wait=%dms",
                tostring(task_name or state.current_task_name or ""),
                tonumber(send_elapsed_ms) or 0,
                tonumber(transition_wait_ms) or 0
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end
    end

    if action_elapsed_ms < map_open_wait_ms then
        log_throttled(ctx, "task_entry_action_wait_map", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry action waiting map panel | task=%s mode=%s elapsed=%dms wait=%dms",
                tostring(task_name or state.current_task_name or ""),
            tostring(entry_action.mode or ""),
            tonumber(action_elapsed_ms) or 0,
            tonumber(map_open_wait_ms) or 0
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if (tonumber(state.task_entry_action_center_clicked_at) or 0) <= 0
        and effective_time >= (tonumber(state.task_entry_action_next_center_click_at) or 0)
    then
        if entry_action.require_world_map_panel_ready ~= false then
            local map_ready, map_ready_reason = M.is_task_entry_world_map_panel_ready(ctx, effective_time, "task_entry_center")
            if map_ready ~= true then
                local missing_since = tonumber(state.task_entry_action_world_map_panel_missing_since) or 0
                if missing_since <= 0 then
                    missing_since = effective_time
                    state.task_entry_action_world_map_panel_missing_since = missing_since
                end
                local panel_missing_fallback_ms = tonumber(
                    entry_action.world_map_panel_missing_fallback_ms
                        or entry_action.map_panel_missing_fallback_ms
                ) or 0
                if panel_missing_fallback_ms > 0
                    and effective_time - missing_since >= panel_missing_fallback_ms
                then
                    local entry_key = tostring(entry_action.key or entry_action.mode or "")
                    state.task_entry_action_suppressed_key = entry_key
                    state.task_entry_action_suppressed_task_name =
                        normalize_map_name(M.current_task_log_name()) or normalize_map_name(state.current_task_name)
                    state.task_entry_action_suppressed_task_detail =
                        normalize_map_name(M.current_task_log_detail()) or normalize_map_name(state.current_task_detail)
                    state.task_entry_action_suppressed_reason = "world_map_panel_missing"
                    M.clear_task_entry_action_state()
                    if type(M.clear_task_recipe_state) == "function" then
                        M.clear_task_recipe_state()
                    end
                    state.require_task_button_refresh = true
                    state.require_task_button_refresh_reason = "task_entry_world_map_panel_missing:" .. entry_key
                    state.next_task_button_click_at = effective_time + 200
                    state.task_path_wait_until = 0
                    logger(ctx).warn(string.format(
                        "[Leveling] task entry action released after world map panel missing | task=%s detail=%s key=%s missing_ms=%d fallback_ms=%d reason=%s",
                        tostring(M.current_task_log_name() or state.current_task_name or ""),
                        tostring(M.current_task_log_detail() or state.current_task_detail or ""),
                        entry_key,
                        math.max(0, effective_time - missing_since),
                        panel_missing_fallback_ms,
                        tostring(map_ready_reason or "")
                    ))
                    return false
                end
                local retry_ms = math.max(100, tonumber(entry_action.world_map_panel_retry_ms or entry_action.center_ready_retry_ms) or 300)
                state.task_entry_action_next_center_click_at = effective_time + retry_ms
                log_throttled(ctx, "task_entry_action_wait_world_map_panel", "info", 600, string.format(
                    "[Leveling] task entry action waiting world map panel before fixed click | task=%s key=%s retry=%dms reason=%s",
                    tostring(task_name or state.current_task_name or ""),
                    tostring(entry_action.key or ""),
                    retry_ms,
                    tostring(map_ready_reason or "")
                ))
                log_heartbeat(ctx, current_time, player_x, player_y, player_z)
                return true
            end
            state.task_entry_action_world_map_panel_missing_since = 0
        end

        local center_selection_step = type(entry_action.center_selection_step) == "table"
            and entry_action.center_selection_step
            or nil
        local clicked_center = false
        local center_err = nil
        if type(center_selection_step) == "table" then
            local center_target, center_fetch_err, center_source, center_click_step =
                M.fetch_locator_button_target_with_configured_fallback(
                    ctx,
                    center_selection_step,
                    effective_time,
                    "task_entry_center_selection"
                )
            if type(center_target) == "table" then
                local center_clicked, center_click_err, center_retryable =
                    click_locator_button_target(ctx, center_click_step or center_selection_step, center_target)
                if center_clicked then
                    clicked_center = true
                    logger(ctx).info(string.format(
                        "[Leveling] task entry center selection clicked | task=%s label=%s source=%s addr=%s pos=(%s,%s)",
                        tostring(task_name or state.current_task_name or ""),
                        tostring(center_selection_step.label or ""),
                        tostring(center_source or ""),
                        tostring(center_target.addr or ""),
                        tostring(center_target.x or ""),
                        tostring(center_target.y or "")
                    ))
                else
                    center_err = center_click_err or (center_retryable and "retryable center selection click failed" or "center selection click failed")
                end
            else
                center_err = center_fetch_err or "center selection target unavailable"
            end
        else
            clicked_center, center_err = M.click_window_client_point(
                ctx,
                effective_time,
                tostring(entry_action.key or entry_action.mode or "task_entry_center"),
                tonumber(entry_action.center_click_ratio_x) or 0.5,
                tonumber(entry_action.center_click_ratio_y) or 0.5,
                entry_action
            )
        end
        if clicked_center then
            local center_clicked_at = now_ms(ctx)
            state.task_entry_action_center_clicked_at = center_clicked_at
            state.task_entry_action_next_center_click_at = center_clicked_at + center_retry_ms
        else
            state.task_entry_action_next_center_click_at = effective_time + center_retry_ms
            log_throttled(ctx, "task_entry_action_center_failed", "warn", LOG_THROTTLE_MS,
                "[Leveling] task entry center click failed: " .. tostring(center_err))
        end
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if (tonumber(state.task_entry_action_center_clicked_at) or 0) > 0
        and effective_time - (tonumber(state.task_entry_action_center_clicked_at) or 0) < center_settle_ms
    then
        log_throttled(ctx, "task_entry_action_center_settle", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry action waiting center settle | task=%s settle_left=%dms",
            tostring(task_name or state.current_task_name or ""),
            math.max(0, center_settle_ms - (effective_time - (tonumber(state.task_entry_action_center_clicked_at) or 0)))
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    local selection_step = type(entry_action.selection_step) == "table" and entry_action.selection_step or nil
    local selection_settle_ms = math.max(150, tonumber(entry_action.selection_settle_ms) or 600)
    if type(selection_step) == "table" and (tonumber(state.task_entry_action_pre_clicked_at) or 0) <= 0 then
        local selection_target, selection_fetch_err, selection_source, selection_click_step =
            M.fetch_locator_button_target_with_configured_fallback(
                ctx,
                selection_step,
                effective_time,
                "task_entry_selection"
            )
        if type(selection_target) ~= "table" then
            log_throttled(ctx, "task_entry_action_selection_missing", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task entry selection button not visible yet | task=%s label=%s err=%s",
                tostring(task_name or state.current_task_name or ""),
                tostring(selection_step.label or ""),
                tostring(selection_fetch_err or "")
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        local selection_clicked, selection_click_err, selection_retryable =
            click_locator_button_target(ctx, selection_click_step or selection_step, selection_target)
        if not selection_clicked then
            log_throttled(ctx,
                selection_retryable and "task_entry_action_selection_retry" or "task_entry_action_selection_failed",
                selection_retryable and "info" or "warn",
                LOG_THROTTLE_MS,
                "[Leveling] task entry selection click failed: " .. tostring(selection_click_err))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        state.task_entry_action_pre_clicked_at = effective_time
        logger(ctx).info(string.format(
            "[Leveling] task entry selection clicked | task=%s label=%s source=%s addr=%s pos=(%s,%s)",
            tostring(task_name or state.current_task_name or ""),
            tostring(selection_step.label or ""),
            tostring(selection_source or ""),
            tostring(selection_target.addr or ""),
            tostring(selection_target.x or ""),
            tostring(selection_target.y or "")
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if (tonumber(state.task_entry_action_pre_clicked_at) or 0) > 0
        and effective_time - (tonumber(state.task_entry_action_pre_clicked_at) or 0) < selection_settle_ms
    then
        log_throttled(ctx, "task_entry_action_selection_settle", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task entry action waiting selection settle | task=%s settle_left=%dms",
            tostring(task_name or state.current_task_name or ""),
            math.max(0, selection_settle_ms - (effective_time - (tonumber(state.task_entry_action_pre_clicked_at) or 0)))
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    local step = type(entry_action.step) == "table" and entry_action.step or nil
    step = M.apply_task_entry_send_step_defaults(step)
    if type(step) ~= "table" then
        log_throttled(ctx, "task_entry_action_step_missing", "warn", LOG_THROTTLE_MS,
            "[Leveling] task entry action step is unavailable.")
        return false
    end

    local send_wait_err = "task entry send button target unavailable."
    local slot_clicked, slot_meta_or_err, slot_retryable, slot_failure_phase = M.call_button_slot(ctx, effective_time, "task_entry_send", step, {
        reason = "task_entry_world_map_send"
    })
    if slot_clicked == true then
        local slot_meta = type(slot_meta_or_err) == "table" and slot_meta_or_err or {}
        local clicked_target = type(slot_meta.target) == "table" and slot_meta.target or nil
        local click_source = tostring(slot_meta.source or "")
        local after_click_time = math.max(effective_time, tonumber(slot_meta.clicked_at) or now_ms(ctx))
        state.task_entry_action_send_clicked_at = after_click_time
        logger(ctx).info(string.format(
            "[Leveling] task entry send clicked | task=%s label=%s addr=%s pos=(%s,%s) source=%s",
            tostring(task_name or state.current_task_name or ""),
            tostring(step.label or ""),
            tostring(clicked_target and clicked_target.addr or ""),
            tostring(clicked_target and clicked_target.x or ""),
            tostring(clicked_target and clicked_target.y or ""),
            tostring(click_source or "")
        ))
        schedule_task_refresh_after_transition(ctx, after_click_time, "task_entry_world_map_send", transition_wait_ms, {
            force_task_call = true,
            task_pos_reject_extra_ms = 3500
        })
        local locked_entry_key = tostring(state.task_entry_action_locked_key or entry_action.key or "")
        M.clear_task_entry_action_state()
        logger(ctx).info(string.format(
            "[Leveling] task entry action completed, cleared lock | task=%s key=%s reason=send_clicked",
            tostring(task_name or state.current_task_name or ""),
            tostring(locked_entry_key)
        ))
        log_heartbeat(ctx, after_click_time, player_x, player_y, player_z)
        return true
    end
    send_wait_err = tostring(slot_meta_or_err or send_wait_err)
    if tostring(slot_failure_phase or "") == "click_failed" then
        log_throttled(ctx,
            slot_retryable == false and "task_entry_action_send_failed" or "task_entry_action_send_retry",
            slot_retryable == false and "warn" or "info",
            LOG_THROTTLE_MS,
            "[Leveling] task entry send click failed via button slot: " .. send_wait_err)
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if current_time >= (tonumber(state.task_entry_action_next_center_click_at) or 0) then
        state.task_entry_action_center_clicked_at = 0
    end
    log_throttled(ctx, "task_entry_action_button_missing", "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] task entry send button not visible yet | task=%s label=%s err=%s",
        tostring(task_name or state.current_task_name or ""),
        tostring(step.label or ""),
        tostring(send_wait_err or "")
    ))
    log_heartbeat(ctx, current_time, player_x, player_y, player_z)
    return true
end

local function try_click_revive_checkpoint(ctx, current_time)
    local revive_steps = {
        REVIVE_REENTER_STEP,
        REVIVE_AT_CHECKPOINT_STEP
    }
    local last_err = nil

    for _, step in ipairs(revive_steps) do
        local target, fetch_err = fetch_locator_button_target(ctx, step)
        if target then
            local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
            if clicked then
                state.revive_clicked_at = current_time
                state.revive_click_count = (tonumber(state.revive_click_count) or 0) + 1
                state.next_revive_click_at = current_time + REVIVE_CLICK_RETRY_INTERVAL_MS
                logger(ctx).info(string.format(
                    "[Leveling] revive button clicked | label=%s addr=%s pos=(%s,%s) clicks=%d",
                    tostring(step.label or ""),
                    tostring(type(target) == "table" and target.addr or ""),
                    tostring(type(target) == "table" and target.x or ""),
                    tostring(type(target) == "table" and target.y or ""),
                    tonumber(state.revive_click_count) or 0
                ))
                return true
            end

            last_err = click_err or fetch_err
            if retryable == false then
                break
            end
        else
            last_err = fetch_err or last_err
        end
    end

    state.next_revive_click_at = current_time + REVIVE_CLICK_RETRY_INTERVAL_MS
    log_throttled(ctx, "revive_fetch_failed", "warn", LOG_THROTTLE_MS,
        "[Leveling] revive button fetch failed: " .. tostring(last_err))
    return false, last_err
end

local function find_interaction_prompt_button(ctx, current_time)
    current_time = tonumber(current_time) or now_ms(ctx)
    local prompt_step = M.apply_interaction_prompt_step_defaults(INTERACTION_PROMPT_STEP)
    if current_time < (tonumber(state.next_interaction_prompt_scan_at) or 0) then
        local cached_at = tonumber(state.cached_interaction_prompt_target_at) or 0
        local max_cached_age = INTERACTION_PROMPT_SCAN_INTERVAL_MS + 250
        if type(state.cached_interaction_prompt_target) == "table"
            and cached_at > 0
            and current_time - cached_at <= max_cached_age
        then
            return state.cached_interaction_prompt_target, state.cached_interaction_prompt_error
        end
        return nil, state.cached_interaction_prompt_error
            or "interaction prompt scan cooldown; cached target requires live guard."
    end

    state.next_interaction_prompt_scan_at = current_time + INTERACTION_PROMPT_SCAN_INTERVAL_MS
    local nav_mod = nav_api(ctx)

    local target, fetch_err = fetch_locator_button_target(ctx, prompt_step)
    if target then
        M.cache_interaction_prompt_button_target(ctx, target, current_time, "locator_fetch", prompt_step)
        state.cached_interaction_prompt_target = target
        state.cached_interaction_prompt_target_at = tonumber(current_time) or 0
        state.cached_interaction_prompt_error = nil
        return target, nil
    end

    if type(nav_mod) == "table" then
        local captured_target, capture_err = M.try_capture_interaction_prompt_button_via_hover(
            ctx,
            nav_mod,
            current_time,
            prompt_step,
            "find_interaction_prompt_button"
        )
        if type(captured_target) == "table" then
            state.cached_interaction_prompt_target = captured_target
            state.cached_interaction_prompt_target_at = tonumber(current_time) or 0
            state.cached_interaction_prompt_error = nil
            return captured_target, nil
        end
        if trim(capture_err or "") ~= "" then
            fetch_err = (trim(fetch_err or "") ~= "")
                and (tostring(fetch_err) .. " | hover_capture=" .. tostring(capture_err))
                or capture_err
        end
    end

    state.cached_interaction_prompt_target = nil
    state.cached_interaction_prompt_target_at = 0
    state.cached_interaction_prompt_error = fetch_err or "interaction prompt not found."
    return nil, state.cached_interaction_prompt_error
end

local function find_exit_portal_button(ctx, current_time)
    current_time = tonumber(current_time) or now_ms(ctx)
    if current_time < (tonumber(state.next_exit_portal_scan_at) or 0) then
        return state.cached_exit_portal_target, state.cached_exit_portal_error
    end

    state.next_exit_portal_scan_at = current_time + EXIT_PORTAL_SCAN_INTERVAL_MS

    local target, fetch_err = fetch_locator_button_target(ctx, EXIT_PORTAL_STEP)
    if target then
        state.cached_exit_portal_target = target
        state.cached_exit_portal_error = nil
        return target, nil
    end

    state.cached_exit_portal_target = nil
    state.cached_exit_portal_error = fetch_err or "exit portal button not found."
    return nil, state.cached_exit_portal_error
end

function M.find_task_objective_button(ctx, current_time, objective_cfg)
    current_time = tonumber(current_time) or now_ms(ctx)
    local objective_key = tostring(type(objective_cfg) == "table" and objective_cfg.key or "")
    if current_time < (tonumber(state.next_task_objective_button_scan_at) or 0)
        and tostring(state.cached_task_objective_button_key or "") == objective_key
    then
        return state.cached_task_objective_button, state.cached_task_objective_button_error
    end

    state.next_task_objective_button_scan_at = current_time + 250
    state.cached_task_objective_button_key = objective_key

    local steps = {}
    local has_objective_steps = false
    local explicit_objective_steps = setmetatable({}, { __mode = "k" })
    if type(objective_cfg) == "table" then
        if type(objective_cfg.button_step) == "table" then
            steps[#steps + 1] = objective_cfg.button_step
            explicit_objective_steps[objective_cfg.button_step] = true
            has_objective_steps = true
        end
        if type(objective_cfg.button_steps) == "table" then
            for _, step in ipairs(objective_cfg.button_steps) do
                if type(step) == "table" then
                    steps[#steps + 1] = step
                    explicit_objective_steps[step] = true
                    has_objective_steps = true
                end
            end
        end
    end
    if not has_objective_steps
        or (type(objective_cfg) == "table" and objective_cfg.include_global_button_steps == true)
    then
        for _, step in ipairs(M.TASK_OBJECTIVE_BUTTON_STEPS or {}) do
            if type(step) == "table" then
                steps[#steps + 1] = step
            end
        end
    end

    log_throttled(ctx, "task_objective_button_scan_" .. objective_key, "info", 1000, string.format(
        "[Leveling] task objective button scan | objective=%s steps=%d explicit=%s include_global=%s",
        objective_key,
        #steps,
        tostring(has_objective_steps == true),
        tostring(type(objective_cfg) == "table" and objective_cfg.include_global_button_steps == true)
    ))

    local function is_jump_step(step)
        if type(step) ~= "table" then
            return false
        end
        if tostring(step.key or "") == "jump_btn" then
            return true
        end
        local identity = tostring(step.distance_button_name or ""):lower()
        return identity:find("dialoguetalk_c.widgettree.jumpbtn", 1, true) ~= nil
    end

    local function is_function_prompt_step(step)
        if type(step) ~= "table" then
            return false
        end
        if tostring(step.key or "") == "function_btn" then
            return true
        end
        local identity = tostring(step.distance_button_name or ""):lower()
        return identity:find("fightinteractiveview_c.widgettree.functionbtn", 1, true) ~= nil
    end

    for _, step in ipairs(steps) do
        local allow_function_btn_as_objective = type(objective_cfg) == "table"
            and (
                explicit_objective_steps[step] == true
                or objective_cfg.allow_function_button_as_objective == true
            )
        if is_function_prompt_step(step) and not allow_function_btn_as_objective then
            log_throttled(ctx, "task_objective_function_btn_skipped", "info", LOG_THROTTLE_MS,
                "[Leveling] generic task objective FunctionBtn skipped; use interaction_prompt dialogue flow.")
        elseif not is_jump_step(step) then
            local target, fetch_err = fetch_locator_button_target(ctx, step)
            if target then
                local target_identity = (
                    tostring(target.fullname or "")
                    .. " "
                    .. tostring(target.name or "")
                ):lower()
                if target_identity:find("dialoguetalk_c.widgettree.jumpbtn", 1, true) == nil then
                    log_throttled(
                        ctx,
                        "task_objective_button_resolved_" .. objective_key .. "_" .. tostring(step.key or step.label or ""),
                        "info",
                        1000,
                        string.format(
                            "[Leveling] task objective button target resolved | objective=%s step=%s label=%s explicit=%s target=%s",
                            objective_key,
                            tostring(step.key or ""),
                            tostring(step.label or ""),
                            tostring(explicit_objective_steps[step] == true),
                            M.format_main_task_click_target_brief(target)
                        )
                    )
                    local result = {
                        step = step,
                        target = target,
                        arm_task_entry_action_after_click = (
                            (type(objective_cfg) == "table" and objective_cfg.arm_task_entry_action_after_click == true)
                            or (type(step) == "table" and step.arm_task_entry_action_after_click == true)
                        ),
                        force_task_call_after_transition = type(objective_cfg) == "table"
                            and objective_cfg.force_task_call_after_transition == true,
                        task_pos_reject_extra_ms = type(objective_cfg) == "table"
                            and objective_cfg.task_pos_reject_extra_ms
                            or nil
                    }
                    state.cached_task_objective_button = result
                    state.cached_task_objective_button_error = nil
                    return result, nil
                end
                log_throttled(
                    ctx,
                    "task_objective_button_reject_jump_" .. objective_key .. "_" .. tostring(step.key or step.label or ""),
                    "warn",
                    LOG_THROTTLE_MS,
                    string.format(
                        "[Leveling] task objective button target rejected as JumpBtn | objective=%s step=%s label=%s target=%s",
                        objective_key,
                        tostring(step.key or ""),
                        tostring(step.label or ""),
                        M.format_main_task_click_target_brief(target)
                    )
                )
            elseif explicit_objective_steps[step] == true then
                log_throttled(
                    ctx,
                    "task_objective_button_miss_" .. objective_key .. "_" .. tostring(step.key or step.label or ""),
                    "info",
                    800,
                    string.format(
                        "[Leveling] task objective button target miss | objective=%s step=%s label=%s hover=%s hint=(%s,%s) err=%s",
                        objective_key,
                        tostring(step.key or ""),
                        tostring(step.label or ""),
                        tostring(step.hover_capture_enabled == true),
                        tostring(step.hint_client_x or ""),
                        tostring(step.hint_client_y or ""),
                        tostring(fetch_err or "")
                    )
                )
            end
            state.cached_task_objective_button_error = fetch_err or state.cached_task_objective_button_error
        end
    end

    state.cached_task_objective_button = nil
    state.cached_task_objective_button_error = state.cached_task_objective_button_error or "task objective button not found."
    log_throttled(ctx, "task_objective_button_exhausted_" .. objective_key, "info", 1000, string.format(
        "[Leveling] task objective button scan exhausted | objective=%s steps=%d err=%s",
        objective_key,
        #steps,
        tostring(state.cached_task_objective_button_error or "")
    ))
    return nil, state.cached_task_objective_button_error
end

function M.try_click_task_objective_button(ctx, current_time, objective_button, goal_distance, target_source)
    local step = type(objective_button) == "table" and objective_button.step or nil
    local target = type(objective_button) == "table" and objective_button.target or nil
    if type(step) ~= "table" or type(target) ~= "table" then
        return false, "task objective button target is unavailable."
    end

    if current_time < (tonumber(state.next_task_objective_button_click_at) or 0) then
        return false, "task objective button click cooldown."
    end

    local target_identity = (
        tostring(target.fullname or "")
        .. " "
        .. tostring(target.name or "")
    ):lower()
    if tostring(step.key or "") == "jump_btn"
        or target_identity:find("dialoguetalk_c.widgettree.jumpbtn", 1, true) ~= nil
    then
        return false, "task objective button target is dialogue jump button."
    end

    release_async_combat_inputs(ctx, current_time, true)
    local clicked, click_err, retryable = click_locator_button_target(ctx, step, target)
    if not clicked then
        log_throttled(ctx, retryable and "task_objective_button_click_retry" or "task_objective_button_click_failed",
            retryable and "info" or "warn", LOG_THROTTLE_MS,
            "[Leveling] task objective button click failed: " .. tostring(click_err))
        state.next_task_objective_button_click_at = current_time + 600
        return false, click_err
    end

    local after_click_time = now_ms(ctx)
    state.next_task_objective_button_click_at = after_click_time + 1200
    local direct_post_flow, direct_post_task_name = M.current_task_post_dialogue_flow_config()
    if type(direct_post_flow) == "table"
        and direct_post_flow.arm_after_objective_button == true
        and M.arm_post_dialogue_flow(ctx, after_click_time, direct_post_flow, direct_post_task_name, "task_objective_button") == true
    then
        clear_pending_interaction()
        state.require_task_button_refresh = false
        state.require_task_button_refresh_reason = nil
        state.task_update_wait_until = math.max(
            tonumber(state.task_update_wait_until) or 0,
            after_click_time + math.max(tonumber(direct_post_flow.initial_delay_ms) or 500, 300)
        )
        state.next_task_button_click_at = math.max(
            tonumber(state.next_task_button_click_at) or 0,
            state.task_update_wait_until
        )
        state.next_task_refresh_at = math.max(
            tonumber(state.next_task_refresh_at) or 0,
            state.task_update_wait_until
        )
        logger(ctx).info(string.format(
            "[Leveling] task objective button opened NPC dialogue; direct post flow armed | task=%s key=%s label=%s",
            tostring(direct_post_task_name or state.current_task_name or ""),
            tostring(direct_post_flow.key or ""),
            tostring(step.label or "")
        ))
        return true
    end

    if type(objective_button) == "table" and objective_button.arm_task_entry_action_after_click == true then
        local armed_entry_action, arm_err = M.arm_task_entry_action_after_task_objective(
            ctx,
            after_click_time,
            objective_button
        )
        if armed_entry_action == true then
            local entry_action = select(1, M.current_task_entry_action_config())
            logger(ctx).info(string.format(
                "[Leveling] task objective button armed task entry action | label=%s entry_key=%s",
                tostring(step.label or ""),
                tostring(type(entry_action) == "table" and entry_action.key or "")
            ))
            return true
        end
        log_throttled(
            ctx,
            "task_objective_button_arm_task_entry_action_failed_" .. tostring(step.key or step.label or ""),
            "warn",
            LOG_THROTTLE_MS,
            "[Leveling] task objective button could not arm task entry action: " .. tostring(arm_err)
        )
    end

    local refresh_opts = nil
    if step.force_task_call_after_transition == true
        or objective_button.force_task_call_after_transition == true
    then
        refresh_opts = {
            force_task_call = true,
            task_pos_reject_extra_ms = tonumber(step.task_pos_reject_extra_ms)
                or tonumber(objective_button.task_pos_reject_extra_ms)
                or 2500
        }
    end
    schedule_task_refresh_after_transition(
        ctx,
        current_time,
        "task_objective_button_" .. tostring(step.key or step.label or ""),
        tonumber(step.settle_ms) or POST_DIALOGUE_SETTLE_MS,
        refresh_opts
    )
    logger(ctx).info(string.format(
        "[Leveling] task objective button clicked | label=%s goal_distance=%.2f target_source=%s pos=%.2f, %.2f",
        tostring(step.label or ""),
        tonumber(goal_distance) or 0,
        tostring(target_source or ""),
        tonumber(target.x) or 0,
        tonumber(target.y) or 0
    ))
    return true
end

function M.maybe_handle_task_objective_button(ctx, current_time, goal_distance, target_source, objective_cfg, player_x, player_y)
    local objective_mode = tostring(type(objective_cfg) == "table" and objective_cfg.mode or "")
    local boss_kite_active = state.task_combat_force_kite == true
        or tostring(state.stage or "") == "task_combat_kite"
    local allow_boss_kite_objective_button = type(objective_cfg) == "table"
        and (
            objective_cfg.allow_boss_kite_objective_button == true
            or objective_cfg.allow_boss_combat_followup == true
        )
    if boss_kite_active
        and (objective_mode == "boss_kite" or state.task_combat_force_kite == true)
        and allow_boss_kite_objective_button ~= true
    then
        log_throttled(ctx, "task_objective_button_suppressed_boss_kite", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task objective button scan suppressed during boss kite | objective=%s stage=%s goal_distance=%s",
            tostring(type(objective_cfg) == "table" and objective_cfg.key or ""),
            tostring(state.stage or ""),
            type(goal_distance) == "number" and string.format("%.2f", goal_distance) or "nil"
        ))
        return false
    end

    local objective_button = M.find_task_objective_button(ctx, current_time, objective_cfg)
    if not objective_button then
        return false
    end
    if M.maybe_guard_interaction_with_combat(ctx, current_time, player_x, player_y, "task_objective_button") then
        return true
    end

    state.stage = "task_objective_button"
    M.stabilize_navigation_for_interaction(ctx, current_time, "task_objective_button", player_x, player_y)
    return M.try_click_task_objective_button(
        ctx,
        current_time,
        objective_button,
        goal_distance,
        target_source
    )
end

function M.maybe_handle_task_reached_prompt_or_portal(ctx, current_time, goal_distance, target_source, player_x, player_y)
    local interaction_prompt = find_interaction_prompt_button(ctx, current_time)
    if interaction_prompt then
        if M.maybe_guard_interaction_with_combat(ctx, current_time, player_x, player_y, "interaction_prompt") then
            return true
        end
        state.stage = "interaction_prompt"
        M.stabilize_navigation_for_interaction(ctx, current_time, "interaction_prompt", player_x, player_y)
        M.interact_with_prompt(
            ctx,
            current_time,
            interaction_prompt,
            goal_distance,
            target_source
        )
        return true
    end

    local exit_portal_target = find_exit_portal_button(ctx, current_time)
    if exit_portal_target then
        if M.maybe_guard_interaction_with_combat(ctx, current_time, player_x, player_y, "exit_portal") then
            return true
        end
        state.stage = "exit_portal"
        M.stabilize_navigation_for_interaction(ctx, current_time, "exit_portal", player_x, player_y)
        if try_click_exit_portal(
            ctx,
            current_time,
            exit_portal_target,
            goal_distance,
            target_source
        ) then
            return true
        end
    end

    return false
end

function M.normalize_kite_template_points(points, fallback_z)
    if type(points) ~= "table" then
        return nil
    end

    local normalized = {}
    for _, point in ipairs(points) do
        local point_x = tonumber(type(point) == "table" and point.x)
        local point_y = tonumber(type(point) == "table" and point.y)
        if point_x ~= nil and point_y ~= nil then
            normalized[#normalized + 1] = {
                x = point_x,
                y = point_y,
                z = tonumber(type(point) == "table" and point.z) or tonumber(fallback_z)
            }
        end
    end

    if #normalized < 3 then
        return nil
    end
    return normalized
end

function M.apply_task_combat_kite_runtime_options(objective_cfg, point_objective_cfg)
    local point_cfg = type(point_objective_cfg) == "table" and point_objective_cfg or nil
    local task_cfg = type(objective_cfg) == "table" and objective_cfg or nil
    local seamless = (point_cfg and point_cfg.seamless_kite == true) or (task_cfg and task_cfg.seamless_kite == true)
    local async_override = nil
    if point_cfg and point_cfg.async_route_worker ~= nil then
        async_override = point_cfg.async_route_worker
    elseif task_cfg and task_cfg.async_route_worker ~= nil then
        async_override = task_cfg.async_route_worker
    end
    local has_configured_kite_points = type(point_cfg and point_cfg.kite_points) == "table"
        or type(task_cfg and task_cfg.kite_points) == "table"
    local endpoint_kite = (
        point_cfg
        and (
            point_cfg.immediate_kite_on_reached == true
            or (
                tostring(point_cfg.mode or "") == "boss_kite"
                and point_cfg.immediate_kite_on_reached ~= false
            )
        )
    ) or (
        task_cfg
        and (
            task_cfg.immediate_kite_on_reached == true
            or (
                tostring(task_cfg.mode or "") == "boss_kite"
                and task_cfg.immediate_kite_on_reached ~= false
            )
        )
    )

    state.task_combat_kite_seamless = seamless == true
    state.task_combat_kite_switch_ms = tonumber(point_cfg and point_cfg.kite_switch_ms)
        or tonumber(task_cfg and task_cfg.kite_switch_ms)
        or tonumber(state.task_combat_kite_switch_ms)
    local generated_point_count = tonumber(point_cfg and (point_cfg.kite_point_count or point_cfg.generated_kite_points))
        or tonumber(task_cfg and (task_cfg.kite_point_count or task_cfg.generated_kite_points))
        or nil
    if generated_point_count == nil and endpoint_kite == true and not has_configured_kite_points then
        generated_point_count = 3
    end
    state.task_combat_kite_point_count = generated_point_count
    state.task_combat_kite_async_worker = M.TASK_COMBAT_KITE_ASYNC_ROUTE_WORKER == true
        and async_override ~= false
        and (
            async_override == true
            or seamless == true
            or has_configured_kite_points == true
            or endpoint_kite == true
        )
    state.task_combat_kite_arrive_distance = tonumber(point_cfg and (point_cfg.kite_arrive_distance or point_cfg.kite_point_arrive_distance))
        or tonumber(task_cfg and (task_cfg.kite_arrive_distance or task_cfg.kite_point_arrive_distance))
    state.task_combat_kite_move_interval_ms = tonumber(point_cfg and point_cfg.kite_move_interval_ms)
        or tonumber(task_cfg and task_cfg.kite_move_interval_ms)

    if seamless then
        state.task_combat_kite_arrive_distance = tonumber(state.task_combat_kite_arrive_distance) or 520
        state.task_combat_kite_move_interval_ms = tonumber(state.task_combat_kite_move_interval_ms) or 180
    end
end

function M.resolve_task_combat_kite_anchor(point_objective_cfg, destination, target, player_x, player_y, player_z)
    local anchor = nil
    if type(point_objective_cfg) == "table"
        and tonumber(point_objective_cfg.x) ~= nil
        and tonumber(point_objective_cfg.y) ~= nil
    then
        anchor = point_objective_cfg
    elseif is_valid_world_point(destination) then
        anchor = destination
    elseif is_valid_world_point(target) then
        anchor = target
    end

    local anchor_x = tonumber(anchor and anchor.x) or tonumber(player_x)
    local anchor_y = tonumber(anchor and anchor.y) or tonumber(player_y)
    if anchor_x == nil or anchor_y == nil then
        return nil
    end
    return {
        x = anchor_x,
        y = anchor_y,
        z = tonumber(anchor and anchor.z) or tonumber(player_z)
    }
end

function M.prepare_task_combat_kite_runtime(objective_cfg, point_objective_cfg, destination, target, player_x, player_y, player_z)
    local anchor = M.resolve_task_combat_kite_anchor(point_objective_cfg, destination, target, player_x, player_y, player_z)
    if type(anchor) ~= "table" then
        return nil
    end

    state.task_combat_anchor_x = anchor.x
    state.task_combat_anchor_y = anchor.y
    state.task_combat_anchor_z = anchor.z
    state.task_combat_kite_radius = tonumber(type(point_objective_cfg) == "table" and point_objective_cfg.kite_radius)
        or tonumber(objective_cfg.kite_radius)
        or tonumber(state.task_combat_kite_radius)
    state.task_combat_kite_template_points = M.normalize_kite_template_points(
        type(point_objective_cfg) == "table" and point_objective_cfg.kite_points or objective_cfg.kite_points,
        state.task_combat_anchor_z
    )
    state.task_combat_kite_switch_ms = tonumber(type(point_objective_cfg) == "table" and point_objective_cfg.kite_switch_ms)
        or tonumber(objective_cfg.kite_switch_ms)
    M.apply_task_combat_kite_runtime_options(objective_cfg, point_objective_cfg)
    return anchor
end

function M.task_combat_kite_route_key(task_name, objective_cfg, point_objective_cfg)
    return table.concat({
        tostring(task_name or state.current_task_name or ""),
        tostring(type(objective_cfg) == "table" and objective_cfg.key or ""),
        tostring(type(point_objective_cfg) == "table" and (point_objective_cfg.key or point_objective_cfg.name) or ""),
        tostring(tonumber(state.task_combat_kite_radius) or ""),
        tostring(tonumber(state.task_combat_kite_point_count) or ""),
        tostring(tonumber(state.task_combat_kite_switch_ms) or "")
    }, "|")
end

function M.task_combat_kite_route_matches(route_key, anchor)
    if tostring(state.task_combat_kite_prearm_key or "") ~= tostring(route_key or "") then
        return false
    end
    local route_points = state.task_combat_kite_points
    if type(route_points) ~= "table" or #route_points < 3 then
        return false
    end
    local route_anchor_x = tonumber(state.task_combat_kite_anchor_route_x)
    local route_anchor_y = tonumber(state.task_combat_kite_anchor_route_y)
    if type(anchor) ~= "table" or route_anchor_x == nil or route_anchor_y == nil then
        return false
    end
    if distance_2d(route_anchor_x, route_anchor_y, anchor.x, anchor.y) > 160 then
        return false
    end
    local route_anchor_z = tonumber(state.task_combat_kite_anchor_route_z)
    local anchor_z = tonumber(anchor.z)
    if route_anchor_z ~= nil and anchor_z ~= nil and math.abs(route_anchor_z - anchor_z) > 260 then
        return false
    end
    return true
end

function M.select_nearest_task_combat_kite_point(player_x, player_y, current_time)
    local route_points = state.task_combat_kite_points
    if type(route_points) ~= "table" or tonumber(player_x) == nil or tonumber(player_y) == nil then
        return false
    end
    local nearest_index = 1
    local nearest_distance = math.huge
    for index, point in ipairs(route_points) do
        local point_x = tonumber(type(point) == "table" and point.x)
        local point_y = tonumber(type(point) == "table" and point.y)
        if point_x ~= nil and point_y ~= nil then
            local point_distance = distance_2d(player_x, player_y, point_x, point_y)
            if point_distance < nearest_distance then
                nearest_distance = point_distance
                nearest_index = index
            end
        end
    end
    state.task_combat_kite_index = nearest_index
    state.task_combat_next_kite_switch_at = (tonumber(current_time) or 0)
        + math.max(800, tonumber(state.task_combat_kite_switch_ms) or 2800)
    return true
end

function M.task_combat_kite_start_distance(objective_ready_distance, objective_cfg, point_objective_cfg)
    local point_cfg = type(point_objective_cfg) == "table" and point_objective_cfg or nil
    local task_cfg = type(objective_cfg) == "table" and objective_cfg or nil
    return math.max(
        tonumber(objective_ready_distance) or TARGET_REACHED_DISTANCE,
        tonumber(point_cfg and (point_cfg.kite_start_distance or point_cfg.immediate_kite_start_distance)) or 0,
        tonumber(task_cfg and (task_cfg.kite_start_distance or task_cfg.immediate_kite_start_distance)) or 0,
        tonumber(point_cfg and point_cfg.trigger_distance) or 0,
        tonumber(task_cfg and task_cfg.trigger_distance) or 0,
        640
    )
end

function M.task_combat_kite_prearm_distance(start_distance, objective_cfg, point_objective_cfg)
    local point_cfg = type(point_objective_cfg) == "table" and point_objective_cfg or nil
    local task_cfg = type(objective_cfg) == "table" and objective_cfg or nil
    local start = tonumber(start_distance) or 640
    local lead = tonumber(point_cfg and point_cfg.kite_prearm_lead_distance)
        or tonumber(task_cfg and task_cfg.kite_prearm_lead_distance)
        or 1400
    return math.max(
        start,
        tonumber(point_cfg and point_cfg.kite_prearm_distance) or 0,
        tonumber(task_cfg and task_cfg.kite_prearm_distance) or 0,
        start + lead
    )
end

function M.prime_immediate_task_boss_kite(ctx, current_time, task_name, objective_cfg, point_objective_cfg, destination, target, player_x, player_y, player_z, reason)
    if type(objective_cfg) ~= "table" or tostring(objective_cfg.mode or "") ~= "boss_kite" then
        return false
    end
    local anchor = M.prepare_task_combat_kite_runtime(objective_cfg, point_objective_cfg, destination, target, player_x, player_y, player_z)
    if type(anchor) ~= "table" then
        return false
    end
    local route_key = M.task_combat_kite_route_key(task_name, objective_cfg, point_objective_cfg)
    if M.task_combat_kite_route_matches(route_key, anchor) then
        return true
    end

    state.task_combat_kite_points = nil
    state.task_combat_kite_index = 0
    state.task_combat_next_kite_switch_at = 0
    state.task_combat_kite_force_move = true
    local kite_target = M.build_task_combat_kite_target(current_time, player_x, player_y, destination or target)
    if type(kite_target) ~= "table" then
        return false
    end
    state.task_combat_kite_prearm_key = route_key
    state.task_combat_kite_prearm_anchor_x = anchor.x
    state.task_combat_kite_prearm_anchor_y = anchor.y
    state.task_combat_kite_prearm_anchor_z = anchor.z
    log_throttled(ctx, "task_boss_kite_prearm_" .. route_key, "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] immediate boss kite route prearmed | task=%s objective=%s reason=%s center=%.2f, %.2f, %.2f points=%d first_target_distance=%s",
        tostring(task_name or state.current_task_name or ""),
        tostring(objective_cfg.key or ""),
        tostring(reason or ""),
        tonumber(anchor.x) or 0,
        tonumber(anchor.y) or 0,
        tonumber(anchor.z) or 0,
        type(state.task_combat_kite_points) == "table" and #state.task_combat_kite_points or 0,
        tostring(kite_target.current_distance or "")
    ))
    return true
end

function M.arm_immediate_task_boss_kite(ctx, current_time, task_name, objective_cfg, point_objective_cfg, destination, target, player_x, player_y, player_z, reason)
    if type(objective_cfg) ~= "table" or tostring(objective_cfg.mode or "") ~= "boss_kite" then
        return false
    end

    state.task_reached_unresolved_since = 0
    state.task_combat_force_kite = true
    if (tonumber(state.task_combat_started_at) or 0) <= 0 then
        state.task_combat_started_at = current_time
    end
    M.lock_boss_combat_context(task_name, objective_cfg, point_objective_cfg)

    local anchor = M.prepare_task_combat_kite_runtime(objective_cfg, point_objective_cfg, destination, target, player_x, player_y, player_z)
    if type(anchor) ~= "table" then
        return false
    end
    local route_key = M.task_combat_kite_route_key(task_name, objective_cfg, point_objective_cfg)
    local route_prearmed = M.task_combat_kite_route_matches(route_key, anchor)
    if route_prearmed then
        M.select_nearest_task_combat_kite_point(player_x, player_y, current_time)
    else
        state.task_combat_kite_points = nil
        state.task_combat_kite_index = 0
        state.task_combat_next_kite_switch_at = 0
    end
    state.task_combat_kite_force_move = true

    local kite_target = M.build_task_combat_kite_target(current_time, player_x, player_y, destination or target)
    state.task_combat_kite_prearm_key = route_key
    state.task_combat_kite_prearm_anchor_x = anchor.x
    state.task_combat_kite_prearm_anchor_y = anchor.y
    state.task_combat_kite_prearm_anchor_z = anchor.z
    state.stage = "task_combat_kite"
    if type(kite_target) == "table" then
        M.issue_task_combat_kite_move(ctx, current_time, kite_target)
    end
    M.run_task_combat_pulse(ctx, current_time, "immediate_boss_kite", {
        mode = "task_combat_kite"
    })
    log_throttled(ctx, "task_immediate_boss_kite", "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] immediate boss kite armed at objective | task=%s objective=%s reason=%s prearmed=%s kite_target=%s route_index=%s/%s",
        tostring(task_name or state.current_task_name or ""),
        tostring(objective_cfg.key or ""),
        tostring(reason or ""),
        route_prearmed and "true" or "false",
        type(kite_target) == "table" and string.format("%.2f, %.2f", tonumber(kite_target.x) or 0, tonumber(kite_target.y) or 0) or "nil",
        type(kite_target) == "table" and tostring(kite_target.path_index or "") or "",
        type(kite_target) == "table" and tostring(kite_target.path_points or "") or ""
    ))
    return true
end

function M.maybe_handle_task_reached(
    ctx,
    current_time,
    player_x,
    player_y,
    player_z,
    hp_ratio,
    target,
    destination,
    destination_distance,
    goal_distance
)
    state.stage = "task_reached"
    state.next_task_refresh_at = math.min(
        tonumber(state.next_task_refresh_at) or current_time,
        current_time + 300
    )

    local target_source = tostring(destination and destination.source or target.source or "")
    local map_cfg, map_name = current_map_task_config()
    local task_cfg, task_name, task_cfg_source = M.current_task_runtime_config()
    local task_detail = M.current_task_log_detail()
    local point_objective_cfg = M.current_objective_point_config(destination, target)
    local objective_cfg = type(task_cfg) == "table" and type(task_cfg.objective) == "table" and task_cfg.objective
        or (type(map_cfg) == "table" and type(map_cfg.objective) == "table" and map_cfg.objective or nil)
        or point_objective_cfg
    local objective_source = type(task_cfg) == "table" and type(task_cfg.objective) == "table" and "task"
        or (type(map_cfg) == "table" and type(map_cfg.objective) == "table" and "map" or nil)
        or (type(point_objective_cfg) == "table" and "point" or "none")
    local require_task_path_for_kite = (
        type(objective_cfg) == "table" and objective_cfg.require_task_path_for_kite == true
    ) or (
        type(point_objective_cfg) == "table" and point_objective_cfg.require_task_path_for_kite == true
    )
    local target_source_for_kite = tostring(type(target) == "table" and target.source or "")
    local destination_source_for_kite = tostring(type(destination) == "table" and destination.source or "")
    local task_path_ready_for_kite =
        target_source == "task_path"
        or target_source_for_kite == "task_path"
        or destination_source_for_kite == "task_path"
        or destination_source_for_kite == "path_first_endpoint"
        or destination_source_for_kite == "path_last_endpoint"
    local sticky_force_boss = state.task_combat_force_kite == true
        and (tonumber(state.task_combat_last_seen_at) or 0) > 0
        and current_time - (tonumber(state.task_combat_last_seen_at) or 0) <= TASK_COMBAT_CLEAR_SETTLE_MS
    if state.task_combat_force_kite == true and not sticky_force_boss then
        state.task_combat_force_kite = false
    end
    local objective_mode = type(objective_cfg) == "table" and tostring(objective_cfg.mode or "") or ""
    local force_boss_objective = objective_mode == "boss_kite"
        or sticky_force_boss
    local immediate_boss_kite = type(objective_cfg) == "table"
        and (
            objective_cfg.immediate_kite_on_reached == true
            or (
                objective_mode == "boss_kite"
                and objective_cfg.immediate_kite_on_reached ~= false
            )
            or (
                type(point_objective_cfg) == "table"
                and (
                    point_objective_cfg.immediate_kite_on_reached == true
                    or (
                        tostring(point_objective_cfg.mode or "") == "boss_kite"
                        and point_objective_cfg.immediate_kite_on_reached ~= false
                    )
                )
            )
        )
    local boss_trigger_distance = type(M._leveling_policy) == "table"
        and type(M._leveling_policy.objective_ready_distance) == "function"
        and M._leveling_policy.objective_ready_distance(TARGET_REACHED_DISTANCE, objective_cfg)
        or math.max(
            TARGET_REACHED_DISTANCE,
            tonumber(type(objective_cfg) == "table" and force_boss_objective and objective_cfg.trigger_distance) or 360
        )
    if force_boss_objective
        and immediate_boss_kite
    then
        boss_trigger_distance = M.task_combat_kite_start_distance(boss_trigger_distance, objective_cfg, point_objective_cfg)
    end
    local skip_direct_interact = (type(objective_cfg) == "table" and objective_cfg.skip_direct_interact == true)
        and (
            force_boss_objective
            or objective_mode == "task_objective_button"
        )
        or sticky_force_boss
    local recent_dialogue_task_pos, recent_dialogue_meta = false, nil
    if type(M.is_recent_dialogue_completed_task_pos) == "function" then
        recent_dialogue_task_pos, recent_dialogue_meta = M.is_recent_dialogue_completed_task_pos(
            current_time,
            destination or target,
            task_name or state.current_task_name,
            task_detail,
            target_source
        )
    end

    log_throttled(ctx, "task_reached_evaluate", "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] task reached evaluate | map=%s task=%s detail=%s task_cfg_source=%s source=%s goal_distance=%.2f destination_distance=%s objective_source=%s objective_key=%s objective_mode=%s force_boss=%s sticky_boss=%s skip_direct_interact=%s recent_dialogue_task_pos=%s",
        tostring(map_name or ""),
        tostring(task_name or state.current_task_name or ""),
        tostring(task_detail or ""),
        tostring(task_cfg_source or ""),
        tostring(target_source or ""),
        tonumber(goal_distance) or 0,
        type(destination_distance) == "number" and string.format("%.2f", destination_distance) or "nil",
        tostring(objective_source or "none"),
        type(objective_cfg) == "table" and tostring(objective_cfg.key or "") or "",
        objective_mode,
        force_boss_objective and "true" or "false",
        sticky_force_boss and "true" or "false",
        skip_direct_interact and "true" or "false",
        recent_dialogue_task_pos and "true" or "false"
    ))

    local task_reached_intent = M.resolve_current_task_intent(ctx, current_time, player_x, player_y, player_z, {
        has_target = true,
        task_reached = true
    })
    local task_reached_intent_kind = tostring(type(task_reached_intent) == "table" and task_reached_intent.kind or "")
    if task_reached_intent_kind ~= ""
        and task_reached_intent_kind ~= "none"
        and task_reached_intent_kind ~= "generic_task_reached"
        and task_reached_intent_kind ~= "generic_follow_task"
    then
        if M.dispatch_task_intent(ctx, current_time, player_x, player_y, player_z, task_reached_intent) then
            log_throttled(ctx, "task_reached_suppressed_by_task_intent", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task reached fallback suppressed by task intent | task=%s detail=%s intent=%s source=%s key=%s",
                tostring(task_name or state.current_task_name or ""),
                tostring(task_detail or ""),
                task_reached_intent_kind,
                tostring(task_reached_intent.matched_source or ""),
                tostring(task_reached_intent.matched_key or "")
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end
    end

    M.ensure_terminal_task_lock(task_name, objective_cfg)
    if M.maybe_handle_terminal_task_change(ctx, current_time) then
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if force_boss_objective
        and type(objective_cfg) == "table"
        and immediate_boss_kite
        and type(goal_distance) == "number"
        and goal_distance <= boss_trigger_distance
        and (not require_task_path_for_kite or task_path_ready_for_kite)
        and M.arm_immediate_task_boss_kite(
            ctx,
            current_time,
            task_name,
            objective_cfg,
            point_objective_cfg,
            destination,
            target,
            player_x,
            player_y,
            player_z,
            "task_reached"
        )
    then
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end
    if force_boss_objective
        and require_task_path_for_kite
        and not task_path_ready_for_kite
        and type(goal_distance) == "number"
        and goal_distance <= boss_trigger_distance
    then
        log_throttled(ctx, "boss_kite_wait_task_path_" .. tostring(type(objective_cfg) == "table" and objective_cfg.key or ""), "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] boss kite waiting for task_path target | task=%s detail=%s objective=%s source=%s goal_distance=%.2f",
            tostring(task_name or state.current_task_name or ""),
            tostring(task_detail or ""),
            tostring(type(objective_cfg) == "table" and objective_cfg.key or ""),
            tostring(target_source or ""),
            tonumber(goal_distance) or 0
        ))
    end

    local recent_combat_gate_active = false
    local recent_combat_idle_ms = current_time - (tonumber(state.task_combat_last_seen_at) or 0)
    if (tonumber(state.task_combat_last_seen_at) or 0) > 0
        and recent_combat_idle_ms <= TASK_COMBAT_CLEAR_SETTLE_MS
        and (tonumber(state.task_combat_last_count) or 0) > 0
        and state.task_combat_force_kite ~= true
    then
        recent_combat_gate_active = true
        log_throttled(ctx, "task_reached_recent_combat_gate", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] recent combat at objective, skip prompt/dialogue checks | idle_ms=%d last_count=%d stage=%s",
            tonumber(recent_combat_idle_ms) or 0,
            tonumber(state.task_combat_last_count) or 0,
            tostring(state.stage or "")
        ))
    end

    if M.maybe_handle_low_priority_task_ui(ctx, current_time, player_x, player_y, player_z, {
        phase = "task_reached",
        has_target = true,
        goal_distance = goal_distance,
        objective_ready_distance = boss_trigger_distance
    }) then
        return true
    end

    if not recent_combat_gate_active
        and M.maybe_handle_task_objective_button(ctx, current_time, goal_distance, target_source, objective_cfg, player_x, player_y)
    then
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if not recent_combat_gate_active
        and M.maybe_handle_task_reached_prompt_or_portal(ctx, current_time, goal_distance, target_source, player_x, player_y)
    then
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if recent_dialogue_task_pos then
        state.task_reached_unresolved_since = 0
        schedule_task_refresh_after_transition(ctx, current_time, "recent_dialogue_same_task_pos", TASK_BUTTON_SETTLE_MS, {
            force_task_call = true,
            task_pos_reject_extra_ms = 2500,
            force_task_path_reacquire_ms = 7000
        })
        log_throttled(ctx, "recent_dialogue_same_task_pos", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] stale post-dialogue task_pos suppressed, refresh task path instead of reopening dialogue | old_task=%s old_detail=%s new_task=%s new_detail=%s target=%.2f, %.2f distance=%.2f age_ms=%d",
            tostring(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.completed_task or ""),
            tostring(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.completed_detail or ""),
            tostring(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.current_task or ""),
            tostring(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.current_detail or ""),
            tonumber((destination or target).x) or 0,
            tonumber((destination or target).y) or 0,
            tonumber(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.distance) or 0,
            current_time - (tonumber(type(recent_dialogue_meta) == "table" and recent_dialogue_meta.completed_at) or current_time)
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if tostring(target.source or "") == "task_pos"
        and (type(state.task_path) ~= "table" or #state.task_path == 0)
        and is_valid_world_point(state.task_pos)
        and type(player_z) == "number"
        and math.abs((tonumber(state.task_pos.z) or 0) - tonumber(player_z)) >= 300
    then
        local task_pos_x = tonumber(state.task_pos.x) or 0
        local task_pos_y = tonumber(state.task_pos.y) or 0
        local task_pos_z = tonumber(state.task_pos.z) or 0
        local task_pos_z_gap = math.abs(task_pos_z - tonumber(player_z))
        schedule_task_refresh_after_transition(ctx, current_time, "task_pos_vertical_mismatch", TASK_BUTTON_SETTLE_MS)
        log_throttled(ctx, "task_pos_vertical_mismatch", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task objective appears completed/unreachable after map update, refresh next task | z_gap=%.2f target=%.2f, %.2f, %.2f",
            task_pos_z_gap,
            task_pos_x,
            task_pos_y,
            task_pos_z
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if is_valid_world_point(state.task_pos)
        and type(destination_distance) == "number"
        and destination_distance > TASK_INTERACTION_APPROACH_DISTANCE
    then
        local precise_target = {
            x = tonumber(state.task_pos.x),
            y = tonumber(state.task_pos.y),
            z = tonumber(state.task_pos.z),
            source = "task_pos_precise",
            path_index = 0,
            path_points = tonumber(state.task_path_count) or 0,
            move_interval_ms = M.TASK_POS_MOVE_INTERVAL_MS
        }
        local objective_monsters, objective_monster_err = M.find_task_monsters(ctx, current_time, player_x, player_y)
        local objective_pulse_state = "none"
        if objective_monsters and tonumber(objective_monsters.count) and tonumber(objective_monsters.count) > 0 then
            local objective_nearest_monster = objective_monsters.nearest or {}
            local objective_nearest_distance = tonumber(objective_nearest_monster.distance)
            local should_objective_pulse, objective_pulse_reason = should_issue_nearby_monster_pulse(current_time)
            objective_pulse_state = tostring(objective_pulse_reason or "none")
            if should_objective_pulse
                and objective_nearest_distance ~= nil
                and objective_nearest_distance <= TASK_MONSTER_PLAYER_DISTANCE
            then
                local pulse_ok, pulse_err = M.run_task_combat_pulse(ctx, current_time, "nearby_monster", {
                    mode = "task_combat_objective_nearby"
                })
                if pulse_ok then
                    objective_pulse_state = "issued"
                else
                    objective_pulse_state = "blocked:" .. tostring(pulse_err or "unknown")
                end
            elseif objective_nearest_distance == nil
                or objective_nearest_distance > TASK_MONSTER_PLAYER_DISTANCE
            then
                objective_pulse_state = "monster_too_far"
            end
        elseif objective_monster_err then
            objective_pulse_state = "scan_miss"
        end

        state.task_reached_unresolved_since = 0
        state.stage = "approach_task_objective"
        issue_move(ctx, current_time, precise_target)
        log_throttled(ctx, "task_precise_approach", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] objective not close enough for interaction, continue exact approach | distance=%.2f source=%s pulse=%s",
            tonumber(destination_distance) or 0,
            target_source,
            tostring(objective_pulse_state or "none")
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    local nearest_npc, npc_err = nil, nil
    if not recent_combat_gate_active then
        nearest_npc, npc_err = M.find_current_task_npc(ctx, current_time, player_x, player_y)
    end
    if nearest_npc and nearest_npc.distance <= NPC_DIALOGUE_TRIGGER_DISTANCE then
        if M.maybe_guard_interaction_with_combat(ctx, current_time, player_x, player_y, "npc_dialogue") then
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end
        state.task_reached_unresolved_since = 0
        state.stage = "npc_dialogue"
        M.stabilize_navigation_for_interaction(ctx, current_time, "npc_dialogue", player_x, player_y)
        M.interact_with_npc(ctx, current_time, nearest_npc)
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if not recent_combat_gate_active
        and not skip_direct_interact
        and is_valid_world_point(state.task_pos)
        and type(destination_distance) == "number"
        and destination_distance <= 115
        and current_time - (tonumber(state.last_dialogue_at) or 0) >= DIALOGUE_COOLDOWN_MS
    then
        if M.maybe_guard_interaction_with_combat(ctx, current_time, player_x, player_y, "task_objective_direct_interact") then
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end
        state.task_reached_unresolved_since = 0
        state.stage = "interaction_prompt"
        M.stabilize_navigation_for_interaction(ctx, current_time, "task_objective_direct_interact", player_x, player_y)
        M.interact_with_prompt(ctx, current_time, {
            related_text = "task_objective_direct",
            name = "task objective direct interact",
            x = tonumber(state.task_pos.x) or 0,
            y = tonumber(state.task_pos.y) or 0
        }, goal_distance, target_source, false, false)
        log_throttled(ctx, "task_objective_direct_interact", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] direct objective interact attempted before combat | distance=%.2f source=%s",
            tonumber(destination_distance) or 0,
            target_source
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    local task_monsters, monster_err = M.find_task_monsters(ctx, current_time, player_x, player_y)
    if task_monsters and tonumber(task_monsters.count) and task_monsters.count > 0 then
        local nearest_monster = task_monsters.nearest or {}
        local forced_kite_monster = M.find_forced_kite_monster(task_monsters)
        local nearest_monster_distance = tonumber(nearest_monster.distance)
        local nearest_task_distance = tonumber(nearest_monster.task_distance)
        local map_force_boss_ready = force_boss_objective
            and type(destination_distance) == "number"
            and destination_distance <= boss_trigger_distance
            and (
                type(task_monsters.nearest_special) == "table"
                or objective_cfg.allow_any_monster == true
            )
        if type(forced_kite_monster) == "table" then
            map_force_boss_ready = true
        end
        local objective_monster_ready = (nearest_task_distance ~= nil and nearest_task_distance <= TASK_MONSTER_TARGET_DISTANCE)
            or (
                type(destination_distance) == "number"
                and destination_distance <= TASK_INTERACTION_APPROACH_DISTANCE
                and nearest_monster_distance ~= nil
                and nearest_monster_distance <= TASK_MONSTER_PLAYER_DISTANCE
            )
            or map_force_boss_ready
        local recent_path_move_guard = tostring(target.source or "") == "task_path"
            and (tonumber(state.last_move_call_at) or 0) > 0
            and current_time - (tonumber(state.last_move_call_at) or 0) < 1400

        if tostring(target.source or "") == "task_path"
            and (#(state.task_path or {}) > 0)
            and not map_force_boss_ready
            and (not objective_monster_ready or recent_path_move_guard)
        then
            state.task_reached_unresolved_since = 0
            state.stage = "follow_task"
            if current_time >= (tonumber(state.next_move_at) or 0) then
                issue_move(ctx, current_time, target)
            end
            local should_path_pulse, path_pulse_reason = should_issue_nearby_monster_pulse(current_time)
            local path_pulse_state = tostring(path_pulse_reason or "none")
            if should_path_pulse and nearest_monster_distance ~= nil
                and nearest_monster_distance <= TASK_MONSTER_PLAYER_DISTANCE
            then
                local pulse_ok, pulse_err = M.run_task_combat_pulse(ctx, current_time, "nearby_monster", {
                    mode = "task_combat_path_nearby"
                })
                if pulse_ok then
                    path_pulse_state = "issued"
                else
                    path_pulse_state = "blocked:" .. tostring(pulse_err or "unknown")
                end
            elseif nearest_monster_distance == nil or nearest_monster_distance > TASK_MONSTER_PLAYER_DISTANCE then
                path_pulse_state = "monster_too_far"
            end
            log_throttled(ctx, "task_combat_deferred_until_destination", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] monsters seen before objective is ready, continue task path | goal_distance=%.2f nearest_distance=%s task_distance=%s recent_move_guard=%s pulse=%s count=%d",
                tonumber(goal_distance) or 0,
                nearest_monster_distance ~= nil and string.format("%.2f", nearest_monster_distance) or "nil",
                nearest_task_distance ~= nil and string.format("%.2f", nearest_task_distance) or "nil",
                recent_path_move_guard and "true" or "false",
                tostring(path_pulse_state or "none"),
                tonumber(task_monsters.count) or 0
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        log_throttled(ctx, "task_reached_monster_gate", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task reached monster gate | map=%s task=%s source=%s monsters=%d nearest_distance=%s task_distance=%s objective_ready=%s boss_ready=%s has_special=%s allow_any_monster=%s special_label=%s special_kind=%s forced_label=%s",
            tostring(map_name or ""),
            tostring(task_name or state.current_task_name or ""),
            tostring(target_source or ""),
            tonumber(task_monsters.count) or 0,
            nearest_monster_distance ~= nil and string.format("%.2f", nearest_monster_distance) or "nil",
            nearest_task_distance ~= nil and string.format("%.2f", nearest_task_distance) or "nil",
            objective_monster_ready and "true" or "false",
            map_force_boss_ready and "true" or "false",
            type(task_monsters.nearest_special) == "table" and "true" or "false",
            type(objective_cfg) == "table" and objective_cfg.allow_any_monster == true and "true" or "false",
            tostring(task_monsters.nearest_special and task_monsters.nearest_special.label or ""),
            tostring(task_monsters.nearest_special and task_monsters.nearest_special.special_kind or ""),
            tostring(forced_kite_monster and forced_kite_monster.label or "")
        ))
        M.mark_task_combat_seen(current_time, player_x, player_y, destination or target, task_monsters)
        if map_force_boss_ready then
            state.task_combat_force_kite = true
            M.lock_boss_combat_context(task_name, objective_cfg, point_objective_cfg)
            local boss_anchor = forced_kite_monster or task_monsters.nearest_special or task_monsters.nearest or nil
            state.task_combat_kite_template_points = nil
            state.task_combat_kite_switch_ms = nil
            M.apply_task_combat_kite_runtime_options(objective_cfg, point_objective_cfg)
            local configured_kite_points = type(point_objective_cfg) == "table" and point_objective_cfg.kite_points
                or type(objective_cfg) == "table" and objective_cfg.kite_points
                or nil
            if type(configured_kite_points) == "table" then
                local normalized_points = {}
                for _, point in ipairs(configured_kite_points) do
                    local point_x = tonumber(type(point) == "table" and point.x)
                    local point_y = tonumber(type(point) == "table" and point.y)
                    if point_x ~= nil and point_y ~= nil then
                        normalized_points[#normalized_points + 1] = {
                            x = point_x,
                            y = point_y,
                            z = tonumber(type(point) == "table" and point.z) or tonumber(state.task_combat_anchor_z)
                        }
                    end
                end
                if #normalized_points >= 3 then
                    state.task_combat_kite_template_points = normalized_points
                    state.task_combat_kite_switch_ms = tonumber(type(point_objective_cfg) == "table" and point_objective_cfg.kite_switch_ms)
                        or tonumber(type(objective_cfg) == "table" and objective_cfg.kite_switch_ms)
                end
            end
            if type(state.task_combat_kite_points) ~= "table" then
                if type(point_objective_cfg) == "table"
                    and tostring(point_objective_cfg.mode or "") == "boss_kite"
                    and tonumber(point_objective_cfg.x) ~= nil
                    and tonumber(point_objective_cfg.y) ~= nil
                then
                    state.task_combat_anchor_x = tonumber(point_objective_cfg.x)
                    state.task_combat_anchor_y = tonumber(point_objective_cfg.y)
                    state.task_combat_anchor_z = tonumber(point_objective_cfg.z) or tonumber(state.task_combat_anchor_z)
                    state.task_combat_kite_radius = tonumber(point_objective_cfg.kite_radius)
                        or tonumber(objective_cfg and objective_cfg.kite_radius)
                        or tonumber(state.task_combat_kite_radius)
                elseif tostring(type(point_objective_cfg) == "table" and point_objective_cfg.kite_anchor_source or objective_cfg and objective_cfg.kite_anchor_source or "") == "task_destination"
                    and is_valid_world_point(destination or target)
                then
                    local anchor = destination or target
                    state.task_combat_anchor_x = tonumber(anchor.x) or tonumber(state.task_combat_anchor_x)
                    state.task_combat_anchor_y = tonumber(anchor.y) or tonumber(state.task_combat_anchor_y)
                    state.task_combat_anchor_z = tonumber(anchor.z) or tonumber(state.task_combat_anchor_z)
                    state.task_combat_kite_radius = tonumber(objective_cfg and objective_cfg.kite_radius)
                        or tonumber(state.task_combat_kite_radius)
                elseif type(boss_anchor) == "table" then
                    state.task_combat_anchor_x = tonumber(boss_anchor.x) or tonumber(state.task_combat_anchor_x)
                    state.task_combat_anchor_y = tonumber(boss_anchor.y) or tonumber(state.task_combat_anchor_y)
                    state.task_combat_anchor_z = tonumber(boss_anchor.z) or tonumber(state.task_combat_anchor_z)
                    state.task_combat_kite_radius = tonumber(objective_cfg and objective_cfg.kite_radius)
                        or tonumber(state.task_combat_kite_radius)
                end
            end
        end

        local hard_kite = map_force_boss_ready or M.should_use_task_combat_kiting(current_time, task_monsters, hp_ratio)
        local special_monster = forced_kite_monster or task_monsters.nearest_special or task_monsters.nearest or {}
        local kite_target = hard_kite and M.build_task_combat_kite_target(current_time, player_x, player_y, destination or target) or nil
        if hard_kite and type(kite_target) == "table" then
            state.task_reached_unresolved_since = 0
            state.stage = "task_combat_kite"
            M.issue_task_combat_kite_move(ctx, current_time, kite_target)
            M.run_task_combat_pulse(ctx, current_time, "task_combat_kite", {
                mode = "task_combat_kite"
            })
            log_throttled(ctx, "task_combat_kiting", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task combat kiting | map=%s task=%s monsters=%d special=%s special_kind=%s nearest_distance=%.2f task_distance=%s hp_ratio=%s anchor=%.2f, %.2f kite_target=%.2f, %.2f route_index=%d/%d hard=%s boss_map=%s",
                tostring(map_name or ""),
                tostring(task_name or state.current_task_name or ""),
                tonumber(task_monsters.count) or 0,
                tostring(special_monster.label or ""),
                tostring(special_monster.special_kind or ""),
                nearest_monster_distance or 0,
                nearest_task_distance ~= nil and string.format("%.2f", nearest_task_distance) or "nil",
                type(hp_ratio) == "number" and string.format("%.2f", tonumber(hp_ratio) or 0) or "nil",
                tonumber(state.task_combat_anchor_x) or 0,
                tonumber(state.task_combat_anchor_y) or 0,
                tonumber(kite_target.x) or 0,
                tonumber(kite_target.y) or 0,
                tonumber(kite_target.path_index) or 0,
                tonumber(kite_target.path_points) or 0,
                hard_kite and "true" or "false",
                map_force_boss_ready and "true" or "false"
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        state.task_reached_unresolved_since = 0
        state.stage = "task_combat"
        log_throttled(ctx, "task_objective_combat", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] task objective inferred | type=combat map=%s task=%s monsters=%d nearest=%s player_distance=%.2f task_distance=%s hard=%s special=%s special_kind=%s boss_map=%s",
            tostring(map_name or ""),
            tostring(task_name or state.current_task_name or ""),
            tonumber(task_monsters.count) or 0,
            tostring(nearest_monster.label or ""),
            tonumber(nearest_monster.distance) or 0,
            nearest_monster.task_distance ~= nil and string.format("%.2f", tonumber(nearest_monster.task_distance) or 0) or "nil",
            hard_kite and "true" or "false",
            tostring(special_monster.label or ""),
            tostring(special_monster.special_kind or ""),
            map_force_boss_ready and "true" or "false"
        ))
        M.run_task_combat_pulse(ctx, current_time, "task_combat", {
            mode = "task_combat"
        })
        log_throttled(ctx, "task_reached", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] near task target | distance=%.2f source=%s",
            goal_distance,
            target_source
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    if (tonumber(state.task_combat_last_seen_at) or 0) > 0 then
        local combat_idle_ms = current_time - (tonumber(state.task_combat_last_seen_at) or 0)
        if combat_idle_ms >= TASK_COMBAT_CLEAR_SETTLE_MS then
            state.task_reached_unresolved_since = 0
            schedule_task_refresh_after_transition(ctx, current_time, "task_combat_cleared", POST_DIALOGUE_SETTLE_MS)
            log_throttled(ctx, "task_combat_cleared", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] combat objective appears cleared, refresh next task | idle_ms=%d last_count=%d",
                tonumber(combat_idle_ms) or 0,
                tonumber(state.task_combat_last_count) or 0
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        state.task_reached_unresolved_since = 0
        state.stage = "task_combat_settle"
        hold_navigation(ctx, current_time, "task_combat_settle")
        log_throttled(ctx, "task_combat_settle", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] waiting combat objective settle before refreshing next task | idle_ms=%d last_count=%d",
            tonumber(combat_idle_ms) or 0,
            tonumber(state.task_combat_last_count) or 0
        ))
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    clear_task_combat_state()

    local has_task_path_snapshot = type(state.task_path) == "table" and #state.task_path > 0
    local has_nearby_blocking_monster = false
    if task_monsters and tonumber(task_monsters.count) and tonumber(task_monsters.count) > 0 then
        local nearest_monster = task_monsters.nearest or {}
        if tonumber(nearest_monster.distance) ~= nil
            and tonumber(nearest_monster.distance) <= NPC_DIALOGUE_MONSTER_BLOCK_DISTANCE
        then
            has_nearby_blocking_monster = true
        end
    end

    if nearest_npc or has_nearby_blocking_monster then
        state.task_reached_unresolved_since = 0
    else
        if (tonumber(state.task_reached_unresolved_since) or 0) <= 0 then
            state.task_reached_unresolved_since = current_time
        end
        local unresolved_ms = current_time - (tonumber(state.task_reached_unresolved_since) or current_time)
        local spawn_wait_ms = 1800
        if not task_monsters then
            spawn_wait_ms = has_task_path_snapshot and 6500 or 4200
        end
        if unresolved_ms >= spawn_wait_ms then
            state.task_reached_unresolved_since = 0
            local followup_route_action_key = type(objective_cfg) == "table"
                and tostring(objective_cfg.followup_route_action_key or "")
                or ""
            if followup_route_action_key ~= "" then
                local action, action_err = M.activate_route_point_action(
                    ctx,
                    current_time,
                    followup_route_action_key,
                    "task_reached_followup"
                )
                if type(action) == "table" then
                    log_throttled(ctx, "task_reached_followup_route_action", "info", LOG_THROTTLE_MS, string.format(
                        "[Leveling] objective follow-up route action armed at task reached | task=%s objective=%s action=%s mode=%s unresolved_ms=%d",
                        tostring(task_name or state.current_task_name or ""),
                        tostring(type(objective_cfg) == "table" and objective_cfg.key or ""),
                        tostring(followup_route_action_key),
                        tostring(action.mode or ""),
                        tonumber(unresolved_ms) or 0
                    ))
                    if tostring(action.mode or "") == "npc_dialogue_point"
                        and M.maybe_handle_route_point_action_npc_dialogue(ctx, current_time, player_x, player_y, player_z)
                    then
                        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
                        return true
                    end
                    if tostring(action.mode or "") == "lift_transition"
                        and M.maybe_handle_route_point_action_boarding(ctx, current_time, player_x, player_y, player_z)
                    then
                        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
                        return true
                    end
                    if tostring(action.mode or "") == "recorded_route_point"
                        and M.maybe_handle_route_point_action_route(ctx, current_time, player_x, player_y, player_z)
                    then
                        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
                        return true
                    end
                    log_heartbeat(ctx, current_time, player_x, player_y, player_z)
                    return true
                end
                log_throttled(ctx, "task_reached_followup_route_action_failed", "warn", LOG_THROTTLE_MS, string.format(
                    "[Leveling] objective follow-up route action unavailable at task reached | task=%s objective=%s action=%s err=%s",
                    tostring(task_name or state.current_task_name or ""),
                    tostring(type(objective_cfg) == "table" and objective_cfg.key or ""),
                    tostring(followup_route_action_key),
                    tostring(action_err or "")
                ))
            end
            schedule_task_refresh_after_transition(ctx, current_time, "task_reached_no_objective", TASK_BUTTON_SETTLE_MS)
            log_throttled(ctx, "task_reached_no_objective", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] task objective completed without dialogue/object prompt, refresh next task | unresolved_ms=%d monsters=%d has_path=%s",
                    tonumber(unresolved_ms) or 0,
                tonumber(task_monsters and task_monsters.count) or 0,
                has_task_path_snapshot and "true" or "false"
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end

        if not task_monsters then
            state.stage = "task_spawn_wait"
            hold_navigation(ctx, current_time, "task_spawn_wait")
            log_throttled(ctx, "task_spawn_wait", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] waiting task cutscene/spawn/bridge at target before refreshing | waited=%dms has_path=%s",
                tonumber(unresolved_ms) or 0,
                has_task_path_snapshot and "true" or "false"
            ))
            log_heartbeat(ctx, current_time, player_x, player_y, player_z)
            return true
        end
    end

    if npc_err then
        log_throttled(ctx, "npc_missing", "info", LOG_THROTTLE_MS,
            "[Leveling] reached task target but no nearby NPC confirmed yet: " .. tostring(npc_err))
    end
    if monster_err then
        log_throttled(ctx, "task_objective_unknown", "info", LOG_THROTTLE_MS,
            "[Leveling] task objective unresolved | no NPC or monster near target, may be device/protect objective: " .. tostring(monster_err))
    end

    if current_time >= (tonumber(state.next_task_button_soft_refresh_at) or 0) then
        schedule_task_refresh_after_transition(ctx, current_time, "task_reached_next_task", POST_DIALOGUE_SETTLE_MS)
        log_throttled(ctx, "task_target_hard_refresh_at_target", "info", LOG_THROTTLE_MS,
            "[Leveling] unresolved task objective scheduled next-task refresh.")
        log_heartbeat(ctx, current_time, player_x, player_y, player_z)
        return true
    end

    log_throttled(ctx, "task_reached", "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] near task target | distance=%.2f source=%s",
        goal_distance,
        target_source
    ))
    hold_navigation(ctx, current_time, "task_reached")
    log_heartbeat(ctx, current_time, player_x, player_y, player_z)
    return true
end

local function map_transition_state_key(map_name, transition)
    return table.concat({
        tostring(normalize_map_name(map_name) or ""),
        tostring(type(transition) == "table" and (transition.key or transition.label) or "")
    }, "|")
end

function M.route_point_action_state_key(action)
    return table.concat({
        tostring(normalize_map_name(M.current_task_log_name()) or ""),
        tostring(type(action) == "table" and (action.key or action.label) or "")
    }, "|")
end

function M.route_point_action_advances_task(action)
    if type(action) ~= "table" then
        return false
    end
    if action.task_refresh_confirms_success == false
        or action.complete_on_task_refresh == false
    then
        return false
    end
    if action.task_refresh_confirms_success == true
        or action.complete_on_task_refresh == true
    then
        return true
    end
    local mode = tostring(action.mode or "")
    return mode == "npc_dialogue_point"
        or mode == "objective_button_flow_point"
        or mode == "lift_transition"
        or (mode == "" and (type(action.step) == "table" or action.fallback_interact == true))
end

function M.route_point_action_completed_by_task_refresh(action)
    if not M.route_point_action_advances_task(action) then
        return false, nil
    end
    if type(action) == "table"
        and (action.allow_repeat_after_task_refresh == true or action.repeat_after_task_refresh == true)
    then
        return false, nil
    end
    local state_key = M.route_point_action_state_key(action)
    if type(state.completed_task_advancing_actions) == "table"
        and state.completed_task_advancing_actions[state_key] ~= nil
    then
        return true, state_key
    end
    return false, state_key
end

function M.arm_task_advancing_action_confirmation(ctx, current_time, action, state_key, source)
    if not M.route_point_action_advances_task(action) then
        return false
    end
    if type(state.completed_task_advancing_actions) ~= "table" then
        state.completed_task_advancing_actions = {}
    end
    local action_key = tostring(type(action) == "table" and (action.key or action.label) or "")
    if action_key == "" then
        return false
    end
    local completion_key = tostring(state_key or "")
    if completion_key == "" then
        completion_key = M.route_point_action_state_key(action)
    end
    state.task_advancing_action_pending_key = action_key
    state.task_advancing_action_pending_state_key = completion_key
    state.task_advancing_action_pending_mode = tostring(type(action) == "table" and action.mode or "")
    state.task_advancing_action_pending_source = tostring(source or "")
    state.task_advancing_action_pending_task_name = tostring(M.current_task_log_name() or state.current_task_name or "")
    state.task_advancing_action_pending_task_detail = tostring(M.current_task_log_detail() or state.current_task_detail or "")
    state.task_advancing_action_pending_started_at = tonumber(current_time) or now_ms(ctx)
    state.task_advancing_action_pending_deadline_at =
        (tonumber(current_time) or now_ms(ctx)) + math.max(8000, tonumber(action.task_refresh_success_timeout_ms) or 25000)
    state.task_advancing_action_pending_expire_deferred_at = 0
    logger(ctx).info(string.format(
        "[Leveling] task-advancing route action awaiting task refresh | task=%s detail=%s key=%s mode=%s state_key=%s source=%s",
        tostring(state.task_advancing_action_pending_task_name or ""),
        tostring(state.task_advancing_action_pending_task_detail or ""),
        action_key,
        tostring(state.task_advancing_action_pending_mode or ""),
        completion_key,
        tostring(source or "")
    ))
    return true
end

function M.maybe_confirm_task_advancing_action_success(ctx, current_time, source)
    local pending_key = tostring(state.task_advancing_action_pending_key or "")
    local pending_state_key = tostring(state.task_advancing_action_pending_state_key or "")
    if pending_key == "" or pending_state_key == "" then
        return false
    end

    current_time = tonumber(current_time) or now_ms(ctx)
    local old_task = M.normalize_task_title_key(state.task_advancing_action_pending_task_name)
    local old_detail = normalize_map_name(state.task_advancing_action_pending_task_detail)
    local current_task = M.normalize_task_title_key(state.current_task_name or M.current_task_log_name())
    local current_detail = normalize_map_name(state.current_task_detail or M.current_task_log_detail())
    local task_changed = old_task ~= nil and current_task ~= nil and old_task ~= current_task
    local detail_changed = old_detail ~= nil and current_detail ~= nil and old_detail ~= current_detail
    local transition_marker = type(M.is_task_detail_transition) == "function"
        and M.is_task_detail_transition(state.current_task_detail)
        or false

    if task_changed or detail_changed or transition_marker then
        if type(state.completed_task_advancing_actions) ~= "table" then
            state.completed_task_advancing_actions = {}
        end
        state.completed_task_advancing_actions[pending_state_key] = current_time
        local action = M.find_route_point_action_by_key(pending_key)
        if type(action) == "table" then
            M.mark_recipe_action_completed(
                ctx,
                current_time,
                action,
                transition_marker and "task_transition_confirmed" or "task_refresh_confirmed"
            )
        end
        if transition_marker then
            if type(schedule_task_refresh_after_transition) == "function" then
                schedule_task_refresh_after_transition(
                    ctx,
                    current_time,
                    "task_advancing_action_transition_marker_" .. pending_state_key,
                    100,
                    {
                        force_task_call = true,
                        task_pos_reject_extra_ms = 3500,
                        force_task_path_reacquire_ms = 10000,
                        task_info_change_observed = true,
                        skip_task_info_stability_gate = true,
                        previous_task_name = state.task_advancing_action_pending_task_name,
                        previous_task_detail = state.task_advancing_action_pending_task_detail
                    }
                )
                state.next_task_button_click_at = state.task_update_wait_until
                state.next_task_refresh_at = state.task_update_wait_until
            else
                state.require_task_button_refresh = true
                state.require_task_button_refresh_reason =
                    "task_advancing_action_transition_marker:" .. pending_state_key
                state.next_task_button_click_at = current_time
                state.next_task_refresh_at = current_time
                state.task_pos_reject_until = math.max(
                    tonumber(state.task_pos_reject_until) or 0,
                    current_time + 8000
                )
                state.task_pos_reject_reason = state.require_task_button_refresh_reason
                state.force_task_path_reacquire_until = math.max(
                    tonumber(state.force_task_path_reacquire_until) or 0,
                    current_time + 10000
                )
                state.force_task_path_reacquire_reason = state.require_task_button_refresh_reason
            end
        end
        logger(ctx).info(string.format(
            "[Leveling] task-advancing route action confirmed by task refresh | key=%s state_key=%s old_task=%s old_detail=%s new_task=%s new_detail=%s source=%s changed=%s/%s transition=%s",
            pending_key,
            pending_state_key,
            tostring(old_task or ""),
            tostring(old_detail or ""),
            tostring(current_task or ""),
            tostring(current_detail or ""),
            tostring(source or ""),
            task_changed and "task" or "",
            detail_changed and "detail" or "",
            transition_marker and "true" or "false"
        ))
        M.clear_task_advancing_action_confirmation()
        return true
    end

    local deadline_at = tonumber(state.task_advancing_action_pending_deadline_at) or 0
    if deadline_at > 0 and current_time > deadline_at then
        if tostring(source or "") == "publish_current_task_name"
            and (tonumber(state.task_advancing_action_pending_expire_deferred_at) or 0) <= 0
        then
            state.task_advancing_action_pending_expire_deferred_at = current_time
            state.task_advancing_action_pending_deadline_at = current_time + 1200
            logger(ctx).info(string.format(
                "[Leveling] task-advancing route action expiration deferred for detail sync | key=%s state_key=%s task=%s detail=%s source=%s",
                pending_key,
                pending_state_key,
                tostring(state.task_advancing_action_pending_task_name or ""),
                tostring(state.task_advancing_action_pending_task_detail or ""),
                tostring(source or "")
            ))
            return false
        end
        logger(ctx).warn(string.format(
            "[Leveling] task-advancing route action refresh confirmation expired | key=%s state_key=%s task=%s detail=%s source=%s",
            pending_key,
            pending_state_key,
            tostring(state.task_advancing_action_pending_task_name or ""),
            tostring(state.task_advancing_action_pending_task_detail or ""),
            tostring(source or "")
        ))
        M.clear_task_advancing_action_confirmation()
    end
    return false
end

function M.find_route_point_action_by_key(action_key)
    if type(M.ROUTE_POINT_ACTIONS) ~= "table" or action_key == nil or action_key == "" then
        return nil
    end
    local normalized_key = tostring(action_key)
    for _, action in ipairs(M.ROUTE_POINT_ACTIONS) do
        local candidate = tostring(type(action) == "table" and (action.key or action.label) or "")
        if candidate ~= "" and candidate == normalized_key then
            return action
        end
    end
    return nil
end

function M.route_point_action_matches_task(action)
    if type(action) ~= "table" then
        return false
    end

    return M.matches_task_constraints(action)
end

function M.route_point_action_has_map_constraints(action)
    return type(action) == "table"
        and (type(action.map_names) == "table" or type(action.map_patterns) == "table")
end

function M.route_point_action_matches_map_name(action, map_name)
    if not M.route_point_action_has_map_constraints(action) then
        return true, normalize_map_name(map_name)
    end

    local map_key = normalize_map_name(map_name)
    if map_key == nil then
        if type(action) == "table" and action.allow_when_map_unknown == true then
            return true, nil
        end
        return false, nil
    end

    local function contains_exact(list)
        if type(list) ~= "table" then
            return false
        end
        for _, item in ipairs(list) do
            local item_key = normalize_map_name(item)
            if item_key ~= nil and item_key == map_key then
                return true
            end
        end
        return false
    end

    local function contains_pattern(list)
        if type(list) ~= "table" then
            return false
        end
        for _, item in ipairs(list) do
            local item_key = normalize_map_name(item)
            if item_key ~= nil and map_key:find(item_key, 1, true) then
                return true
            end
        end
        return false
    end

    return contains_exact(action.map_names) or contains_pattern(action.map_patterns), map_key
end

function M.refresh_route_point_action_map_name(ctx, current_time, force)
    current_time = tonumber(current_time) or now_ms(ctx)
    local next_probe_at = tonumber(state.next_route_point_action_map_probe_at) or 0
    if force ~= true and current_time < next_probe_at then
        return state.cached_route_point_action_map_name, state.cached_route_point_action_map_error
    end

    state.next_route_point_action_map_probe_at = current_time + 1200
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table"
        or type(nav_mod.enum_ui) ~= "function"
        or type(nav_mod.get_current_map_name) ~= "function"
    then
        state.cached_route_point_action_map_name = nil
        state.cached_route_point_action_map_error = "map ui API is unavailable."
        return nil, state.cached_route_point_action_map_error
    end

    local ui, ui_err = nav_mod.enum_ui()
    if type(ui) ~= "table" then
        state.cached_route_point_action_map_name = nil
        state.cached_route_point_action_map_error = tostring(ui_err or "enum_ui failed.")
        return nil, state.cached_route_point_action_map_error
    end

    local map_name, map_err = nav_mod.get_current_map_name(ui)
    map_name = trim(map_name)
    if map_name == "" then
        state.cached_route_point_action_map_name = nil
        state.cached_route_point_action_map_error = tostring(map_err or "current map not found.")
        return nil, state.cached_route_point_action_map_error
    end

    state.cached_route_point_action_map_name = map_name
    state.cached_route_point_action_map_error = nil
    return map_name, nil
end

function M.route_point_action_matches_current_map(ctx, action, current_time)
    if not M.route_point_action_has_map_constraints(action) then
        return true, normalize_map_name(state.current_map_name or state.cached_route_point_action_map_name), nil
    end

    local map_name = state.current_map_name or state.cached_route_point_action_map_name
    local ok, normalized_map = M.route_point_action_matches_map_name(action, map_name)
    if ok then
        return true, normalized_map, nil
    end

    map_name = select(1, M.refresh_route_point_action_map_name(ctx, current_time, true))
    ok, normalized_map = M.route_point_action_matches_map_name(action, map_name)
    if ok then
        return true, normalized_map, nil
    end

    return false, normalized_map, state.cached_route_point_action_map_error
end

function M.route_point_action_destination_matches(action, player_x, player_y)
    if type(action) ~= "table" or action.require_destination_match ~= true then
        return true, nil, nil, nil
    end

    local trigger = type(action.trigger) == "table" and action.trigger or nil
    local trigger_x = tonumber(trigger and trigger.x)
    local trigger_y = tonumber(trigger and trigger.y)
    if trigger_x == nil or trigger_y == nil then
        return false, nil, "route point trigger unavailable", nil
    end

    local destination = build_task_destination_point(player_x, player_y)
    if type(destination) ~= "table" or tonumber(destination.x) == nil or tonumber(destination.y) == nil then
        return false, nil, "task destination unavailable", nil
    end

    local match_radius = math.max(
        80,
        tonumber(action.destination_match_radius) or tonumber(trigger.radius) or 220
    )
    local destination_distance = distance_2d(
        tonumber(destination.x) or trigger_x,
        tonumber(destination.y) or trigger_y,
        trigger_x,
        trigger_y
    )
    return destination_distance <= match_radius, destination_distance, nil, destination
end

function M.pick_route_point_action_level_candidate(ui)
    if type(ui) ~= "table" or type(ui.texts) ~= "table" then
        return nil
    end

    local best = nil
    for _, item in ipairs(ui.texts or {}) do
        local text = trim(type(item) == "table" and item.text or "")
        if text ~= "" then
            local normalized = text:lower()
            local score = 0
            if text:match("\u{7B49}\u{7EA7}%s*%d+") then
                score = score + 120
            end
            if text:match("\u{7B49}\u{7EA7}%s*%d+%s*%(%d+%%%)") then
                score = score + 80
            end
            if normalized:match("lv%s*%d+") or normalized:match("level%s*%d+") then
                score = score + 60
            end
            if text:match("%d+%%") then
                score = score + 18
            end
            if text:find("\u{63A8}\u{8350}", 1, true) then
                score = score - 120
            end
            if text:find("\u{9700}\u{6C42}\u{7B49}\u{7EA7}", 1, true) then
                score = score - 160
            end
            if text:find("\u{602A}\u{7269}\u{7B49}\u{7EA7}", 1, true) then
                score = score - 160
            end
            if text:find("\u{5173}\u{5361}\u{7B49}\u{7EA7}", 1, true) then
                score = score - 160
            end

            local level_value = text:match("\u{7B49}\u{7EA7}%s*(%d+)")
                or normalized:match("lv%s*(%d+)")
                or normalized:match("level%s*(%d+)")
            if level_value ~= nil and score > 0 then
                local candidate = {
                    text = text,
                    level = tonumber(level_value),
                    progress = tonumber(text:match("%((%d+)%%%s*%)") or text:match("(%d+)%%%s*$") or ""),
                    score = score,
                    x = tonumber(type(item) == "table" and item.x),
                    y = tonumber(type(item) == "table" and item.y),
                    name = tostring(type(item) == "table" and item.name or "")
                }
                if best == nil then
                    best = candidate
                else
                    local best_score = tonumber(best.score) or 0
                    local best_y = tonumber(best.y) or math.huge
                    local candidate_y = tonumber(candidate.y) or math.huge
                    if score > best_score or (score == best_score and candidate_y > best_y) then
                        best = candidate
                    end
                end
            end
        end
    end
    return best
end

function M.refresh_route_point_action_player_level(ctx, current_time, force)
    current_time = tonumber(current_time) or now_ms(ctx)
    local next_probe_at = tonumber(state.next_route_point_action_level_probe_at) or 0
    if force ~= true and current_time < next_probe_at then
        return state.cached_route_point_action_player_level,
            state.cached_route_point_action_player_level_progress,
            state.cached_route_point_action_player_level_text,
            state.cached_route_point_action_player_level_error
    end

    local level_probe_cfg = type(M.LEVEL_UP_MAINTENANCE_CONFIG) == "table"
        and tonumber(M.LEVEL_UP_MAINTENANCE_CONFIG.probe_ms)
        or nil
    state.next_route_point_action_level_probe_at = current_time + math.max(300, level_probe_cfg or 1200)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_ui) ~= "function" then
        state.cached_route_point_action_player_level_error = "nav.enum_ui is unavailable."
        return state.cached_route_point_action_player_level,
            state.cached_route_point_action_player_level_progress,
            state.cached_route_point_action_player_level_text,
            state.cached_route_point_action_player_level_error
    end

    local ui, ui_err = nav_mod.enum_ui()
    if type(ui) ~= "table" then
        state.cached_route_point_action_player_level_error = tostring(ui_err or "enum_ui failed.")
        return state.cached_route_point_action_player_level,
            state.cached_route_point_action_player_level_progress,
            state.cached_route_point_action_player_level_text,
            state.cached_route_point_action_player_level_error
    end

    local best = M.pick_route_point_action_level_candidate(ui)
    if type(best) ~= "table" or type(best.level) ~= "number" then
        state.cached_route_point_action_player_level_error = "player level text not found."
        return state.cached_route_point_action_player_level,
            state.cached_route_point_action_player_level_progress,
            state.cached_route_point_action_player_level_text,
            state.cached_route_point_action_player_level_error
    end

    state.cached_route_point_action_player_level = math.floor(best.level)
    state.cached_route_point_action_player_level_progress = best.progress
    state.cached_route_point_action_player_level_text = best.text
    state.cached_route_point_action_player_level_error = nil
    return state.cached_route_point_action_player_level,
        state.cached_route_point_action_player_level_progress,
        state.cached_route_point_action_player_level_text,
        nil
end

function M.level_up_maintenance_config()
    if type(M.LEVEL_UP_MAINTENANCE_CONFIG) == "table" then
        return M.LEVEL_UP_MAINTENANCE_CONFIG
    end
    return {}
end

function M.level_up_maintenance_enabled()
    local cfg = M.level_up_maintenance_config()
    return cfg.enabled ~= false
end

function M.level_up_maintenance_level_has_plan(cfg, plan_key, level)
    if type(cfg) ~= "table" or type(plan_key) ~= "string" or plan_key == "" then
        return false
    end
    local plans = cfg[plan_key]
    if type(plans) ~= "table" then
        return false
    end
    local int_level = math.floor(tonumber(level) or 0)
    if plans[int_level] ~= nil or plans[tostring(int_level)] ~= nil then
        return true
    end
    if plan_key == "skill_by_level" then
        return M.level_up_maintenance_get_level_plan(cfg, "skill", int_level) ~= nil
    end
    return false
end

function M.level_up_maintenance_sync_legacy_pending_kind(kind, value)
    kind = tostring(kind or "")
    value = value == true
    if kind == "skill" then
        state.level_up_maintenance_pending_skill = value
    elseif kind == "talent" then
        state.level_up_maintenance_pending_talent = value
    elseif kind == "contract" then
        state.level_up_maintenance_pending_contract = value
    end
end

function M.level_up_maintenance_pending_kind_map()
    local pending = type(state.level_up_maintenance_pending_kinds) == "table"
        and state.level_up_maintenance_pending_kinds
        or {}
    if state.level_up_maintenance_pending_skill == true then
        pending.skill = true
    end
    if state.level_up_maintenance_pending_talent == true then
        pending.talent = true
    end
    if state.level_up_maintenance_pending_contract == true then
        pending.contract = true
    end
    state.level_up_maintenance_pending_kinds = pending
    return pending
end

function M.level_up_maintenance_set_pending_kind(kind, value)
    kind = tostring(kind or "")
    if kind == "" then
        return
    end
    local pending = M.level_up_maintenance_pending_kind_map()
    if value == true then
        pending[kind] = true
    else
        pending[kind] = nil
    end
    M.level_up_maintenance_sync_legacy_pending_kind(kind, value == true)
end

function M.level_up_maintenance_replace_pending_kinds(kind_flags)
    state.level_up_maintenance_pending_kinds = {}
    state.level_up_maintenance_pending_skill = false
    state.level_up_maintenance_pending_talent = false
    state.level_up_maintenance_pending_contract = false
    if type(kind_flags) ~= "table" then
        return
    end
    for kind, value in pairs(kind_flags) do
        if value == true or (type(value) == "number" and value > 0) then
            M.level_up_maintenance_set_pending_kind(kind, true)
        end
    end
end

function M.level_up_maintenance_clear_pending_kinds()
    state.level_up_maintenance_pending_kinds = {}
    state.level_up_maintenance_pending_skill = false
    state.level_up_maintenance_pending_talent = false
    state.level_up_maintenance_pending_contract = false
end

function M.level_up_maintenance_pending_summary()
    local levels = {}
    if type(state.level_up_maintenance_pending_levels) == "table" then
        for level_key in pairs(state.level_up_maintenance_pending_levels) do
            levels[#levels + 1] = tostring(level_key)
        end
        table.sort(levels, function(a, b)
            return (tonumber(a) or math.huge) < (tonumber(b) or math.huge)
        end)
    end
    local cfg = M.level_up_maintenance_config()
    local pending = M.level_up_maintenance_pending_kind_map()
    local status = {}
    local seen = {}
    local function add_kind(kind)
        kind = tostring(kind or "")
        if kind == "" or seen[kind] == true then
            return
        end
        seen[kind] = true
        status[#status + 1] = string.format("%s=%s", kind, pending[kind] == true and "true" or "false")
    end
    for _, raw_kind in ipairs(M.level_up_maintenance_plan_order(cfg)) do
        add_kind(raw_kind)
    end
    local extras = {}
    for kind in pairs(pending) do
        if seen[tostring(kind or "")] ~= true then
            extras[#extras + 1] = tostring(kind or "")
        end
    end
    table.sort(extras)
    for _, kind in ipairs(extras) do
        add_kind(kind)
    end
    return string.format(
        "levels=[%s] %s since=%d",
        table.concat(levels, ","),
        table.concat(status, " "),
        tonumber(state.level_up_maintenance_pending_since) or 0
    )
end

function M.level_up_maintenance_pending_levels_sorted()
    local levels = {}
    if type(state.level_up_maintenance_pending_levels) == "table" then
        for level_key in pairs(state.level_up_maintenance_pending_levels) do
            local level = math.floor(tonumber(level_key) or 0)
            if level > 0 then
                levels[#levels + 1] = level
            end
        end
    end
    table.sort(levels)
    return levels
end

function M.level_up_maintenance_get_level_plan(cfg, kind, level)
    if type(cfg) ~= "table" or type(kind) ~= "string" then
        return nil
    end
    local plan_key = tostring(kind) .. "_by_level"
    local plans = cfg[plan_key]
    local int_level = math.floor(tonumber(level) or 0)
    if type(plans) ~= "table" then
        plans = {}
    end
    local explicit_plan = plans[int_level] or plans[tostring(int_level)]
    if explicit_plan ~= nil then
        return explicit_plan
    end
    if kind == "skill"
        and cfg.default_skill_enabled ~= false
        and int_level >= math.max(1, math.floor(tonumber(cfg.default_skill_min_level) or 1))
    then
        local max_level = tonumber(cfg.default_skill_max_level)
        if max_level == nil or int_level <= math.floor(max_level) then
            return cfg.default_skill_plan
        end
    end
    return nil
end

function M.level_up_maintenance_plan_steps(plan)
    if type(plan) ~= "table" then
        return nil
    end
    if type(plan.steps) == "table" then
        return plan.steps
    end
    if type(plan[1]) == "table" then
        return plan
    end
    return nil
end

function M.level_up_maintenance_plan_id(kind, level, plan)
    return string.format(
        "%s:%d:%s",
        tostring(kind or ""),
        math.floor(tonumber(level) or 0),
        tostring(type(plan) == "table" and (plan.key or plan.label) or "")
    )
end

function M.level_up_maintenance_plan_ids(kind, level, plan)
    local ids = {}
    local seen = {}
    local normalized_kind = tostring(kind or "")
    local normalized_level = math.floor(tonumber(level) or 0)
    local function add_key(key)
        key = tostring(key or "")
        if key == "" then
            return
        end
        local id = string.format("%s:%d:%s", normalized_kind, normalized_level, key)
        if seen[id] ~= true then
            seen[id] = true
            ids[#ids + 1] = id
        end
    end

    if type(plan) == "table" then
        add_key(plan.key or plan.label)
        local aliases = plan.completed_alias_keys or plan.completed_aliases or plan.legacy_completed_keys
        if type(aliases) == "table" then
            for _, alias in ipairs(aliases) do
                add_key(alias)
            end
            for alias in pairs(aliases) do
                if type(alias) ~= "number" then
                    add_key(alias)
                end
            end
        else
            add_key(aliases)
        end
    else
        add_key("")
    end

    return ids
end

function M.level_up_maintenance_plan_done(kind, level, plan)
    local plan_ids = M.level_up_maintenance_plan_ids(kind, level, plan)
    local skipped = type(state.level_up_maintenance_skipped_plans) == "table"
        and state.level_up_maintenance_skipped_plans
        or {}
    for _, plan_id in ipairs(plan_ids) do
        if skipped[plan_id] == true or type(skipped[plan_id]) == "table" then
            return true
        end
    end

    local done = type(state.level_up_maintenance_completed_plans) == "table"
        and state.level_up_maintenance_completed_plans
        or {}
    for _, plan_id in ipairs(plan_ids) do
        if done[plan_id] == true then
            return true
        end
    end

    if state.level_up_maintenance_ignore_persisted_completed_after_level_reset == true then
        return false
    end

    if type(M.ensure_level_up_maintenance_state) == "function" then
        local persisted = M.ensure_level_up_maintenance_state()
        local completed = type(persisted) == "table" and persisted.completed_plans or nil
        for _, plan_id in ipairs(plan_ids) do
            local record = type(completed) == "table" and completed[plan_id] or nil
            if record == true or type(record) == "table" then
                return true
            end
        end
    end
    return false
end

function M.level_up_maintenance_skip_plan_for_run(kind, level, plan, ctx, reason)
    local plan_id = M.level_up_maintenance_plan_id(kind, level, plan)
    if plan_id == "" then
        return false
    end
    local skipped = type(state.level_up_maintenance_skipped_plans) == "table"
        and state.level_up_maintenance_skipped_plans
        or {}
    skipped[plan_id] = {
        skipped = true,
        kind = tostring(kind or ""),
        level = math.floor(tonumber(level) or 0),
        key = tostring(type(plan) == "table" and (plan.key or "") or ""),
        label = tostring(type(plan) == "table" and (plan.label or "") or ""),
        reason = tostring(reason or ""),
        skipped_at = type(os) == "table" and type(os.time) == "function" and os.time() or nil
    }
    state.level_up_maintenance_skipped_plans = skipped
    if ctx ~= nil then
        logger(ctx).warn(string.format(
            "[Leveling] level-up maintenance plan skipped for this run after failure | kind=%s level=%d plan=%s err=%s",
            tostring(kind or ""),
            math.floor(tonumber(level) or 0),
            tostring(type(plan) == "table" and (plan.label or plan.key or "") or ""),
            tostring(reason or "")
        ))
    end
    return true
end

function M.level_up_maintenance_mark_plan_done(kind, level, plan, ctx)
    local plan_id = M.level_up_maintenance_plan_id(kind, level, plan)
    local done = type(state.level_up_maintenance_completed_plans) == "table"
        and state.level_up_maintenance_completed_plans
        or {}
    done[plan_id] = true
    state.level_up_maintenance_completed_plans = done

    local no_persist = state.level_up_maintenance_executor_no_persist == true
        or (ctx ~= nil and ctx.level_up_maintenance_no_persist == true)
    if no_persist then
        if ctx ~= nil then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance completion marked transiently | kind=%s level=%d plan=%s",
                tostring(kind or ""),
                math.floor(tonumber(level) or 0),
                tostring(type(plan) == "table" and (plan.label or plan.key or "") or "")
            ))
        end
        return true
    end

    if type(M.ensure_level_up_maintenance_state) == "function" and type(M.save_level_up_maintenance_state) == "function" then
        local persisted = M.ensure_level_up_maintenance_state()
        if type(persisted.completed_plans) ~= "table" then
            persisted.completed_plans = {}
        end
        persisted.completed_plans[plan_id] = {
            done = true,
            kind = tostring(kind or ""),
            level = math.floor(tonumber(level) or 0),
            key = tostring(type(plan) == "table" and (plan.key or "") or ""),
            label = tostring(type(plan) == "table" and (plan.label or "") or ""),
            completed_at = type(os) == "table" and type(os.time) == "function" and os.time() or nil
        }
        local saved, save_err = M.save_level_up_maintenance_state()
        if not saved and ctx ~= nil then
            logger(ctx).warn("[Leveling] level-up maintenance state save failed: " .. tostring(save_err or ""))
        end
    end
end

function M.level_up_maintenance_clear_transient_plan_done(kind, level, plan)
    if type(state.level_up_maintenance_completed_plans) ~= "table" then
        return false
    end
    local cleared = false
    for _, plan_id in ipairs(M.level_up_maintenance_plan_ids(kind, level, plan)) do
        if state.level_up_maintenance_completed_plans[plan_id] ~= nil then
            state.level_up_maintenance_completed_plans[plan_id] = nil
            cleared = true
        end
    end
    return cleared
end

function M.level_up_maintenance_last_executor_completed(kind, level, plan)
    local result = type(state.level_up_maintenance_executor_last_result) == "table"
        and state.level_up_maintenance_executor_last_result
        or nil
    if result == nil then
        return nil
    end
    local plan_id = M.level_up_maintenance_plan_id(kind, level, plan)
    if tostring(result.plan_id or "") ~= tostring(plan_id or "")
        or tostring(result.kind or "") ~= tostring(kind or "")
        or math.floor(tonumber(result.level) or 0) ~= math.floor(tonumber(level) or 0)
    then
        return nil
    end
    return result.completed == true
end

function M.level_up_maintenance_plan_order(cfg)
    if type(cfg) == "table" and type(cfg.plan_order) == "table" and #cfg.plan_order > 0 then
        return cfg.plan_order
    end
    return { "skill", "talent" }
end

function M.level_up_maintenance_kind_enabled(cfg, kind)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    kind = tostring(kind or "")
    if kind == "" then
        return false
    end
    local enabled_key = kind .. "_enabled"
    if cfg[enabled_key] ~= nil then
        return cfg[enabled_key] ~= false
    end
    return true
end

function M.level_up_maintenance_find_next_plan(cfg)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    local levels = M.level_up_maintenance_pending_levels_sorted()
    local order = M.level_up_maintenance_plan_order(cfg)
    local pending_kinds = M.level_up_maintenance_pending_kind_map()
    local default_skill_candidate = nil
    for _, level in ipairs(levels) do
        for _, raw_kind in ipairs(order) do
            local kind = tostring(raw_kind or "")
            if pending_kinds[kind] == true and M.level_up_maintenance_kind_enabled(cfg, kind) then
                local plan = M.level_up_maintenance_get_level_plan(cfg, kind, level)
                local default_skill_min_level = tonumber(state.level_up_maintenance_default_skill_min_pending_level)
                if kind == "skill"
                    and default_skill_min_level ~= nil
                    and level < default_skill_min_level
                    and cfg.default_skill_catch_up_missing ~= true
                    and type(plan) == "table"
                    and plan.default_skill_plan == true
                then
                    plan = nil
                end
                local steps = M.level_up_maintenance_plan_steps(plan)
                if type(steps) == "table"
                    and #steps > 0
                    and not M.level_up_maintenance_plan_done(kind, level, plan)
                then
                    local info = {
                        kind = kind,
                        level = level,
                        plan = plan,
                        steps = steps,
                        id = M.level_up_maintenance_plan_id(kind, level, plan)
                    }
                    if kind == "skill" and type(plan) == "table" and plan.default_skill_plan == true then
                        default_skill_candidate = default_skill_candidate or info
                    else
                        return info
                    end
                end
            end
        end
    end
    return default_skill_candidate
end

function M.level_up_maintenance_has_plan_for_level(cfg, level)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    local order = M.level_up_maintenance_plan_order(cfg)
    for _, raw_kind in ipairs(order) do
        local kind = tostring(raw_kind or "")
        local plan = M.level_up_maintenance_get_level_plan(cfg, kind, level)
        local steps = M.level_up_maintenance_plan_steps(plan)
        if type(steps) == "table" and #steps > 0 then
            return true
        end
    end
    return false
end

function M.level_up_maintenance_should_catch_up_baseline(cfg, observed_level)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    if cfg.catch_up_missing_plans_on_baseline ~= true then
        return false
    end
    observed_level = math.floor(tonumber(observed_level) or 0)
    local max_level = tonumber(cfg.catch_up_missing_plans_on_baseline_max_level)
    if max_level ~= nil and max_level > 0 and observed_level > math.floor(max_level) then
        return false
    end
    return observed_level > 0
end

function M.level_up_maintenance_should_run_current_baseline(cfg, observed_level)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    if cfg.run_current_level_plan_on_baseline ~= true then
        return false
    end
    observed_level = math.floor(tonumber(observed_level) or 0)
    local max_level = tonumber(cfg.run_current_level_plan_on_baseline_max_level)
    if max_level ~= nil and max_level > 0 and observed_level > math.floor(max_level) then
        return false
    end
    return observed_level > 0
end

function M.level_up_maintenance_collect_baseline_pending_levels(cfg, observed_level)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    observed_level = math.floor(tonumber(observed_level) or 0)
    local pending_levels = type(state.level_up_maintenance_pending_levels) == "table"
        and state.level_up_maintenance_pending_levels
        or {}
    local order = M.level_up_maintenance_plan_order(cfg)
    local start_level = M.level_up_maintenance_should_catch_up_baseline(cfg, observed_level) and 1 or observed_level
    if cfg.default_skill_catch_up_missing == true then
        state.level_up_maintenance_default_skill_min_pending_level = nil
    else
        state.level_up_maintenance_default_skill_min_pending_level = observed_level
    end
    local count = 0
    local has_skill = false
    local has_talent = false
    local has_contract = false
    local kind_flags = {}
    local scanned = 0

    for level = start_level, observed_level do
        scanned = scanned + 1
        for _, raw_kind in ipairs(order) do
            local kind = tostring(raw_kind or "")
            if M.level_up_maintenance_kind_enabled(cfg, kind) then
                local plan = M.level_up_maintenance_get_level_plan(cfg, kind, level)
                if kind == "skill"
                    and level < observed_level
                    and cfg.default_skill_catch_up_missing ~= true
                    and type(plan) == "table"
                    and plan.default_skill_plan == true
                then
                    plan = nil
                end
                local steps = M.level_up_maintenance_plan_steps(plan)
                if type(steps) == "table"
                    and #steps > 0
                    and not M.level_up_maintenance_plan_done(kind, level, plan)
                then
                    if pending_levels[tostring(level)] ~= true then
                        count = count + 1
                    end
                    pending_levels[tostring(level)] = true
                    if kind == "skill" then
                        has_skill = true
                    elseif kind == "talent" then
                        has_talent = true
                    elseif kind == "contract" then
                        has_contract = true
                    end
                    kind_flags[kind] = true
                end
            end
        end
        if scanned >= 100 then
            break
        end
    end

    return pending_levels, has_skill, has_talent, count, has_contract, kind_flags
end

function M.level_up_maintenance_seed_next_missing_level_from_config(ctx, current_time, reason)
    local cfg = M.level_up_maintenance_config()
    if cfg.seed_next_missing_level_when_level_text_missing ~= true then
        return false, "disabled"
    end
    if state.level_up_maintenance_executor_active == true or M.level_up_maintenance_has_pending() then
        return false, "already_pending"
    end

    local seen = {}
    local levels = {}
    local function collect_levels(plans)
        if type(plans) ~= "table" then
            return
        end
        for level_key in pairs(plans) do
            local level = math.floor(tonumber(level_key) or 0)
            if level > 0 and seen[level] ~= true then
                seen[level] = true
                levels[#levels + 1] = level
            end
        end
    end
    for key, plans in pairs(cfg) do
        if type(key) == "string"
            and key:match("_by_level$")
            and type(plans) == "table"
        then
            collect_levels(plans)
        end
    end
    table.sort(levels)

    local order = M.level_up_maintenance_plan_order(cfg)
    for _, level in ipairs(levels) do
        local has_skill = false
        local has_talent = false
        local has_contract = false
        local kind_flags = {}
        for _, raw_kind in ipairs(order) do
            local kind = tostring(raw_kind or "")
            if M.level_up_maintenance_kind_enabled(cfg, kind) then
                local plan = M.level_up_maintenance_get_level_plan(cfg, kind, level)
                local steps = M.level_up_maintenance_plan_steps(plan)
                if type(steps) == "table"
                    and #steps > 0
                    and not M.level_up_maintenance_plan_done(kind, level, plan)
                then
                    if kind == "skill" then
                        has_skill = true
                    elseif kind == "talent" then
                        has_talent = true
                    elseif kind == "contract" then
                        has_contract = true
                    end
                    kind_flags[kind] = true
                end
            end
        end

        if next(kind_flags) ~= nil then
            state.level_up_maintenance_pending_levels = { [tostring(level)] = true }
            M.level_up_maintenance_replace_pending_kinds(kind_flags)
            state.level_up_maintenance_pending_since = tonumber(current_time) or now_ms(ctx)
            state.level_up_maintenance_safe_since = 0
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance seeded missing configured level | level=%d reason=%s skill=%s talent=%s contract=%s %s",
                level,
                tostring(reason or ""),
                has_skill and "true" or "false",
                has_talent and "true" or "false",
                has_contract and "true" or "false",
                M.level_up_maintenance_pending_summary()
            ))
            return true, nil
        end
    end

    return false, "no_missing_plan"
end

function M.level_up_maintenance_point_probe(cfg, kind, step)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    if type(step) == "table" and type(step.point_probe) == "table" then
        return step.point_probe
    end

    local normalized_kind = tostring(kind or "")
    if normalized_kind == "talent" and type(cfg.talent_point_probe) == "table" then
        return cfg.talent_point_probe
    end
    if normalized_kind == "skill" and type(cfg.skill_point_probe) == "table" then
        return cfg.skill_point_probe
    end
    return type(cfg.available_point_probe) == "table" and cfg.available_point_probe or {}
end

function M.level_up_maintenance_available_points(ctx, cfg, kind, step)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    local probe = M.level_up_maintenance_point_probe(cfg, kind, step)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_ui) ~= "function" then
        return nil, "nav.enum_ui is unavailable."
    end
    local ui, ui_err = nav_mod.enum_ui()
    if type(ui) ~= "table" or type(ui.texts) ~= "table" then
        return nil, tostring(ui_err or "enum_ui texts unavailable.")
    end

    local min_x = tonumber(probe.min_x)
    local max_x = tonumber(probe.max_x)
    local min_y = tonumber(probe.min_y)
    local max_y = tonumber(probe.max_y)
    local text_name_include = trim(probe.text_name_include or probe.name_include or "")
    local exact_name = trim(probe.exact_name or "")
    local best = nil
    for _, item in ipairs(ui.texts or {}) do
        local text = trim(type(item) == "table" and item.text or "")
        local name = tostring(type(item) == "table" and item.name or "")
        local fullname = tostring(type(item) == "table" and item.fullname or "")
        local identity = name .. " " .. fullname
        local name_matched = true
        if text_name_include ~= "" and not string.find(identity, text_name_include, 1, true) then
            name_matched = false
        end
        if exact_name ~= "" and name ~= exact_name and fullname ~= exact_name then
            name_matched = false
        end
        local value = nil
        if name_matched and text ~= "" then
            if probe.include_plain_number ~= false then
                value = tonumber(text:match("^%s*(%d+)%s*$") or "")
            end
            if value == nil then
                value = tonumber(text:match("(%d+)%s*\u{70B9}") or "")
            end
        end
        if type(value) == "number" then
            local x = tonumber(type(item) == "table" and item.x)
            local y = tonumber(type(item) == "table" and item.y)
            local in_bounds = true
            if min_x ~= nil and (x == nil or x < min_x) then
                in_bounds = false
            end
            if max_x ~= nil and (x == nil or x > max_x) then
                in_bounds = false
            end
            if min_y ~= nil and (y == nil or y < min_y) then
                in_bounds = false
            end
            if max_y ~= nil and (y == nil or y > max_y) then
                in_bounds = false
            end
            if in_bounds and (best == nil or value > (tonumber(best.value) or -1)) then
                best = {
                    value = value,
                    text = text,
                    x = x,
                    y = y,
                    name = name,
                    fullname = fullname,
                    kind = tostring(kind or "")
                }
            end
        end
    end

    if best == nil then
        return nil, "available point text not found."
    end
    return best.value, nil, best
end

function M.clear_level_up_maintenance_point_decrement_state()
    state.level_up_maintenance_point_decrement_step_key = nil
    state.level_up_maintenance_point_decrement_successes = nil
    state.level_up_maintenance_point_decrement_attempts = nil
    state.level_up_maintenance_point_decrement_verify_pending = nil
    state.level_up_maintenance_point_decrement_verify_attempts = nil
    state.level_up_maintenance_point_decrement_before = nil
end

function M.level_up_maintenance_step_requires_point_decrement(step)
    if tostring(state.level_up_maintenance_executor_kind or "") ~= "talent" then
        return false
    end
    if type(step) ~= "table" or step.verify_point_decrement == false then
        return false
    end
    if step.verify_point_decrement == true then
        return true
    end
    for _, pattern in ipairs(type(step.include_patterns) == "table" and step.include_patterns or {}) do
        local text = tostring(pattern or "")
        if text:find("TabTalentItem_C.WidgetTree.TipTalentItem.WidgetTree.ActiveBtn", 1, true) ~= nil
            or text:find("TabTalentItem_C.WidgetTree.TipTalentItem.WidgetTree.ActiveBtnGray", 1, true) ~= nil
        then
            return true
        end
    end
    return false
end

function M.level_up_maintenance_is_disabled_talent_activation_target(target)
    if type(target) ~= "table" then
        return false
    end
    local identity = (
        tostring(target.fullname or "")
            .. " "
            .. tostring(target.name or "")
            .. " "
            .. tostring(target.text or "")
    ):lower()
    return identity:find("tabtalentitem_c.widgettree.tiptalentitem.widgettree.activebtngray", 1, true) ~= nil
end

function M.level_up_maintenance_retry_wait_ms(cfg, step, field_name, fallback_ms)
    cfg = type(cfg) == "table" and cfg or {}
    step = type(step) == "table" and step or {}
    local wait_ms = tonumber(step[field_name])
        or tonumber(cfg[field_name])
        or tonumber(fallback_ms)
        or 100
    local cap_ms = tonumber(step.retry_wait_cap_ms) or tonumber(cfg.retry_wait_cap_ms)
    if type(cap_ms) == "number" and cap_ms > 0 and wait_ms > cap_ms then
        wait_ms = cap_ms
    end
    return math.max(100, wait_ms)
end

function M.level_up_maintenance_step_wait_ms(cfg, step, next_step)
    cfg = type(cfg) == "table" and cfg or {}
    step = type(step) == "table" and step or {}
    local wait_ms = tonumber(step.wait_after_ms) or tonumber(cfg.step_wait_ms) or 650
    if cfg.adaptive_step_wait_enabled == true
        and step.enforce_wait_after_ms ~= true
        and step.keep_wait_after_ms ~= true
    then
        local cap_ms = tonumber(step.adaptive_wait_after_ms) or tonumber(cfg.adaptive_step_wait_ms) or 120
        local next_action = tostring(type(next_step) == "table" and (next_step.kind or next_step.action) or "")
        if next_action == "type_text" then
            cap_ms = tonumber(step.adaptive_text_input_wait_ms)
                or tonumber(cfg.adaptive_text_input_wait_ms)
                or cap_ms
        end
        if wait_ms > cap_ms then
            wait_ms = cap_ms
        end
    end
    return math.max(100, wait_ms)
end

function M.level_up_maintenance_should_poll_target(step)
    if type(step) ~= "table" or step.disable_target_poll == true then
        return false
    end
    if step.missing_image_means_done == true
        or step.missing_image_means_step_done == true
    then
        return false
    end
    if step.missing_target_means_plan_done == true
        or step.missing_target_means_step_done == true
    then
        return step.poll_missing_target_before_done == true
    end
    return true
end

function M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
    cfg = type(cfg) == "table" and cfg or M.level_up_maintenance_config()
    local target, fetch_err = fetch_locator_button_target(ctx, step)
    if target or not M.level_up_maintenance_should_poll_target(step) then
        return target, fetch_err
    end
    local step_poll_count = type(step) == "table" and tonumber(step.target_poll_count) or nil
    local step_poll_interval_ms = type(step) == "table" and tonumber(step.target_poll_interval_ms) or nil
    local poll_count = math.max(0, math.floor(step_poll_count or tonumber(cfg.target_poll_count) or 30))
    local interval_ms = math.max(50,
        step_poll_interval_ms or tonumber(cfg.target_poll_interval_ms) or 100
    )
    for attempt = 1, poll_count do
        if type(sys) == "table" and type(sys.sleep) == "function" then
            sys.sleep(interval_ms)
        end
        target, fetch_err = fetch_locator_button_target(ctx, step)
        if target then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance target appeared during poll | kind=%s level=%s plan=%s key=%s attempt=%d/%d interval_ms=%d",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                tostring(type(step) == "table" and step.key or ""),
                attempt,
                poll_count,
                interval_ms
            ))
            return target, fetch_err
        end
    end

    local fixed_client_x = tonumber(type(step) == "table" and (step.fixed_fallback_client_x or step.fallback_fixed_client_x) or nil)
    local fixed_client_y = tonumber(type(step) == "table" and (step.fixed_fallback_client_y or step.fallback_fixed_client_y) or nil)
    local fixed_ratio_x = tonumber(type(step) == "table" and (step.fixed_fallback_ratio_x or step.fallback_fixed_ratio_x) or nil)
    local fixed_ratio_y = tonumber(type(step) == "table" and (step.fixed_fallback_ratio_y or step.fallback_fixed_ratio_y) or nil)
    if (fixed_client_x ~= nil and fixed_client_y ~= nil) or (fixed_ratio_x ~= nil and fixed_ratio_y ~= nil) then
        local fixed_step = {}
        for k, v in pairs(step) do
            fixed_step[k] = v
        end
        fixed_step.fixed_client_click = true
        fixed_step.fixed_client_x = fixed_client_x
        fixed_step.fixed_client_y = fixed_client_y
        fixed_step.fixed_ratio_x = fixed_ratio_x
        fixed_step.fixed_ratio_y = fixed_ratio_y
        fixed_step.fixed_prefer_ratio = step.fixed_fallback_prefer_ratio ~= false
        fixed_step.prefer_screen_click = step.fixed_fallback_prefer_screen_click ~= false
        fixed_step.mouse_mode = tostring(step.fixed_fallback_mouse_mode or step.mouse_mode or step.click_mode or "api")
        fixed_step.click_button = tostring(step.fixed_fallback_click_button or step.click_button or "left")
        fixed_step.click_delay_ms = tonumber(step.fixed_fallback_click_delay_ms or step.click_delay_ms) or 50
        fixed_step.hover_delay_ms = tonumber(step.fixed_fallback_hover_delay_ms or step.hover_delay_ms) or 80

        local fixed_target, fixed_err = M.resolve_fixed_client_click_target(ctx, fixed_step)
        if type(fixed_target) == "table" then
            logger(ctx).warn(string.format(
                "[Leveling] level-up maintenance target poll exhausted, using fixed client fallback | kind=%s level=%s plan=%s key=%s attempts=%d interval_ms=%d client=(%.2f, %.2f) err=%s",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                tostring(type(step) == "table" and step.key or ""),
                poll_count,
                interval_ms,
                tonumber(fixed_target.x) or 0,
                tonumber(fixed_target.y) or 0,
                tostring(fetch_err or "")
            ))
            return fixed_target, nil
        end
        return nil, string.format(
            "%s; fixed fallback failed: %s",
            tostring(fetch_err or "locator target unavailable"),
            tostring(fixed_err or "")
        )
    end

    return nil, fetch_err
end

function M.advance_level_up_maintenance_verified_point_step(ctx, current_time, steps, index, step, desired_count, after_points, before_points, point_meta)
    local successes = (tonumber(state.level_up_maintenance_point_decrement_successes) or 0) + 1
    state.level_up_maintenance_point_decrement_successes = successes
    state.level_up_maintenance_point_decrement_attempts = 0
    state.level_up_maintenance_point_decrement_verify_pending = false
    state.level_up_maintenance_point_decrement_verify_attempts = 0
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance talent point decrement confirmed | level=%s plan=%s step=%d/%d key=%s success=%d/%d before=%s after=%s text=%s",
        tostring(state.level_up_maintenance_executor_level or ""),
        tostring(state.level_up_maintenance_executor_plan_label or ""),
        index,
        #steps,
        tostring(step.key or ""),
        successes,
        desired_count,
        tostring(before_points),
        tostring(after_points),
        type(point_meta) == "table" and tostring(point_meta.text or "") or ""
    ))
    if successes >= desired_count then
        M.clear_level_up_maintenance_point_decrement_state()
        state.level_up_maintenance_executor_step_index = index + 1
        local cfg = M.level_up_maintenance_config()
        state.level_up_maintenance_executor_next_step_at = current_time
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
    else
        local cfg = M.level_up_maintenance_config()
        local retry_wait_ms = M.level_up_maintenance_retry_wait_ms(cfg, step, "point_decrement_success_wait_ms", 180)
        state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
    end
    return true
end

function M.progress_level_up_maintenance_point_decrement_step(ctx, current_time, steps, index, step)
    local cfg = M.level_up_maintenance_config()
    local step_key = table.concat({
        tostring(state.level_up_maintenance_executor_plan_key or ""),
        tostring(state.level_up_maintenance_executor_level or ""),
        tostring(index),
        tostring(step.key or "")
    }, ":")
    if tostring(state.level_up_maintenance_point_decrement_step_key or "") ~= step_key then
        M.clear_level_up_maintenance_point_decrement_state()
        state.level_up_maintenance_point_decrement_step_key = step_key
    end

    local desired_count = math.max(1, math.floor(tonumber(step.click_repeat_count or step.repeat_count) or 1))
    local retry_count = math.max(
        1,
        math.floor(math.max(
            tonumber(step.point_decrement_retry_count) or 0,
            tonumber(cfg.point_decrement_retry_count) or 10
        ))
    )
    local retry_wait_ms = M.level_up_maintenance_retry_wait_ms(cfg, step, "point_decrement_retry_wait_ms", 250)
    local verify_retry_count = math.max(
        1,
        math.floor(math.max(
            tonumber(step.point_decrement_verify_retry_count) or 0,
            tonumber(cfg.point_decrement_verify_retry_count) or 8
        ))
    )
    local verify_wait_ms = M.level_up_maintenance_retry_wait_ms(cfg, step, "point_decrement_verify_wait_ms", 220)

    if state.level_up_maintenance_point_decrement_verify_pending == true then
        local before_points = tonumber(state.level_up_maintenance_point_decrement_before)
        local after_points, point_err, point_meta = M.level_up_maintenance_available_points(ctx, cfg, "talent", step)
        if type(after_points) == "number" and before_points ~= nil and after_points <= before_points - 1 then
            return M.advance_level_up_maintenance_verified_point_step(
                ctx,
                current_time,
                steps,
                index,
                step,
                desired_count,
                after_points,
                before_points,
                point_meta
            )
        end

        local verify_attempts = tonumber(state.level_up_maintenance_point_decrement_verify_attempts) or 0
        if verify_attempts < verify_retry_count then
            state.level_up_maintenance_point_decrement_verify_attempts = verify_attempts + 1
            state.level_up_maintenance_executor_next_step_at = current_time + verify_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance waiting talent point decrement | level=%s plan=%s step=%d/%d key=%s verify=%d/%d before=%s after=%s err=%s",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                verify_attempts + 1,
                verify_retry_count,
                tostring(before_points or ""),
                tostring(after_points or ""),
                tostring(point_err or "")
            ))
            return true
        end

        if type(after_points) ~= "number" then
            return M.fail_level_up_maintenance_executor(
                ctx,
                current_time,
                "talent point decrement verify failed after click: before="
                    .. tostring(before_points or "")
                    .. " after="
                    .. tostring(after_points or "")
                    .. " err="
                    .. tostring(point_err or "")
            )
        end

        local attempts = tonumber(state.level_up_maintenance_point_decrement_attempts) or 0
        if attempts < retry_count then
            state.level_up_maintenance_point_decrement_attempts = attempts + 1
            state.level_up_maintenance_point_decrement_verify_pending = false
            state.level_up_maintenance_point_decrement_verify_attempts = 0
            state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance talent point decrement not confirmed; retry activation | level=%s plan=%s step=%d/%d key=%s attempts=%d/%d before=%s after=%s",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                attempts + 1,
                retry_count,
                tostring(before_points or ""),
                tostring(after_points or "")
            ))
            return true
        end

        return M.fail_level_up_maintenance_executor(
            ctx,
            current_time,
            "talent point decrement was not confirmed after activation retries: before="
                .. tostring(before_points or "")
                .. " after="
                .. tostring(after_points or "")
        )
    end

    local before_points, point_err, point_meta = M.level_up_maintenance_available_points(ctx, cfg, "talent", step)
    if type(before_points) ~= "number" then
        local attempts = tonumber(state.level_up_maintenance_point_decrement_attempts) or 0
        if attempts < retry_count then
            state.level_up_maintenance_point_decrement_attempts = attempts + 1
            state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance talent point read retry before click | level=%s plan=%s step=%d/%d key=%s attempts=%d/%d err=%s",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                attempts + 1,
                retry_count,
                tostring(point_err or "")
            ))
            return true
        end
        return M.fail_level_up_maintenance_executor(ctx, current_time, "talent point read failed before click: " .. tostring(point_err or ""))
    end

    if before_points < 1 then
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance no talent points before activation; finish plan | level=%s plan=%s step=%d/%d key=%s points=%s text=%s",
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            tostring(before_points),
            type(point_meta) == "table" and tostring(point_meta.text or "") or ""
        ))
        return M.finish_level_up_maintenance_executor(ctx, current_time)
    end

    local target, fetch_err = M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
    if not target then
        local attempts = tonumber(state.level_up_maintenance_point_decrement_attempts) or 0
        if attempts < retry_count then
            state.level_up_maintenance_point_decrement_attempts = attempts + 1
            state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance talent activation target retry | level=%s plan=%s step=%d/%d key=%s attempts=%d/%d err=%s",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                attempts + 1,
                retry_count,
                tostring(fetch_err or "")
            ))
            return true
        end
        return M.fail_level_up_maintenance_executor(ctx, current_time, "talent activation target fetch failed: " .. tostring(fetch_err or ""))
    end

    if M.level_up_maintenance_is_disabled_talent_activation_target(target) then
        local attempts = tonumber(state.level_up_maintenance_point_decrement_attempts) or 0
        if attempts < retry_count then
            state.level_up_maintenance_point_decrement_attempts = attempts + 1
            state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance talent activation target disabled retry | level=%s plan=%s step=%d/%d key=%s attempts=%d/%d addr=%s pos=(%s,%s)",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                attempts + 1,
                retry_count,
                tostring(target.addr or ""),
                tostring(target.x or ""),
                tostring(target.y or "")
            ))
            return true
        end
        return M.fail_level_up_maintenance_executor(
            ctx,
            current_time,
            "talent activation target is disabled/gray: " .. tostring(M.format_main_task_click_target_brief(target))
        )
    end

    local clicked, click_err = click_locator_button_target(ctx, step, target)
    if not clicked then
        local attempts = tonumber(state.level_up_maintenance_point_decrement_attempts) or 0
        if attempts < retry_count then
            state.level_up_maintenance_point_decrement_attempts = attempts + 1
            state.level_up_maintenance_executor_next_step_at = current_time + retry_wait_ms
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance talent activation click retry | level=%s plan=%s step=%d/%d key=%s attempts=%d/%d err=%s",
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                attempts + 1,
                retry_count,
                tostring(click_err or "")
            ))
            return true
        end
        return M.fail_level_up_maintenance_executor(ctx, current_time, "talent activation click failed: " .. tostring(click_err or ""))
    end

    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance talent activation clicked; awaiting point decrement | level=%s plan=%s step=%d/%d key=%s success=%d/%d before=%s addr=%s pos=(%s,%s)",
        tostring(state.level_up_maintenance_executor_level or ""),
        tostring(state.level_up_maintenance_executor_plan_label or ""),
        index,
        #steps,
        tostring(step.key or ""),
        tonumber(state.level_up_maintenance_point_decrement_successes) or 0,
        desired_count,
        tostring(before_points),
        tostring(type(target) == "table" and target.addr or ""),
        tostring(type(target) == "table" and target.x or ""),
        tostring(type(target) == "table" and target.y or "")
    ))
    state.level_up_maintenance_point_decrement_verify_pending = true
    state.level_up_maintenance_point_decrement_verify_attempts = 0
    state.level_up_maintenance_point_decrement_before = before_points
    state.level_up_maintenance_executor_next_step_at = current_time + verify_wait_ms
    return true
end

function M.clear_level_up_maintenance_executor_state()
    state.level_up_maintenance_executor_active = false
    state.level_up_maintenance_executor_started_at = nil
    state.level_up_maintenance_executor_paused_by_death_at = nil
    state.level_up_maintenance_executor_resume_after_revive = nil
    state.level_up_maintenance_treasure_start_executor_active = nil
    state.level_up_maintenance_executor_kind = nil
    state.level_up_maintenance_executor_level = nil
    state.level_up_maintenance_executor_plan_key = nil
    state.level_up_maintenance_executor_plan_label = nil
    state.level_up_maintenance_executor_steps = nil
    state.level_up_maintenance_executor_step_index = nil
    state.level_up_maintenance_executor_next_step_at = nil
    state.level_up_maintenance_executor_close_with_escape = nil
    state.level_up_maintenance_executor_close_pending = nil
    state.level_up_maintenance_executor_close_attempts = nil
    state.level_up_maintenance_executor_plan_done_pre_marked = nil
    state.level_up_maintenance_executor_point_check_miss_count = nil
    state.level_up_maintenance_executor_panel_open_retry_count = nil
    state.level_up_maintenance_executor_no_persist = nil
    state.level_up_maintenance_panel_open_death_guard_until = 0
    state.level_up_maintenance_panel_open_death_guard_wall_until = 0
    state.level_up_maintenance_panel_open_death_guard_step_key = nil
    state.level_up_maintenance_panel_open_death_guard_label = nil
    state.level_up_maintenance_panel_open_death_guard_kind = nil
    M.clear_level_up_maintenance_point_decrement_state()
end

function M.level_up_maintenance_executor_is_active()
    return state.level_up_maintenance_executor_active == true
end

function M.level_up_maintenance_step_opens_talent_panel(step)
    if type(step) ~= "table" then
        return false
    end
    local key = tostring(step.key or ""):lower()
    if key:find("open_talent_panel", 1, true) ~= nil then
        return true
    end
    if key:find("open_talent", 1, true) ~= nil then
        return true
    end
    local button_name = tostring(step.distance_button_name or ""):lower()
    if button_name:find("homebtnitem_c.widgettree.clickbtn", 1, true) ~= nil then
        local label = tostring(step.label or ""):lower()
        if label:find("talent", 1, true) ~= nil or label:find("天赋", 1, true) ~= nil then
            return true
        end
    end
    return false
end

function M.arm_level_up_maintenance_panel_open_death_guard(ctx, current_time, step, index, total_steps)
    if not M.level_up_maintenance_step_opens_talent_panel(step) then
        return false
    end
    local cfg = M.level_up_maintenance_config()
    local guard_ms = math.max(
        0,
        tonumber(step.panel_open_death_guard_ms)
            or tonumber(cfg.panel_open_death_guard_ms)
            or 0
    )
    if guard_ms <= 0 then
        return false
    end
    local event_now = tonumber(current_time) or now_ms(ctx)
    local wall_now = now_ms(ctx)
    state.level_up_maintenance_panel_open_death_guard_until = event_now + guard_ms
    state.level_up_maintenance_panel_open_death_guard_wall_until = wall_now + guard_ms
    state.level_up_maintenance_panel_open_death_guard_step_key = tostring(step.key or "")
    state.level_up_maintenance_panel_open_death_guard_label = tostring(step.label or "")
    state.level_up_maintenance_panel_open_death_guard_kind = tostring(state.level_up_maintenance_executor_kind or "")
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance panel-open death guard armed | kind=%s level=%s plan=%s step=%d/%d key=%s guard_ms=%d event_now=%d wall_now=%d",
        tostring(state.level_up_maintenance_executor_kind or ""),
        tostring(state.level_up_maintenance_executor_level or ""),
        tostring(state.level_up_maintenance_executor_plan_label or ""),
        tonumber(index) or 0,
        tonumber(total_steps) or 0,
        tostring(step.key or ""),
        guard_ms,
        event_now,
        wall_now
    ))
    return true
end

function M.level_up_maintenance_revive_panel_visible(ctx)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_ui) ~= "function" then
        return false, "nav.enum_ui unavailable"
    end
    local ui, enum_err = nav_mod.enum_ui()
    if type(ui) ~= "table" then
        return false, tostring(enum_err or "enum_ui failed")
    end

    local matches = 0
    local zero_matches = 0
    local buttons = type(ui.buttons) == "table" and ui.buttons or {}
    for _, item in ipairs(buttons) do
        local identity = table.concat({
            tostring(item and (item.Fullname or item.fullname) or ""),
            tostring(item and item.name or "")
        }, " "):lower()
        local is_revive_button = identity:find("fightfailure_c.widgettree.reenterrebornbtn", 1, true) ~= nil
            or identity:find("fightfailure_c.widgettree.insiderebornbtn", 1, true) ~= nil
        if is_revive_button then
            matches = matches + 1
            local addr = tonumber(item and item.addr)
            local x = tonumber(item and item.x)
            local y = tonumber(item and item.y)
            local has_visible_pos = x ~= nil and y ~= nil and not (math.abs(x) < 0.01 and math.abs(y) < 0.01)
            if addr ~= nil and addr ~= 0 and has_visible_pos then
                return true, string.format(
                    "revive_button_visible addr=%s pos=(%.1f,%.1f)",
                    tostring(addr),
                    x,
                    y
                )
            end
            zero_matches = zero_matches + 1
        end
    end

    return false, string.format(
        "revive_button_not_visible matches=%d zero=%d total_buttons=%d",
        matches,
        zero_matches,
        #buttons
    )
end

function M.level_up_maintenance_persisted_max_completed_level()
    if type(M.ensure_level_up_maintenance_state) ~= "function"
        or type(M.max_completed_plan_level) ~= "function"
    then
        return nil
    end
    local ok, persisted = pcall(M.ensure_level_up_maintenance_state)
    if not ok or type(persisted) ~= "table" then
        return nil
    end
    return M.max_completed_plan_level(persisted)
end

function M.reset_level_up_maintenance_runtime_boundary(ctx, current_time, reason, observed_level, progress, text)
    current_time = tonumber(current_time) or now_ms(ctx)
    local normalized_reason = tostring(reason or "")
    M.clear_level_up_maintenance_executor_state()
    state.level_up_maintenance_pending_levels = nil
    M.level_up_maintenance_clear_pending_kinds()
    state.level_up_maintenance_pending_since = 0
    state.level_up_maintenance_safe_since = 0
    state.level_up_maintenance_next_retry_at = 0
    state.level_up_maintenance_last_block_reason = nil
    state.level_up_maintenance_nearby_block_since = nil
    state.level_up_maintenance_default_skill_min_pending_level = nil
    state.level_up_maintenance_completed_plans = nil
    state.level_up_maintenance_skipped_plans = nil
    state.level_up_maintenance_last_level = math.floor(tonumber(observed_level) or 0)
    state.level_up_maintenance_last_progress = progress
    state.level_up_maintenance_last_level_text = text
    state.level_up_maintenance_boundary_reset_at = current_time
    state.level_up_maintenance_boundary_reset_reason = normalized_reason
    if normalized_reason == "level_below_persisted_completed"
        or normalized_reason == "identity_level_drop"
        or normalized_reason == "observed_level_decreased"
    then
        state.level_up_maintenance_ignore_persisted_completed_after_level_reset = true
        state.level_up_maintenance_ignore_persisted_completed_reason = normalized_reason
        state.level_up_maintenance_level_reset_persisted_max_level =
            M.level_up_maintenance_persisted_max_completed_level()
    end
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance runtime reset at character boundary | reason=%s level=%s progress=%s text=%s character_id=%s",
        tostring(reason or ""),
        tostring(observed_level or ""),
        progress ~= nil and tostring(progress) or "",
        tostring(text or ""),
        tostring(type(M.current_persistence_character_id) == "function" and M.current_persistence_character_id() or "")
    ))
    return true
end

function M.level_up_maintenance_step_is_back_button(step)
    if type(step) ~= "table" then
        return false
    end
    local step_key = tostring(step.key or ""):lower()
    local step_label = tostring(step.label or ""):lower()
    if step_key:find("back", 1, true) ~= nil
        or step_label:find("\u{8FD4}\u{56DE}", 1, true) ~= nil
        or step_label:find("\u{8FD4}\u{56DE}", 1, true) ~= nil
    then
        return true
    end
    if type(step.include_patterns) == "table" then
        for _, pattern in ipairs(step.include_patterns) do
            if tostring(pattern or ""):lower():find("btnback", 1, true) ~= nil then
                return true
            end
        end
    end
    return false
end

function M.try_click_level_up_maintenance_back_button(ctx, reason)
    local steps = type(state.level_up_maintenance_executor_steps) == "table"
        and state.level_up_maintenance_executor_steps
        or {}
    for cleanup_index = #steps, 1, -1 do
        local cleanup_step = steps[cleanup_index]
        local cleanup_key = tostring(type(cleanup_step) == "table" and cleanup_step.key or ""):lower()
        local cleanup_label = tostring(type(cleanup_step) == "table" and cleanup_step.label or ""):lower()
        local is_back_step = cleanup_key:find("back", 1, true) ~= nil
            or cleanup_label:find("返回", 1, true) ~= nil
        if not is_back_step and type(cleanup_step) == "table" and type(cleanup_step.include_patterns) == "table" then
            for _, pattern in ipairs(cleanup_step.include_patterns) do
                if tostring(pattern or ""):lower():find("btnback", 1, true) ~= nil then
                    is_back_step = true
                    break
                end
            end
        end
        if is_back_step then
            local cleanup_target, cleanup_fetch_err = fetch_locator_button_target(ctx, cleanup_step)
            if cleanup_target then
                local clicked, cleanup_click_err = click_locator_button_target(ctx, cleanup_step, cleanup_target)
                if clicked then
                    logger(ctx).info(string.format(
                        "[Leveling] level-up maintenance cleanup button clicked | reason=%s label=%s addr=%s pos=(%s,%s)",
                        tostring(reason or ""),
                        tostring(cleanup_step.label or cleanup_step.key or ""),
                        tostring(type(cleanup_target) == "table" and cleanup_target.addr or ""),
                        tostring(type(cleanup_target) == "table" and cleanup_target.x or ""),
                        tostring(type(cleanup_target) == "table" and cleanup_target.y or "")
                    ))
                    return true
                end
                logger(ctx).warn(
                    "[Leveling] level-up maintenance cleanup button click failed: "
                    .. tostring(cleanup_click_err or "")
                )
                return false, cleanup_click_err
            end
            logger(ctx).warn(
                "[Leveling] level-up maintenance cleanup button fetch failed: "
                .. tostring(cleanup_fetch_err or "")
            )
            return false, cleanup_fetch_err
        end
    end
    return false, "cleanup back button step not found."
end

function M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, reason)
    if type(step) ~= "table" then
        return false, "step unavailable"
    end

    local opts = step.post_image_done_mouse_away
    if opts == nil or opts == false then
        return false, "post image mouse-away disabled"
    end
    if opts == true then
        opts = {}
    end
    if type(opts) ~= "table" then
        return false, "post image mouse-away options invalid"
    end

    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.move_mouse_to_client) ~= "function" then
        return false, "nav.move_mouse_to_client is unavailable"
    end

    local wnd_api = type(ctx) == "table" and ctx.wnd or wnd
    local client_w = nil
    local client_h = nil
    if type(nav_mod.window_hwnd) == "function"
        and type(wnd_api) == "table"
        and type(wnd_api.client_rect) == "function"
    then
        local hwnd = select(1, nav_mod.window_hwnd())
        if hwnd then
            local _, _, width, height = wnd_api.client_rect(hwnd)
            if type(width) == "number" and type(height) == "number" and width > 0 and height > 0 then
                client_w = width
                client_h = height
            end
        end
    end

    local left = tonumber(opts.rect_left) or tonumber(opts.left) or 1171
    local top = tonumber(opts.rect_top) or tonumber(opts.top) or 7
    local right = tonumber(opts.rect_right) or tonumber(opts.right) or 1436
    local bottom = tonumber(opts.rect_bottom) or tonumber(opts.bottom) or 127
    if left > right then
        left, right = right, left
    end
    if top > bottom then
        top, bottom = bottom, top
    end

    local should_move = true
    local cursor_x = nil
    local cursor_y = nil
    if opts.move_if_inside_only ~= false and type(nav_mod.cursor_client_pos) == "function" then
        local cursor = select(1, nav_mod.cursor_client_pos({
            allow_outside = true
        }))
        if type(cursor) == "table" then
            cursor_x = tonumber(cursor.client_x)
            cursor_y = tonumber(cursor.client_y)
            should_move = cursor_x ~= nil
                and cursor_y ~= nil
                and cursor_x >= left
                and cursor_x <= right
                and cursor_y >= top
                and cursor_y <= bottom
        end
    end

    if not should_move then
        return false, "cursor outside configured rectangle"
    end

    local function is_outside_mouse_away_rect(x, y)
        return type(x) == "number"
            and type(y) == "number"
            and not (x >= left and x <= right and y >= top and y <= bottom)
    end

    local target_x = tonumber(opts.target_client_x) or tonumber(opts.client_x)
    local target_y = tonumber(opts.target_client_y) or tonumber(opts.client_y)
    local random_target_used = false
    if opts.random_target == true then
        local target_regions = opts.target_regions or opts.random_target_regions or opts.random_regions
        if type(target_regions) == "table" and #target_regions > 0 then
            local start_index = M.random_int(1, #target_regions)
            for offset = 0, #target_regions - 1 do
                local region = target_regions[((start_index + offset - 2) % #target_regions) + 1]
                if type(region) == "table" then
                    local region_left = tonumber(region.left) or tonumber(region.rect_left) or tonumber(region.client_left) or tonumber(region[1])
                    local region_top = tonumber(region.top) or tonumber(region.rect_top) or tonumber(region.client_top) or tonumber(region[2])
                    local region_right = tonumber(region.right) or tonumber(region.rect_right) or tonumber(region.client_right) or tonumber(region[3])
                    local region_bottom = tonumber(region.bottom) or tonumber(region.rect_bottom) or tonumber(region.client_bottom) or tonumber(region[4])
                    if region_left ~= nil and region_top ~= nil and region_right ~= nil and region_bottom ~= nil then
                        if region_left > region_right then
                            region_left, region_right = region_right, region_left
                        end
                        if region_top > region_bottom then
                            region_top, region_bottom = region_bottom, region_top
                        end

                        local candidate_x = M.random_float(region_left, region_right)
                        local candidate_y = M.random_float(region_top, region_bottom)
                        if is_outside_mouse_away_rect(candidate_x, candidate_y) then
                            target_x = candidate_x
                            target_y = candidate_y
                            random_target_used = true
                            break
                        end
                    end
                end
            end
        end
    end

    local ratio_x = tonumber(opts.target_ratio_x) or tonumber(opts.ratio_x)
    local ratio_y = tonumber(opts.target_ratio_y) or tonumber(opts.ratio_y)
    if not random_target_used and client_w ~= nil and client_h ~= nil and ratio_x ~= nil and ratio_y ~= nil then
        target_x = ratio_x * client_w
        target_y = ratio_y * client_h
    end
    target_x = target_x or math.max(0, left - 90)
    target_y = target_y or (bottom + 40)

    local moved, move_err = nav_mod.move_mouse_to_client(target_x, target_y, {
        mouse_mode = tostring(opts.mouse_mode or "api"),
        min_duration_ms = tonumber(opts.min_duration_ms) or 20,
        max_duration_ms = tonumber(opts.max_duration_ms) or 60,
        hover_ms = tonumber(opts.hover_ms) or 60,
        set_foreground = opts.set_foreground ~= false
    })
    if moved then
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance image cleanup moved mouse away | reason=%s step_key=%s from=(%s,%s) rect=(%.2f,%.2f)-(%.2f,%.2f) target=(%.2f,%.2f) random=%s",
            tostring(reason or ""),
            tostring(step.key or ""),
            tostring(cursor_x or ""),
            tostring(cursor_y or ""),
            tonumber(left) or 0,
            tonumber(top) or 0,
            tonumber(right) or 0,
            tonumber(bottom) or 0,
            tonumber(target_x) or 0,
            tonumber(target_y) or 0,
            tostring(random_target_used == true)
        ))
        return true
    end

    log_throttled(ctx, "level_up_image_mouse_away_failed", "info", LOG_THROTTLE_MS,
        "[Leveling] level-up maintenance image cleanup mouse-away failed: " .. tostring(move_err or ""))
    return false, move_err
end

function M.level_up_maintenance_mark_current_plan_done_early(ctx, reason)
    if state.level_up_maintenance_executor_plan_done_pre_marked == true then
        return true
    end
    local kind = tostring(state.level_up_maintenance_executor_kind or "")
    local level = math.floor(tonumber(state.level_up_maintenance_executor_level) or 0)
    local plan_key = tostring(state.level_up_maintenance_executor_plan_key or "")
    if kind == "" or level <= 0 or plan_key == "" then
        return false
    end
    local plan = {
        key = plan_key,
        label = tostring(state.level_up_maintenance_executor_plan_label or plan_key)
    }
    if state.level_up_maintenance_executor_plan_done_pre_marked ~= true then
        M.level_up_maintenance_mark_plan_done(kind, level, plan, ctx)
    end
    state.level_up_maintenance_executor_plan_done_pre_marked = true
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance plan completion marked early | persist=%s reason=%s kind=%s level=%d plan=%s",
        tostring(not (state.level_up_maintenance_executor_no_persist == true
            or (ctx ~= nil and ctx.level_up_maintenance_no_persist == true))),
        tostring(reason or ""),
        kind,
        level,
        tostring(plan.label or plan_key)
    ))
    return true
end

function M.level_up_maintenance_clear_pending_if_done(ctx)
    local cfg = M.level_up_maintenance_config()
    if M.level_up_maintenance_find_next_plan(cfg) ~= nil then
        return false
    end
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance plans complete or unavailable; clear pending | %s",
        M.level_up_maintenance_pending_summary()
    ))
    state.level_up_maintenance_pending_levels = nil
    M.level_up_maintenance_clear_pending_kinds()
    state.level_up_maintenance_pending_since = 0
    state.level_up_maintenance_safe_since = 0
    state.level_up_maintenance_completed_plans = nil
    state.level_up_maintenance_default_skill_min_pending_level = nil
    state.level_up_maintenance_treasure_start_sequence_active = nil
    state.level_up_maintenance_treasure_start_executor_active = nil
    return true
end

function M.start_level_up_maintenance_executor(ctx, current_time, plan_info)
    if type(plan_info) ~= "table" or type(plan_info.steps) ~= "table" or #plan_info.steps <= 0 then
        return false, "invalid level-up maintenance plan"
    end
    current_time = tonumber(current_time) or now_ms(ctx)
    local plan = type(plan_info.plan) == "table" and plan_info.plan or {}
    state.level_up_maintenance_executor_active = true
    state.level_up_maintenance_executor_started_at = current_time
    state.level_up_maintenance_executor_kind = tostring(plan_info.kind or "")
    state.level_up_maintenance_executor_level = math.floor(tonumber(plan_info.level) or 0)
    state.level_up_maintenance_executor_plan_key = tostring(plan.key or plan_info.id or "")
    state.level_up_maintenance_executor_plan_label = tostring(plan.label or plan.key or plan_info.id or "")
    state.level_up_maintenance_executor_steps = plan_info.steps
    state.level_up_maintenance_executor_step_index = 1
    state.level_up_maintenance_executor_next_step_at = current_time
    state.level_up_maintenance_executor_close_with_escape = plan.close_with_escape == true
    state.level_up_maintenance_executor_close_pending = false
    state.level_up_maintenance_executor_close_attempts = 0
    state.level_up_maintenance_executor_plan_done_pre_marked = nil
    state.level_up_maintenance_executor_point_check_miss_count = 0
    state.level_up_maintenance_executor_panel_open_retry_count = 0
    state.level_up_maintenance_executor_no_persist =
        plan_info.no_persist == true or (ctx ~= nil and ctx.level_up_maintenance_no_persist == true)
    state.level_up_maintenance_executor_last_result = nil
    M.clear_level_up_maintenance_point_decrement_state()
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance executor started | kind=%s level=%d plan=%s steps=%d",
        tostring(state.level_up_maintenance_executor_kind or ""),
        tonumber(state.level_up_maintenance_executor_level) or 0,
        tostring(state.level_up_maintenance_executor_plan_label or ""),
        #plan_info.steps
    ))
    return true
end

function M.fail_level_up_maintenance_executor(ctx, current_time, err)
    current_time = tonumber(current_time) or now_ms(ctx)
    local kind = tostring(state.level_up_maintenance_executor_kind or "")
    local level = math.floor(tonumber(state.level_up_maintenance_executor_level) or 0)
    local plan = {
        key = tostring(state.level_up_maintenance_executor_plan_key or ""),
        label = tostring(state.level_up_maintenance_executor_plan_label or "")
    }
    logger(ctx).warn(string.format(
        "[Leveling] level-up maintenance executor failed; plan will not retry this run | kind=%s level=%s plan=%s step=%s err=%s",
        kind,
        tostring(level),
        tostring(plan.label or ""),
        tostring(state.level_up_maintenance_executor_step_index or ""),
        tostring(err or "")
    ))
    M.level_up_maintenance_skip_plan_for_run(kind, level, plan, ctx, err)
    state.level_up_maintenance_executor_last_result = {
        completed = false,
        kind = kind,
        level = level,
        plan_id = M.level_up_maintenance_plan_id(kind, level, plan),
        error = tostring(err or "")
    }
    local cleanup_clicked = false
    if (tonumber(state.level_up_maintenance_executor_step_index) or 1) > 1 then
        cleanup_clicked = M.try_click_level_up_maintenance_back_button(ctx, "executor_failed") == true
    end
    if state.level_up_maintenance_executor_close_with_escape == true
        and type(press_keyboard_hotkey) == "function"
        and (tonumber(state.level_up_maintenance_executor_step_index) or 1) > 1
    then
        if not cleanup_clicked then
            local suppress_escape, suppress_detail = false, ""
            if type(M.is_task_button_ready_for_escape_guard) == "function" then
                suppress_escape, suppress_detail = M.is_task_button_ready_for_escape_guard(
                    ctx,
                    nil,
                    "level-up maintenance cleanup"
                )
            end
            if suppress_escape then
                logger(ctx).info("[Leveling] level-up maintenance cleanup ESC suppressed | " .. tostring(suppress_detail or ""))
            else
                local ok, close_err = press_keyboard_hotkey(ctx, current_time, VK_ESCAPE, "level-up maintenance cleanup")
                if not ok then
                    logger(ctx).warn("[Leveling] level-up maintenance cleanup ESC failed: " .. tostring(close_err or ""))
                else
                    logger(ctx).info("[Leveling] level-up maintenance cleanup ESC pressed")
                end
            end
        end
    end
    M.clear_level_up_maintenance_executor_state()
    state.level_up_maintenance_next_retry_at = current_time + 500
    local all_done = M.level_up_maintenance_clear_pending_if_done(ctx)
    if all_done and type(schedule_task_refresh_after_transition) == "function" then
        state.stage = "level_up_maintenance_failed_reacquire_task"
        state.level_up_maintenance_safe_since = 0
        state.level_up_maintenance_last_block_reason = nil
        state.level_up_maintenance_nearby_block_since = nil
        release_async_combat_inputs(ctx, current_time, true)
        schedule_task_refresh_after_transition(ctx, current_time, "level_up_maintenance_failed", TASK_BUTTON_SETTLE_MS, {
            force_task_call = true
        })
    end
    return true
end

function M.defer_level_up_maintenance_panel_open_retry(ctx, current_time, reason, step)
    current_time = tonumber(current_time) or now_ms(ctx)
    local cfg = M.level_up_maintenance_config()
    local retry_count = (tonumber(state.level_up_maintenance_executor_panel_open_retry_count) or 0) + 1
    local max_retries = math.max(1, tonumber(
        type(step) == "table" and step.panel_open_max_retry_count
            or type(step) == "table" and step.max_retry_count
            or type(cfg) == "table" and cfg.panel_open_max_retry_count
    ) or 6)
    if retry_count > max_retries then
        return M.fail_level_up_maintenance_executor(
            ctx,
            current_time,
            string.format(
                "ensure_panel_open retry exhausted after %d attempts: %s",
                max_retries,
                tostring(reason or "")
            )
        )
    end

    local retry_ms = math.max(200, tonumber(
        type(step) == "table" and step.panel_open_retry_ms
            or type(step) == "table" and step.retry_ms
            or type(cfg) == "table" and cfg.panel_open_retry_ms
    ) or 800)
    state.level_up_maintenance_executor_panel_open_retry_count = retry_count
    state.level_up_maintenance_executor_next_step_at = current_time + retry_ms
    state.level_up_maintenance_next_retry_at = current_time + retry_ms
    release_async_combat_inputs(ctx, current_time, true)
    hold_navigation(ctx, current_time, "level_up_maintenance_panel_open_retry")
    logger(ctx).warn(string.format(
        "[Leveling] level-up maintenance panel open deferred; keep plan pending | kind=%s level=%s plan=%s step=%s retry=%d/%d wait=%dms reason=%s",
        tostring(state.level_up_maintenance_executor_kind or ""),
        tostring(state.level_up_maintenance_executor_level or ""),
        tostring(state.level_up_maintenance_executor_plan_label or ""),
        tostring(state.level_up_maintenance_executor_step_index or ""),
        retry_count,
        max_retries,
        retry_ms,
        tostring(reason or "")
    ))
    return true
end

function M.finish_level_up_maintenance_executor(ctx, current_time)
    current_time = tonumber(current_time) or now_ms(ctx)
    local kind = tostring(state.level_up_maintenance_executor_kind or "")
    local level = math.floor(tonumber(state.level_up_maintenance_executor_level) or 0)
    local plan_key = tostring(state.level_up_maintenance_executor_plan_key or "")
    local plan = {
        key = plan_key,
        label = tostring(state.level_up_maintenance_executor_plan_label or plan_key)
    }
    if state.level_up_maintenance_executor_plan_done_pre_marked ~= true then
        M.level_up_maintenance_mark_plan_done(kind, level, plan, ctx)
    end
    state.level_up_maintenance_executor_last_result = {
        completed = true,
        kind = kind,
        level = level,
        plan_id = M.level_up_maintenance_plan_id(kind, level, plan)
    }
    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance executor completed | kind=%s level=%d plan=%s",
        kind,
        level,
        tostring(plan.label or plan_key)
    ))
    M.clear_level_up_maintenance_executor_state()
    local cfg = M.level_up_maintenance_config()
    if M.level_up_maintenance_find_next_plan(cfg) ~= nil then
        state.level_up_maintenance_next_retry_at = current_time
    else
        state.level_up_maintenance_next_retry_at = current_time + 500
    end
    local all_done = M.level_up_maintenance_clear_pending_if_done(ctx)
    if all_done and type(schedule_task_refresh_after_transition) == "function" then
        state.stage = "level_up_maintenance_reacquire_task"
        state.level_up_maintenance_safe_since = 0
        state.level_up_maintenance_last_block_reason = nil
        state.level_up_maintenance_nearby_block_since = nil
        release_async_combat_inputs(ctx, current_time, true)
        schedule_task_refresh_after_transition(ctx, current_time, "level_up_maintenance_complete", TASK_BUTTON_SETTLE_MS, {
            force_task_call = true
        })
    end
    return true
end

function M.progress_level_up_maintenance_executor(ctx, current_time)
    if state.level_up_maintenance_executor_active ~= true then
        return false
    end
    current_time = tonumber(current_time) or now_ms(ctx)
    local executor_cfg = M.level_up_maintenance_config()
    local started_at = tonumber(state.level_up_maintenance_executor_started_at) or 0
    local executor_timeout_ms = tonumber(executor_cfg.executor_timeout_ms) or 90000
    if executor_timeout_ms > 0
        and started_at > 0
        and current_time - started_at > executor_timeout_ms
    then
        return M.fail_level_up_maintenance_executor(
            ctx,
            current_time,
            string.format(
                "executor timeout after %dms; kind=%s level=%s plan=%s step=%s",
                math.floor(current_time - started_at),
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                tostring(state.level_up_maintenance_executor_step_index or "")
            )
        )
    end
    state.stage = "level_up_maintenance"
    if current_time < (tonumber(state.level_up_maintenance_executor_next_step_at) or 0) then
        return true
    end

    if state.level_up_maintenance_executor_close_pending == true then
        local attempts = tonumber(state.level_up_maintenance_executor_close_attempts) or 0
        local ok, err = true, nil
        local suppress_escape, suppress_detail = false, ""
        if type(M.is_task_button_ready_for_escape_guard) == "function" then
            suppress_escape, suppress_detail = M.is_task_button_ready_for_escape_guard(
                ctx,
                nil,
                "level-up maintenance close"
            )
        end
        if suppress_escape then
            logger(ctx).info("[Leveling] level-up maintenance close ESC suppressed | " .. tostring(suppress_detail or ""))
        elseif type(press_keyboard_hotkey) == "function" then
            ok, err = press_keyboard_hotkey(ctx, current_time, VK_ESCAPE, "level-up maintenance close")
        end
        if ok then
            return M.finish_level_up_maintenance_executor(ctx, current_time)
        end
        state.level_up_maintenance_executor_close_attempts = attempts + 1
        if attempts >= 2 then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "close_with_escape failed: " .. tostring(err or ""))
        end
        state.level_up_maintenance_executor_next_step_at = current_time + 500
        return true
    end

    local steps = type(state.level_up_maintenance_executor_steps) == "table"
        and state.level_up_maintenance_executor_steps
        or {}
    local index = math.floor(tonumber(state.level_up_maintenance_executor_step_index) or 1)
    if index > #steps then
        if state.level_up_maintenance_executor_close_with_escape == true then
            state.level_up_maintenance_executor_close_pending = true
            state.level_up_maintenance_executor_next_step_at = current_time
            return true
        end
        return M.finish_level_up_maintenance_executor(ctx, current_time)
    end

    local step = steps[index]
    if type(step) ~= "table" then
        return M.fail_level_up_maintenance_executor(ctx, current_time, "invalid step table")
    end

    local step_action = tostring(step.kind or step.action or "")
    if step_action == "ensure_panel_open" then
        local key_vk = tonumber(step.key_vk or step.vk or step.hotkey_vk)
        if key_vk == nil then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "ensure_panel_open step missing key_vk")
        end
        if type(press_keyboard_hotkey) ~= "function" then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "ensure_panel_open unavailable")
        end

        local cfg = M.level_up_maintenance_config()
        local label = tostring(step.label or step.key or "level-up maintenance panel")
        local target, fetch_err = M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
        if type(target) ~= "table" then
            local ok, press_err = press_keyboard_hotkey(ctx, current_time, key_vk, label)
            if not ok then
                return M.fail_level_up_maintenance_executor(ctx, current_time, "ensure_panel_open key failed: " .. tostring(press_err or ""))
            end

            local open_wait_ms = math.max(0, tonumber(step.open_wait_ms) or 180)
            if open_wait_ms > 0 and type(sys) == "table" and type(sys.sleep) == "function" then
                sys.sleep(open_wait_ms)
            end

            local timeout_ms = math.max(0, tonumber(step.verify_timeout_ms or step.timeout_ms) or 2500)
            local poll_ms = math.max(50, tonumber(step.verify_poll_ms or step.poll_ms) or 100)
            local deadline = now_ms(ctx) + timeout_ms
            local attempts = 0
            while true do
                attempts = attempts + 1
                target, fetch_err = M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
                if type(target) == "table" then
                    logger(ctx).info(string.format(
                        "[Leveling] level-up maintenance panel opened by hotkey | kind=%s level=%s plan=%s step=%d/%d key=%s vk=%s attempts=%d addr=%s pos=(%s,%s)",
                        tostring(state.level_up_maintenance_executor_kind or ""),
                        tostring(state.level_up_maintenance_executor_level or ""),
                        tostring(state.level_up_maintenance_executor_plan_label or ""),
                        index,
                        #steps,
                        tostring(step.key or ""),
                        tostring(key_vk),
                        attempts,
                        tostring(target.addr or ""),
                        tostring(target.x or ""),
                        tostring(target.y or "")
                    ))
                    break
                end

                local now = now_ms(ctx)
                if now >= deadline then
                    return M.defer_level_up_maintenance_panel_open_retry(
                        ctx,
                        current_time,
                        "ensure_panel_open verify timeout: " .. tostring(fetch_err or ""),
                        step
                    )
                end
                if type(sys) == "table" and type(sys.sleep) == "function" then
                    sys.sleep(math.min(poll_ms, math.max(50, deadline - now)))
                else
                    return M.fail_level_up_maintenance_executor(ctx, current_time, "ensure_panel_open failed: sleep unavailable")
                end
            end
        else
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance panel already open | kind=%s level=%s plan=%s step=%d/%d key=%s addr=%s pos=(%s,%s)",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                tostring(target.addr or ""),
                tostring(target.x or ""),
                tostring(target.y or "")
            ))
        end

        state.level_up_maintenance_executor_step_index = index + 1
        state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
        return true
    end

    if step_action == "press_key" then
        local key_vk = tonumber(step.key_vk or step.vk or step.hotkey_vk)
        if key_vk == nil then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "press_key step missing key_vk")
        end
        if type(press_keyboard_hotkey) ~= "function" then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "press_key unavailable")
        end

        local label = tostring(step.label or step.key or "level-up maintenance key")
        local ok, press_err = press_keyboard_hotkey(ctx, current_time, key_vk, label)
        if not ok then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "press_key failed: " .. tostring(press_err or ""))
        end

        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance key pressed | kind=%s level=%s plan=%s step=%d/%d key=%s vk=%s label=%s",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            tostring(key_vk),
            label
        ))
        state.level_up_maintenance_executor_step_index = index + 1
        local cfg = M.level_up_maintenance_config()
        state.level_up_maintenance_executor_next_step_at = current_time
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
        return true
    end

    if step_action == "verify_target" then
        local expected_present = step.expected_present ~= false
        local timeout_ms = math.max(0, tonumber(step.verify_timeout_ms or step.timeout_ms) or 3000)
        local poll_ms = math.max(50, tonumber(step.verify_poll_ms or step.poll_ms) or 100)
        local deadline = current_time + timeout_ms
        local cfg = M.level_up_maintenance_config()
        local last_err = nil
        local attempts = 0

        while true do
            attempts = attempts + 1
            local target, fetch_err = M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
            last_err = fetch_err
            local present = type(target) == "table"
            if (expected_present and present) or ((not expected_present) and not present) then
                logger(ctx).info(string.format(
                    "[Leveling] level-up maintenance target verified | kind=%s level=%s plan=%s step=%d/%d key=%s expected_present=%s attempts=%d addr=%s pos=(%s,%s)",
                    tostring(state.level_up_maintenance_executor_kind or ""),
                    tostring(state.level_up_maintenance_executor_level or ""),
                    tostring(state.level_up_maintenance_executor_plan_label or ""),
                    index,
                    #steps,
                    tostring(step.key or ""),
                    tostring(expected_present),
                    attempts,
                    tostring(present and target.addr or ""),
                    tostring(present and target.x or ""),
                    tostring(present and target.y or "")
                ))
                state.level_up_maintenance_executor_step_index = index + 1
                state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
                    + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
                return true
            end

            local now = now_ms(ctx)
            if now >= deadline then
                return M.fail_level_up_maintenance_executor(
                    ctx,
                    current_time,
                    string.format(
                        "verify_target timeout: expected_present=%s err=%s",
                        tostring(expected_present),
                        tostring(last_err or "")
                    )
                )
            end
            if type(sys) == "table" and type(sys.sleep) == "function" then
                sys.sleep(math.min(poll_ms, math.max(50, deadline - now)))
            else
                break
            end
        end

        return M.fail_level_up_maintenance_executor(
            ctx,
            current_time,
            "verify_target failed: sleep unavailable"
        )
    end

    if step_action == "type_text" then
        local text = tostring(step.text or step.input_text or "")
        if text == "" then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "type_text step has empty text")
        end

        local _, input_err = nil, nil
        if type(prepare_key_input) == "function" then
            _, input_err = prepare_key_input({})
        elseif type(keybd) ~= "table" then
            input_err = "keybd is unavailable."
        end
        if input_err ~= nil then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "type_text prepare failed: " .. tostring(input_err))
        end

        local key_delay = math.max(0, tonumber(step.key_delay_ms) or 30)
        if step.clear_before == true and type(keybd) == "table" then
            if type(keybd.combo) == "function" then
                keybd.combo({ 0x11, 0x41 }, key_delay)
                sys.sleep(tonumber(step.clear_wait_ms) or 60)
            end
            if type(keybd.click) == "function" then
                keybd.click(0x08, key_delay)
                sys.sleep(tonumber(step.clear_wait_ms) or 60)
            end
        end

        local ok, type_err = nil, nil
        local method = tostring(step.input_method or "clipboard")
        if method == "clipboard" and type(sys) == "table" and type(sys.set_clipboard) == "function" and type(keybd) == "table" and type(keybd.combo) == "function" then
            local old_clipboard = type(sys.get_clipboard) == "function" and sys.get_clipboard() or nil
            local set_ok = sys.set_clipboard(text)
            if set_ok then
                sys.sleep(tonumber(step.paste_wait_ms) or 80)
                ok = keybd.combo({ 0x11, 0x56 }, key_delay)
                if not ok then
                    type_err = "keybd.combo(Ctrl+V) failed."
                end
                if old_clipboard ~= nil and step.restore_clipboard ~= false then
                    sys.sleep(tonumber(step.restore_wait_ms) or 80)
                    sys.set_clipboard(old_clipboard)
                end
            else
                type_err = "sys.set_clipboard failed."
            end
        elseif type(keybd) == "table" and type(keybd.type) == "function" then
            ok = keybd.type(text, key_delay)
            if not ok then
                type_err = "keybd.type failed."
            end
        else
            type_err = "no text input method available."
        end

        if not ok then
            return M.fail_level_up_maintenance_executor(ctx, current_time, "type_text failed: " .. tostring(type_err or ""))
        end

        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance text input | kind=%s level=%s plan=%s step=%d/%d key=%s text=%s method=%s",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            text,
            method
        ))
        state.level_up_maintenance_executor_step_index = index + 1
        local cfg = M.level_up_maintenance_config()
        state.level_up_maintenance_executor_next_step_at = current_time
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
        return true
    end

    if step_action == "check_available_points" then
        local cfg = M.level_up_maintenance_config()
        local point_kind = tostring(step.point_kind or state.level_up_maintenance_executor_kind or "")
        local points, point_err, point_meta = M.level_up_maintenance_available_points(ctx, cfg, point_kind, step)
        local probe = M.level_up_maintenance_point_probe(cfg, point_kind, step)
        local min_value = math.max(1, tonumber(step.min_value) or tonumber(probe.min_value) or 1)
        if type(points) ~= "number" then
            local attempts = tonumber(state.level_up_maintenance_executor_point_check_miss_count) or 0
            local retry_count = math.max(
                0,
                math.floor(math.max(
                    tonumber(step.retry_count) or 0,
                    tonumber(cfg.point_check_retry_count) or 3
                ))
            )
            if attempts < retry_count then
                state.level_up_maintenance_executor_point_check_miss_count = attempts + 1
                state.level_up_maintenance_executor_next_step_at = current_time
                    + M.level_up_maintenance_retry_wait_ms(cfg, step, "point_check_retry_wait_ms", tonumber(step.retry_wait_ms) or 500)
                logger(ctx).info(string.format(
                    "[Leveling] level-up maintenance point check retry | kind=%s level=%s plan=%s step=%d/%d key=%s attempts=%d/%d err=%s",
                    point_kind,
                    tostring(state.level_up_maintenance_executor_level or ""),
                    tostring(state.level_up_maintenance_executor_plan_label or ""),
                    index,
                    #steps,
                    tostring(step.key or ""),
                    attempts + 1,
                    retry_count,
                    tostring(point_err or "")
                ))
                return true
            end
            return M.fail_level_up_maintenance_executor(ctx, current_time, "point check failed: " .. tostring(point_err or ""))
        end

        state.level_up_maintenance_executor_point_check_miss_count = 0
        if points < min_value then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance no available points; mark plan done without clicking | kind=%s level=%s plan=%s step=%d/%d points=%s min=%d text=%s pos=(%s,%s) name=%s",
                point_kind,
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(points),
                min_value,
                type(point_meta) == "table" and tostring(point_meta.text or "") or "",
                type(point_meta) == "table" and tostring(point_meta.x or "") or "",
                type(point_meta) == "table" and tostring(point_meta.y or "") or "",
                type(point_meta) == "table" and tostring(point_meta.name or "") or ""
            ))
            if state.level_up_maintenance_executor_close_with_escape == true then
                state.level_up_maintenance_executor_close_pending = true
                state.level_up_maintenance_executor_next_step_at = current_time
                return true
            end
            local cleanup_clicked = false
            if step.cleanup_back_before_finish ~= false then
                cleanup_clicked = M.try_click_level_up_maintenance_back_button(ctx, "no_available_points") == true
            end
            if cleanup_clicked then
                M.level_up_maintenance_mark_current_plan_done_early(ctx, "no_available_points_cleanup")
                state.level_up_maintenance_executor_step_index = #steps + 1
                state.level_up_maintenance_executor_next_step_at = current_time
                    + M.level_up_maintenance_step_wait_ms(cfg, step, nil)
                return true
            end
            return M.finish_level_up_maintenance_executor(ctx, current_time)
        end

        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance available points confirmed | kind=%s level=%s plan=%s step=%d/%d points=%s min=%d text=%s pos=(%s,%s) name=%s",
            point_kind,
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(points),
            min_value,
            type(point_meta) == "table" and tostring(point_meta.text or "") or "",
            type(point_meta) == "table" and tostring(point_meta.x or "") or "",
            type(point_meta) == "table" and tostring(point_meta.y or "") or "",
            type(point_meta) == "table" and tostring(point_meta.name or "") or ""
        ))
        state.level_up_maintenance_executor_step_index = index + 1
        state.level_up_maintenance_executor_next_step_at = current_time
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
        return true
    end

    local image_preset = type(step) == "table" and type(step.image_preset) == "table" and step.image_preset or nil
    local repeat_image_until_missing = image_preset ~= nil
        and (step.repeat_image_until_missing == true or image_preset.repeat_until_missing == true)
    if repeat_image_until_missing then
        local max_count = math.max(
            1,
            math.floor(
                tonumber(step.repeat_image_until_missing_max_count)
                    or tonumber(image_preset.repeat_until_missing_max_count)
                    or 20
            )
        )
        local interval_ms = math.max(
            0,
            tonumber(step.repeat_image_until_missing_interval_ms)
                or tonumber(image_preset.repeat_until_missing_interval_ms)
                or 150
        )
        local missing_retry_count = math.max(
            0,
            math.floor(
                tonumber(step.missing_image_retry_count)
                    or tonumber(image_preset.missing_image_retry_count)
                    or 0
            )
        )
        local missing_retry_interval_ms = math.max(
            0,
            tonumber(step.missing_image_retry_interval_ms)
                or tonumber(image_preset.missing_image_retry_interval_ms)
                or interval_ms
        )
        local missing_retry_attempt = 0
        local clicked_count = 0
        local last_target = nil
        for attempt = 1, max_count do
            local loop_target, loop_fetch_err = fetch_locator_button_target(ctx, step)
            if not loop_target then
                if clicked_count <= 0 and missing_retry_attempt < missing_retry_count then
                    missing_retry_attempt = missing_retry_attempt + 1
                    logger(ctx).info(string.format(
                        "[Leveling] level-up maintenance image loop target absent; retry | kind=%s level=%s plan=%s step=%d/%d key=%s retry=%d/%d err=%s",
                        tostring(state.level_up_maintenance_executor_kind or ""),
                        tostring(state.level_up_maintenance_executor_level or ""),
                        tostring(state.level_up_maintenance_executor_plan_label or ""),
                        index,
                        #steps,
                        tostring(step.key or ""),
                        missing_retry_attempt,
                        missing_retry_count,
                        tostring(loop_fetch_err or "")
                    ))
                    if missing_retry_interval_ms > 0
                        and type(sys) == "table"
                        and type(sys.sleep) == "function"
                    then
                        sys.sleep(missing_retry_interval_ms)
                    end
                else
                    if step.missing_image_means_done == true then
                        logger(ctx).info(string.format(
                            "[Leveling] level-up maintenance image loop completed; mark plan done | kind=%s level=%s plan=%s step=%d/%d key=%s clicks=%d err=%s",
                            tostring(state.level_up_maintenance_executor_kind or ""),
                            tostring(state.level_up_maintenance_executor_level or ""),
                            tostring(state.level_up_maintenance_executor_plan_label or ""),
                            index,
                            #steps,
                            tostring(step.key or ""),
                            clicked_count,
                            tostring(loop_fetch_err or "")
                        ))
                        if step.cleanup_back_before_finish == true then
                            M.try_click_level_up_maintenance_back_button(ctx, "image_loop_missing_done")
                        end
                        M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_loop_missing_done")
                        return M.finish_level_up_maintenance_executor(ctx, current_time)
                    end
                    if clicked_count <= 0 and step.missing_image_means_step_done == true then
                        logger(ctx).info(string.format(
                            "[Leveling] level-up maintenance image loop target absent; skip step | kind=%s level=%s plan=%s step=%d/%d key=%s clicks=%d err=%s",
                            tostring(state.level_up_maintenance_executor_kind or ""),
                            tostring(state.level_up_maintenance_executor_level or ""),
                            tostring(state.level_up_maintenance_executor_plan_label or ""),
                            index,
                            #steps,
                            tostring(step.key or ""),
                            clicked_count,
                            tostring(loop_fetch_err or "")
                        ))
                        M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_loop_missing_step_done")
                        state.level_up_maintenance_executor_step_index = index + 1
                        local cfg = M.level_up_maintenance_config()
                        state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
                            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
                        return true
                    end
                    if clicked_count > 0 then
                        logger(ctx).info(string.format(
                            "[Leveling] level-up maintenance image loop completed; target absent | kind=%s level=%s plan=%s step=%d/%d key=%s clicks=%d err=%s",
                            tostring(state.level_up_maintenance_executor_kind or ""),
                            tostring(state.level_up_maintenance_executor_level or ""),
                            tostring(state.level_up_maintenance_executor_plan_label or ""),
                            index,
                            #steps,
                            tostring(step.key or ""),
                            clicked_count,
                            tostring(loop_fetch_err or "")
                        ))
                        M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_loop_target_absent")
                        state.level_up_maintenance_executor_step_index = index + 1
                        local cfg = M.level_up_maintenance_config()
                        state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
                            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
                        return true
                    end
                    return M.fail_level_up_maintenance_executor(
                        ctx,
                        current_time,
                        "fetch failed: " .. tostring(loop_fetch_err or "")
                    )
                end
            else
                local clicked, click_err = click_locator_button_target(ctx, step, loop_target)
                if not clicked then
                    return M.fail_level_up_maintenance_executor(ctx, current_time, "click failed: " .. tostring(click_err or ""))
                end
                clicked_count = clicked_count + 1
                last_target = loop_target
                logger(ctx).info(string.format(
                    "[Leveling] level-up maintenance image loop clicked | kind=%s level=%s plan=%s step=%d/%d key=%s loop=%d/%d addr=%s pos=(%s,%s)",
                    tostring(state.level_up_maintenance_executor_kind or ""),
                    tostring(state.level_up_maintenance_executor_level or ""),
                    tostring(state.level_up_maintenance_executor_plan_label or ""),
                    index,
                    #steps,
                    tostring(step.key or ""),
                    attempt,
                    max_count,
                    tostring(type(loop_target) == "table" and loop_target.addr or ""),
                    tostring(type(loop_target) == "table" and loop_target.x or ""),
                    tostring(type(loop_target) == "table" and loop_target.y or "")
                ))
                if interval_ms > 0
                    and attempt < max_count
                    and type(sys) == "table"
                    and type(sys.sleep) == "function"
                then
                    sys.sleep(interval_ms)
                end
            end
        end

        logger(ctx).warn(string.format(
            "[Leveling] level-up maintenance image loop reached max count; continue next step | kind=%s level=%s plan=%s step=%d/%d key=%s clicks=%d last_pos=(%s,%s)",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            clicked_count,
            tostring(type(last_target) == "table" and last_target.x or ""),
            tostring(type(last_target) == "table" and last_target.y or "")
        ))
        M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_loop_max_count")
        state.level_up_maintenance_executor_step_index = index + 1
        local cfg = M.level_up_maintenance_config()
        state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
            + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
        return true
    end

    if M.level_up_maintenance_step_requires_point_decrement(step) then
        return M.progress_level_up_maintenance_point_decrement_step(ctx, current_time, steps, index, step)
    end

    local cfg = M.level_up_maintenance_config()
    local target, fetch_err = M.fetch_level_up_maintenance_step_target(ctx, step, cfg)
    if not target then
        if type(step) == "table"
            and type(step.image_preset) == "table"
            and step.missing_image_means_done == true
        then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance image target absent; mark plan done | kind=%s level=%s plan=%s step=%d/%d key=%s err=%s",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                tostring(fetch_err or "")
            ))
            if step.cleanup_back_before_finish == true then
                M.try_click_level_up_maintenance_back_button(ctx, "image_missing_done")
            end
            M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_missing_done")
            return M.finish_level_up_maintenance_executor(ctx, current_time)
        end
        if type(step) == "table"
            and type(step.image_preset) == "table"
            and step.missing_image_means_step_done == true
        then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance image target absent; skip step | kind=%s level=%s plan=%s step=%d/%d key=%s err=%s",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                tostring(fetch_err or "")
            ))
            M.maybe_move_mouse_after_level_up_maintenance_image_done(ctx, step, "image_missing_step_done")
            state.level_up_maintenance_executor_step_index = index + 1
            local cfg = M.level_up_maintenance_config()
            state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
                + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
            return true
        end
        if type(step) == "table" and step.missing_target_means_plan_done == true then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance target absent; mark plan done | kind=%s level=%s plan=%s step=%d/%d key=%s err=%s",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                tostring(fetch_err or "")
            ))
            return M.finish_level_up_maintenance_executor(ctx, current_time)
        end
        if type(step) == "table" and step.missing_target_means_step_done == true then
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance target absent; skip step | kind=%s level=%s plan=%s step=%d/%d key=%s err=%s",
                tostring(state.level_up_maintenance_executor_kind or ""),
                tostring(state.level_up_maintenance_executor_level or ""),
                tostring(state.level_up_maintenance_executor_plan_label or ""),
                index,
                #steps,
                tostring(step.key or ""),
                tostring(fetch_err or "")
            ))
            state.level_up_maintenance_executor_step_index = index + 1
            local cfg = M.level_up_maintenance_config()
            state.level_up_maintenance_executor_next_step_at = now_ms(ctx)
                + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
            return true
        end
        return M.fail_level_up_maintenance_executor(ctx, current_time, "fetch failed: " .. tostring(fetch_err or ""))
    end
    local repeat_count = math.max(1, math.floor(tonumber(step.click_repeat_count or step.repeat_count) or 1))
    local repeat_interval_ms = math.max(0, tonumber(step.click_repeat_interval_ms or step.repeat_interval_ms) or 120)
    local repeat_interval_min_ms = tonumber(step.click_repeat_interval_min_ms or step.repeat_interval_min_ms)
    local repeat_interval_max_ms = tonumber(step.click_repeat_interval_max_ms or step.repeat_interval_max_ms)
    if repeat_interval_min_ms ~= nil or repeat_interval_max_ms ~= nil then
        repeat_interval_min_ms = math.max(0, math.floor(tonumber(repeat_interval_min_ms) or repeat_interval_ms))
        repeat_interval_max_ms = math.max(0, math.floor(tonumber(repeat_interval_max_ms) or repeat_interval_min_ms))
        if repeat_interval_max_ms < repeat_interval_min_ms then
            repeat_interval_min_ms, repeat_interval_max_ms = repeat_interval_max_ms, repeat_interval_min_ms
        end
    end
    local repeat_interval_label = tostring(repeat_interval_ms)
    if repeat_interval_min_ms ~= nil and repeat_interval_max_ms ~= nil then
        repeat_interval_label = tostring(repeat_interval_min_ms) .. "-" .. tostring(repeat_interval_max_ms)
    end
    for repeat_index = 1, repeat_count do
        local clicked, click_err = click_locator_button_target(ctx, step, target)
        if not clicked then
            return M.fail_level_up_maintenance_executor(
                ctx,
                current_time,
                string.format(
                    "click failed at repeat %d/%d: %s",
                    repeat_index,
                    repeat_count,
                    tostring(click_err or "")
                )
            )
        end
        if repeat_index < repeat_count and type(sys) == "table" and type(sys.sleep) == "function" then
            local current_repeat_interval_ms = repeat_interval_ms
            if repeat_interval_min_ms ~= nil and repeat_interval_max_ms ~= nil then
                current_repeat_interval_ms = repeat_interval_min_ms
                local interval_delta = repeat_interval_max_ms - repeat_interval_min_ms
                if interval_delta > 0 then
                    current_repeat_interval_ms = repeat_interval_min_ms + math.random(0, interval_delta)
                end
            end
            if current_repeat_interval_ms > 0 then
                sys.sleep(current_repeat_interval_ms)
            end
        end
    end
    if repeat_count > 1 then
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance step clicked repeatedly | kind=%s level=%s plan=%s step=%d/%d key=%s label=%s repeat=%d interval_ms=%s addr=%s pos=(%s,%s)",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            tostring(step.label or ""),
            repeat_count,
            repeat_interval_label,
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or "")
        ))
    else
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance step clicked | kind=%s level=%s plan=%s step=%d/%d key=%s label=%s addr=%s pos=(%s,%s)",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            tostring(step.label or ""),
            tostring(type(target) == "table" and target.addr or ""),
            tostring(type(target) == "table" and target.x or ""),
            tostring(type(target) == "table" and target.y or "")
        ))
    end
    if index >= #steps and M.level_up_maintenance_step_is_back_button(step) then
        M.level_up_maintenance_mark_current_plan_done_early(ctx, "final_back_clicked")
    end
    M.arm_level_up_maintenance_panel_open_death_guard(ctx, current_time, step, index, #steps)
    local post_click_sleep_ms = math.max(0, tonumber(step.post_click_sleep_ms or step.post_click_wait_ms) or 0)
    if post_click_sleep_ms > 0 and type(sys) == "table" and type(sys.sleep) == "function" then
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance post-click wait | kind=%s level=%s plan=%s step=%d/%d key=%s wait_ms=%d",
            tostring(state.level_up_maintenance_executor_kind or ""),
            tostring(state.level_up_maintenance_executor_level or ""),
            tostring(state.level_up_maintenance_executor_plan_label or ""),
            index,
            #steps,
            tostring(step.key or ""),
            post_click_sleep_ms
        ))
        sys.sleep(post_click_sleep_ms)
    end
    state.level_up_maintenance_executor_step_index = index + 1
    state.level_up_maintenance_executor_next_step_at = current_time
        + M.level_up_maintenance_step_wait_ms(cfg, step, steps[index + 1])
    return true
end

function M.record_level_up_maintenance_observation(ctx, current_time, level, progress, text)
    if not M.level_up_maintenance_enabled() then
        return false
    end

    local observed_level = math.floor(tonumber(level) or 0)
    if observed_level <= 0 then
        return false
    end

    current_time = tonumber(current_time) or now_ms(ctx)
    local cfg = M.level_up_maintenance_config()
    local character_id = nil
    if type(M.refresh_persistence_character_identity) == "function" then
        character_id = M.refresh_persistence_character_identity(ctx, true)
    elseif type(M.current_persistence_character_id) == "function" then
        character_id = M.current_persistence_character_id()
    end
    if type(character_id) ~= "string" or character_id == "" then
        character_id = nil
    end
    local previous_character_id = tostring(state.level_up_maintenance_observed_character_id or "")
    if character_id ~= nil then
        if previous_character_id ~= ""
            and previous_character_id ~= character_id
            and cfg.suppress_baseline_on_identity_change ~= false
        then
            state.level_up_maintenance_observed_character_id = character_id
            M.reset_level_up_maintenance_runtime_boundary(
                ctx,
                current_time,
                "character_identity_changed",
                observed_level,
                progress,
                text
            )
            return false
        end
        state.level_up_maintenance_observed_character_id = character_id
    end

    local previous_level = tonumber(state.level_up_maintenance_last_level)
    if previous_level == nil or previous_level <= 0 then
        state.level_up_maintenance_last_level = observed_level
        state.level_up_maintenance_last_progress = progress
        state.level_up_maintenance_last_level_text = text
        local low_new_max_level = math.max(
            1,
            math.floor(tonumber(cfg.new_character_baseline_suppress_max_level) or 3)
        )
        local suppress_reason = nil
        local prepared_id = tostring(state.persistence_character_cache_prepared_id or "")
        local prepared_level = tonumber(state.persistence_character_cache_prepared_level)
        if cfg.suppress_baseline_on_low_new_character ~= false
            and observed_level <= low_new_max_level
            and character_id ~= nil
            and prepared_id == character_id
            and state.persistence_character_cache_prepared_known ~= true
            and (prepared_level == nil or prepared_level == observed_level)
        then
            suppress_reason = "new_low_level_character"
        end
        local identity_drop_current = tonumber(state.persistence_character_identity_level_drop_current)
        if suppress_reason == nil
            and cfg.suppress_baseline_on_level_drop ~= false
            and identity_drop_current ~= nil
            and identity_drop_current == observed_level
        then
            suppress_reason = "identity_level_drop"
        end
        local persisted_max_level = nil
        if suppress_reason == nil and cfg.suppress_baseline_when_level_below_persisted ~= false then
            persisted_max_level = M.level_up_maintenance_persisted_max_completed_level()
            if persisted_max_level ~= nil
                and persisted_max_level > observed_level
                and observed_level <= low_new_max_level
            then
                suppress_reason = "level_below_persisted_completed"
            end
        end
        if suppress_reason ~= nil then
            M.reset_level_up_maintenance_runtime_boundary(
                ctx,
                current_time,
                suppress_reason,
                observed_level,
                progress,
                text
            )
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance baseline suppressed | reason=%s level=%d persisted_max=%s known=%s",
                tostring(suppress_reason),
                observed_level,
                tostring(persisted_max_level or ""),
                tostring(state.persistence_character_cache_prepared_known == true)
            ))
            return false
        end
        if M.level_up_maintenance_should_run_current_baseline(cfg, observed_level) then
            local pending_levels, has_skill, has_talent, pending_count, has_contract, kind_flags =
                M.level_up_maintenance_collect_baseline_pending_levels(cfg, observed_level)
            if pending_count > 0 then
            state.level_up_maintenance_pending_levels = pending_levels
            M.level_up_maintenance_replace_pending_kinds(kind_flags)
            state.level_up_maintenance_pending_since = current_time
            state.level_up_maintenance_safe_since = 0
            logger(ctx).info(string.format(
                "[Leveling] level-up maintenance baseline pending | level=%d progress=%s text=%s catch_up=%s pending_count=%d %s",
                observed_level,
                progress ~= nil and tostring(progress) or "",
                tostring(text or ""),
                M.level_up_maintenance_should_catch_up_baseline(cfg, observed_level) and "true" or "false",
                pending_count,
                M.level_up_maintenance_pending_summary()
            ))
            return true
            end
        end
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance baseline | level=%d progress=%s text=%s",
            observed_level,
            progress ~= nil and tostring(progress) or "",
            tostring(text or "")
        ))
        return false
    end

    state.level_up_maintenance_last_progress = progress
    state.level_up_maintenance_last_level_text = text

    if observed_level < previous_level then
        if cfg.suppress_baseline_on_level_drop ~= false then
            M.reset_level_up_maintenance_runtime_boundary(
                ctx,
                current_time,
                "observed_level_decreased",
                observed_level,
                progress,
                text
            )
        else
            state.level_up_maintenance_last_level = observed_level
        end
        return false
    end

    if observed_level == previous_level then
        state.level_up_maintenance_last_level = observed_level
        return false
    end

    local pending_levels = type(state.level_up_maintenance_pending_levels) == "table"
        and state.level_up_maintenance_pending_levels
        or {}
    local level_count = 0
    local skill_plan_count = 0
    local talent_plan_count = 0
    local contract_plan_count = 0
    local kind_plan_counts = {}
    local order = M.level_up_maintenance_plan_order(cfg)
    local catch_up_count = 0
    local catch_up_enabled = M.level_up_maintenance_should_catch_up_baseline(cfg, observed_level)
    if catch_up_enabled then
        local catch_up_pending_levels, _, _, pending_count, _, catch_up_kind_flags =
            M.level_up_maintenance_collect_baseline_pending_levels(cfg, observed_level)
        pending_levels = catch_up_pending_levels
        catch_up_count = tonumber(pending_count) or 0
        if type(catch_up_kind_flags) == "table" then
            for kind, value in pairs(catch_up_kind_flags) do
                if value == true then
                    kind_plan_counts[kind] = math.max(tonumber(kind_plan_counts[kind]) or 0, 1)
                end
            end
        end
    end
    for pending_level = previous_level + 1, observed_level do
        pending_levels[tostring(pending_level)] = true
        level_count = level_count + 1
        if M.level_up_maintenance_level_has_plan(cfg, "skill_by_level", pending_level) then
            skill_plan_count = skill_plan_count + 1
        end
        if M.level_up_maintenance_level_has_plan(cfg, "talent_by_level", pending_level) then
            talent_plan_count = talent_plan_count + 1
        end
        if M.level_up_maintenance_level_has_plan(cfg, "contract_by_level", pending_level) then
            contract_plan_count = contract_plan_count + 1
        end
        for _, raw_kind in ipairs(order) do
            local kind = tostring(raw_kind or "")
            if M.level_up_maintenance_kind_enabled(cfg, kind) then
                local plan = M.level_up_maintenance_get_level_plan(cfg, kind, pending_level)
                local steps = M.level_up_maintenance_plan_steps(plan)
                if type(steps) == "table"
                    and #steps > 0
                    and not M.level_up_maintenance_plan_done(kind, pending_level, plan)
                then
                    kind_plan_counts[kind] = (tonumber(kind_plan_counts[kind]) or 0) + 1
                end
            end
        end
        if level_count >= 50 then
            break
        end
    end

    state.level_up_maintenance_pending_levels = pending_levels
    M.level_up_maintenance_replace_pending_kinds(kind_plan_counts)
    if (tonumber(state.level_up_maintenance_pending_since) or 0) <= 0 then
        state.level_up_maintenance_pending_since = current_time
    end
    state.level_up_maintenance_safe_since = 0
    state.level_up_maintenance_last_level = observed_level

    logger(ctx).info(string.format(
        "[Leveling] level-up maintenance pending | from=%d to=%d progress=%s text=%s skill_plan_count=%d talent_plan_count=%d contract_plan_count=%d catch_up=%s catch_up_pending_count=%d %s",
        previous_level,
        observed_level,
        progress ~= nil and tostring(progress) or "",
        tostring(text or ""),
        skill_plan_count,
        talent_plan_count,
        contract_plan_count,
        catch_up_enabled and "true" or "false",
        catch_up_count,
        M.level_up_maintenance_pending_summary()
    ))
    return true
end

function M.maybe_observe_level_up_maintenance(ctx, current_time)
    if not M.level_up_maintenance_enabled() then
        return false
    end

    current_time = tonumber(current_time) or now_ms(ctx)
    local level, progress, text, err = M.refresh_route_point_action_player_level(ctx, current_time, false)
    if type(level) == "number" and level > 0 then
        state.level_up_maintenance_last_observe_error = nil
        return M.record_level_up_maintenance_observation(ctx, current_time, level, progress, text)
    end

    if err ~= nil and tostring(err) ~= tostring(state.level_up_maintenance_last_observe_error or "") then
        state.level_up_maintenance_last_observe_error = tostring(err)
        log_throttled(ctx, "level_up_maintenance_observe_failed", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] level-up maintenance observe failed | err=%s",
            tostring(err)
        ))
    end
    return false
end

function M.level_up_maintenance_has_pending()
    local pending = M.level_up_maintenance_pending_kind_map()
    for _, value in pairs(pending) do
        if value == true then
            return true
        end
    end
    return false
end

function M.clear_level_up_maintenance_soft_monster_observe()
    state.level_up_maintenance_soft_monster_since = 0
    state.level_up_maintenance_soft_monster_resource = nil
    state.level_up_maintenance_soft_monster_distance = nil
end

function M.level_up_maintenance_flow_block_reason(current_time)
    current_time = tonumber(current_time) or now_ms()

    if (tonumber(state.startup_state_resolve_until) or 0) > current_time
        and not (
            type(M.has_active_treasure_runtime) == "function"
            and M.has_active_treasure_runtime()
        )
    then
        return "startup_task_reacquire"
    end

    if state.require_task_button_refresh == true then
        return "task_button_refresh"
    end
    if current_time < (tonumber(state.task_update_wait_until) or 0) then
        return "task_update_wait"
    end
    if state.task_info_stability_gate_active == true then
        return "task_info_stability_gate"
    end
    if state.loading_transition_reacquire_pending == true then
        return "loading_transition_reacquire"
    end
    if type(M.is_task_entry_action_active) == "function" and M.is_task_entry_action_active(current_time) then
        return "task_entry_action"
    end
    if M.is_task_combat_or_post_loot_active() then
        return "task_combat_or_post_loot"
    end
    if type(state.task_target) == "table" then
        return "task_navigation_active"
    end
    if state.pending_interaction_origin ~= nil then
        return "pending_interaction"
    end
    if state.route_point_action_dialogue_active_key ~= nil
        or state.route_point_action_objective_active_key ~= nil
        or state.route_point_action_route_active_key ~= nil
    then
        return "route_point_action_active"
    end
    if state.task_recipe_active_key ~= nil then
        return "task_recipe_active"
    end

    local stage_name = tostring(state.stage or "")
    if stage_name == "wait_task_path_after_button"
        or stage_name == "wait_task_path_early_reclick"
        or stage_name == "refresh_task_button_after_dialogue"
        or stage_name == "wait_task_update"
        or stage_name == "startup_task_reacquire"
    then
        return stage_name
    end

    local last_task_click_at = tonumber(state.last_task_button_click_at) or 0
    if last_task_click_at > 0 and type(state.task_target) ~= "table" then
        local settle_ms = tonumber(TASK_BUTTON_SETTLE_MS) or 0
        local path_wait_until = math.max(
            last_task_click_at + settle_ms,
            tonumber(state.task_path_wait_until) or 0
        )
        if current_time < path_wait_until then
            return "wait_task_path_after_button"
        end
    end

    return nil
end

function M.level_up_maintenance_preemptible_flow_block(reason)
    reason = tostring(reason or "")
    return reason == "task_button_refresh"
        or reason == "refresh_task_button_after_dialogue"
        or reason == "wait_task_path_after_button"
        or reason == "wait_task_path_early_reclick"
        or reason == "task_navigation_active"
end

function M.prepare_level_up_maintenance_preempt_flow(ctx, current_time, reason)
    current_time = tonumber(current_time) or now_ms(ctx)
    reason = tostring(reason or "")
    if type(state.task_target) == "table" then
        clear_task_target_state()
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance preempts active navigation | reason=%s %s",
            reason,
            M.level_up_maintenance_pending_summary()
        ))
    end
    state.last_task_button_click_at = 0
    state.task_path_wait_until = 0
    state.task_path_early_retry_at = 0
    state.task_path_early_retry_count = 0
    state.next_task_button_click_at = math.min(tonumber(state.next_task_button_click_at) or current_time, current_time)
    release_async_combat_inputs(ctx, current_time, true)
    hold_navigation(ctx, current_time, "level_up_maintenance_preempt:" .. reason)
    log_throttled(ctx, "level_up_maintenance_preempt_" .. reason, "info", LOG_THROTTLE_MS, string.format(
        "[Leveling] level-up maintenance takes priority over main-flow wait | reason=%s %s",
        reason,
        M.level_up_maintenance_pending_summary()
    ))
end

function M.level_up_maintenance_safe_window(ctx, current_time, player_x, player_y, hp_ratio, in_main_interface, plan_info)
    current_time = tonumber(current_time) or now_ms(ctx)
    local cfg = M.level_up_maintenance_config()
    local plan = type(plan_info) == "table" and type(plan_info.plan) == "table" and plan_info.plan or {}
    local skip_safe_window = cfg.skip_safe_window == true and plan.skip_safe_window ~= false
    local function block(reason)
        state.level_up_maintenance_safe_since = 0
        M.clear_level_up_maintenance_soft_monster_observe()
        return false, reason
    end

    if in_main_interface == false then
        local has_player_position = type(player_x) == "number" and type(player_y) == "number"
        if cfg.allow_position_available_without_main_interface ~= true or not has_player_position then
            return block("not_main_interface")
        end
    end
    local low_hp_passthrough = false
    if not skip_safe_window and type(hp_ratio) == "number" and hp_ratio < (tonumber(cfg.min_hp_ratio) or 0.72) then
        if cfg.allow_low_hp_maintenance ~= true then
            return block(string.format("low_hp:%.2f", hp_ratio))
        end
        low_hp_passthrough = true
        log_throttled(ctx, "level_up_maintenance_low_hp_passthrough", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] level-up maintenance low hp passthrough | hp_ratio=%.2f %s",
            hp_ratio,
            M.level_up_maintenance_pending_summary()
        ))
    end
    local flow_block_reason = M.level_up_maintenance_flow_block_reason(current_time)
    if flow_block_reason ~= nil then
        if skip_safe_window and M.level_up_maintenance_preemptible_flow_block(flow_block_reason) then
            M.prepare_level_up_maintenance_preempt_flow(ctx, current_time, flow_block_reason)
        else
            return block(flow_block_reason)
        end
    end
    if state.task_info_stability_gate_active == true then
        return block("task_info_stability_gate")
    end
    if current_time < (tonumber(state.task_update_wait_until) or 0) then
        return block("task_update_wait")
    end
    if state.loading_transition_reacquire_pending == true then
        return block("loading_transition_reacquire")
    end
    if type(M.is_task_entry_action_active) == "function" and M.is_task_entry_action_active(current_time) then
        return block("task_entry_action")
    end
    if M.is_task_combat_or_post_loot_active() then
        return block("task_combat_or_post_loot")
    end
    if type(state.task_target) == "table" then
        return block("task_navigation_active")
    end
    if state.pending_interaction_origin ~= nil then
        return block("pending_interaction")
    end
    if state.route_point_action_dialogue_active_key ~= nil
        or state.route_point_action_objective_active_key ~= nil
        or state.route_point_action_route_active_key ~= nil
    then
        return block("route_point_action_active")
    end
    if state.task_recipe_active_key ~= nil then
        return block("task_recipe_active")
    end
    if type(M.level_up_maintenance_dialogue_block_reason) == "function" then
        local dialogue_reason = M.level_up_maintenance_dialogue_block_reason(ctx, current_time)
        if dialogue_reason ~= nil then
            return block(tostring(dialogue_reason))
        end
    end
    if skip_safe_window then
        state.level_up_maintenance_safe_since = current_time
        M.clear_level_up_maintenance_soft_monster_observe()
        return true, "ready_skip_safe_window"
    end

    local monster_guard_enabled = cfg.monster_guard_enabled ~= false
        and plan.monster_guard_enabled ~= false
    if monster_guard_enabled and not low_hp_passthrough then
        local nearby_monsters, monster_err = M.find_task_monsters(ctx, current_time, player_x, player_y)
        if type(nearby_monsters) == "table" and type(nearby_monsters.nearest) == "table" then
            local nearest_distance = tonumber(nearby_monsters.nearest.distance) or math.huge
            local guard_distance = math.max(120, tonumber(plan.monster_guard_distance) or tonumber(cfg.monster_guard_distance) or 620)
            local hard_distance = math.max(0, tonumber(plan.monster_hard_block_distance)
                or tonumber(cfg.monster_hard_block_distance)
                or 300)
            if nearest_distance <= guard_distance then
                if hard_distance > 0 and nearest_distance <= hard_distance then
                    return block(string.format("nearby_monster_hard:%.1f", nearest_distance))
                end

                local observe_ms = math.max(0, tonumber(plan.nearby_monster_soft_observe_ms)
                    or tonumber(cfg.nearby_monster_soft_observe_ms)
                    or 2000)
                if observe_ms <= 0 then
                    return block(string.format("nearby_monster:%.1f", nearest_distance))
                end

                local resource = M.level_up_maintenance_player_resource(ctx, current_time, true)
                if type(resource) ~= "number" then
                    state.level_up_maintenance_safe_since = 0
                    M.clear_level_up_maintenance_soft_monster_observe()
                    return false, string.format("nearby_monster_soft_no_resource:%.1f", nearest_distance)
                end

                local drop_epsilon = math.max(0, tonumber(plan.nearby_monster_soft_resource_drop_epsilon)
                    or tonumber(cfg.nearby_monster_soft_resource_drop_epsilon)
                    or 1)
                local since = tonumber(state.level_up_maintenance_soft_monster_since) or 0
                local baseline = tonumber(state.level_up_maintenance_soft_monster_resource)
                if since <= 0 or baseline == nil or resource < baseline - drop_epsilon then
                    state.level_up_maintenance_safe_since = 0
                    state.level_up_maintenance_soft_monster_since = current_time
                    state.level_up_maintenance_soft_monster_resource = resource
                    state.level_up_maintenance_soft_monster_distance = nearest_distance
                    return false, string.format("nearby_monster_soft_observe:%.1f", nearest_distance)
                end

                local elapsed = current_time - since
                if elapsed < observe_ms then
                    state.level_up_maintenance_safe_since = 0
                    state.level_up_maintenance_soft_monster_distance = nearest_distance
                    return false, string.format("nearby_monster_soft_observe:%.1f:%d", nearest_distance, math.max(0, observe_ms - elapsed))
                end

                M.clear_level_up_maintenance_soft_monster_observe()
                return true, "ready_soft_monster_passthrough"
            end
        elseif monster_err ~= nil then
            state.level_up_maintenance_last_block_reason = nil
        end
    end
    M.clear_level_up_maintenance_soft_monster_observe()

    local safe_since = tonumber(state.level_up_maintenance_safe_since) or 0
    if safe_since <= 0 then
        state.level_up_maintenance_safe_since = current_time
        return false, "safe_window_settle"
    end

    local settle_ms = math.max(0, tonumber(plan.safe_no_monster_ms) or tonumber(cfg.safe_no_monster_ms) or 1800)
    if current_time - safe_since < settle_ms then
        return false, string.format("safe_window_settle:%d", math.max(0, settle_ms - (current_time - safe_since)))
    end

    return true, "ready"
end

function M.maybe_handle_level_up_maintenance(ctx, current_time, player_x, player_y, player_z, hp_ratio, in_main_interface)
    if state.level_up_maintenance_executor_active == true then
        return M.progress_level_up_maintenance_executor(ctx, current_time)
    end

    if not M.level_up_maintenance_enabled() or not M.level_up_maintenance_has_pending() then
        return false
    end

    current_time = tonumber(current_time) or now_ms(ctx)
    if current_time < (tonumber(state.level_up_maintenance_next_retry_at) or 0) then
        return false
    end

    local cfg = M.level_up_maintenance_config()
    local next_plan_info = M.level_up_maintenance_find_next_plan(cfg)
    if type(next_plan_info) ~= "table" then
        M.level_up_maintenance_clear_pending_if_done(ctx)
        return false
    end
    if tostring(state.level_up_maintenance_last_observe_error or ""):find("player level text not found", 1, true) ~= nil then
        log_throttled(ctx, "level_up_maintenance_wait_level_text", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] level-up maintenance pending, waiting player level text before executor | err=%s %s",
            tostring(state.level_up_maintenance_last_observe_error or ""),
            M.level_up_maintenance_pending_summary()
        ))
        return false
    end
    local next_plan = type(next_plan_info) == "table" and type(next_plan_info.plan) == "table" and next_plan_info.plan or nil
    local default_skill_nonblocking = type(next_plan_info) == "table"
        and tostring(next_plan_info.kind or "") == "skill"
        and type(next_plan) == "table"
        and next_plan.default_skill_plan == true
        and cfg.default_skill_block_main_flow == false
        and state.level_up_maintenance_force_block_default_skill ~= true

    local safe, reason = M.level_up_maintenance_safe_window(ctx, current_time, player_x, player_y, hp_ratio, in_main_interface, next_plan_info)
    if not safe then
        if tostring(reason or "") ~= tostring(state.level_up_maintenance_last_block_reason or "") then
            state.level_up_maintenance_last_block_reason = tostring(reason or "")
            log_throttled(ctx, "level_up_maintenance_wait_" .. tostring(reason or ""), "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] level-up maintenance pending, waiting flow/safe window | reason=%s %s",
                tostring(reason or ""),
                M.level_up_maintenance_pending_summary()
            ))
        end
        local reason_text = tostring(reason or "")
        local wait_safe_reason = reason_text:match("^safe_window_settle")
            or reason_text:match("^nearby_monster")
            or reason_text:match("^low_hp")
        if wait_safe_reason then
            local reason_is_nearby_monster = reason_text:match("^nearby_monster") ~= nil
            if reason_is_nearby_monster then
                local nearby_since = tonumber(state.level_up_maintenance_nearby_block_since) or 0
                if nearby_since <= 0 then
                    nearby_since = current_time
                    state.level_up_maintenance_nearby_block_since = nearby_since
                end
                local hold_timeout = math.max(0,
                    tonumber(type(next_plan) == "table" and next_plan.nearby_monster_hold_timeout_ms)
                        or tonumber(cfg.nearby_monster_hold_timeout_ms)
                        or 7000)
                if hold_timeout > 0 and current_time - nearby_since >= hold_timeout then
                    local retry_ms = math.max(1000, tonumber(cfg.nearby_monster_defer_retry_ms) or 8000)
                    state.level_up_maintenance_next_retry_at = current_time + retry_ms
                    state.level_up_maintenance_safe_since = 0
                    state.level_up_maintenance_last_block_reason = nil
                    state.level_up_maintenance_nearby_block_since = nil
                    log_throttled(ctx, "level_up_maintenance_defer_nearby_monster", "info", LOG_THROTTLE_MS, string.format(
                        "[Leveling] level-up maintenance deferred to keep main flow moving | reason=%s waited_ms=%d retry_ms=%d %s",
                        reason_text,
                        math.max(0, current_time - nearby_since),
                        retry_ms,
                        M.level_up_maintenance_pending_summary()
                    ))
                    return false
                end
            else
                state.level_up_maintenance_nearby_block_since = nil
            end
            if default_skill_nonblocking then
                log_throttled(ctx, "level_up_maintenance_defer_default_skill_" .. reason_text, "info", LOG_THROTTLE_MS, string.format(
                    "[Leveling] default skill maintenance deferred without holding navigation | reason=%s %s",
                    reason_text,
                    M.level_up_maintenance_pending_summary()
                ))
                return false
            end
            state.stage = "level_up_maintenance_wait_safe"
            release_async_combat_inputs(ctx, current_time, true)
            hold_navigation(ctx, current_time, "level_up_maintenance_wait_safe:" .. reason_text)
            M.tick_combat_sidecar(ctx, current_time, player_x, player_y, player_z, hp_ratio, {
                phase = "level_up_maintenance_wait_safe",
                in_main_interface = in_main_interface,
                allow_when_main_interface_false = true
            })
            return true
        end
        return false
    end

    state.level_up_maintenance_nearby_block_since = nil
    state.level_up_maintenance_last_block_reason = nil
    if cfg.execute_ui ~= true then
        log_throttled(ctx, "level_up_maintenance_ready_no_executor", "info", LOG_THROTTLE_MS, string.format(
            "[Leveling] level-up maintenance safe window ready; UI executor disabled | pos=(%.2f,%.2f,%.2f) %s",
            tonumber(player_x) or 0,
            tonumber(player_y) or 0,
            tonumber(player_z) or 0,
            M.level_up_maintenance_pending_summary()
        ))
        return false
    end

    local plan_info = M.level_up_maintenance_find_next_plan(cfg)
    if type(plan_info) ~= "table" then
        M.level_up_maintenance_clear_pending_if_done(ctx)
        return false
    end

    local plan = type(plan_info.plan) == "table" and plan_info.plan or {}
    if plan.require_available_points ~= false
        and tostring(plan.require_available_points or "") ~= "defer"
        and cfg.require_available_points ~= false
    then
        local points, point_err, point_meta = M.level_up_maintenance_available_points(ctx, cfg)
        local min_value = 1
        if type(cfg.available_point_probe) == "table" then
            min_value = math.max(1, tonumber(cfg.available_point_probe.min_value) or 1)
        end
        if type(points) ~= "number" or points < min_value then
            log_throttled(ctx, "level_up_maintenance_no_available_points", "info", LOG_THROTTLE_MS, string.format(
                "[Leveling] level-up maintenance waiting available points | kind=%s level=%d plan=%s points=%s min=%d err=%s meta=%s %s",
                tostring(plan_info.kind or ""),
                tonumber(plan_info.level) or 0,
                tostring(plan.label or plan.key or plan_info.id or ""),
                tostring(points or ""),
                min_value,
                tostring(point_err or ""),
                type(point_meta) == "table" and string.format(
                    "text=%s pos=(%s,%s) name=%s",
                    tostring(point_meta.text or ""),
                    tostring(point_meta.x or ""),
                    tostring(point_meta.y or ""),
                    tostring(point_meta.name or "")
                ) or "",
                M.level_up_maintenance_pending_summary()
            ))
            state.level_up_maintenance_next_retry_at = current_time + math.max(1000, tonumber(cfg.retry_ms) or 5000)
            return false
        end
        logger(ctx).info(string.format(
            "[Leveling] level-up maintenance available points confirmed | kind=%s level=%d plan=%s points=%s text=%s pos=(%s,%s)",
            tostring(plan_info.kind or ""),
            tonumber(plan_info.level) or 0,
            tostring(plan.label or plan.key or plan_info.id or ""),
            tostring(points),
            type(point_meta) == "table" and tostring(point_meta.text or "") or "",
            type(point_meta) == "table" and tostring(point_meta.x or "") or "",
            type(point_meta) == "table" and tostring(point_meta.y or "") or ""
        ))
    end

    local started, start_err = M.start_level_up_maintenance_executor(ctx, current_time, plan_info)
    if not started then
        log_throttled(ctx, "level_up_maintenance_executor_start_failed", "warn", LOG_THROTTLE_MS, string.format(
            "[Leveling] level-up maintenance executor start failed; pending preserved | err=%s %s",
            tostring(start_err or ""),
            M.level_up_maintenance_pending_summary()
        ))
        return false
    end
    return M.progress_level_up_maintenance_executor(ctx, current_time)
end

function M.route_point_action_skip_reason(ctx, action, current_time)
    if type(action) ~= "table" then
        return nil
    end

    local task_refresh_completed, completed_state_key = M.route_point_action_completed_by_task_refresh(action)
    if task_refresh_completed then
        return "task_refresh_confirmed", completed_state_key
    end

    local pending_key = tostring(state.task_advancing_action_pending_key or "")
    local action_key = tostring(action.key or action.label or "")
    if pending_key ~= "" and action_key ~= "" and pending_key == action_key
        and M.route_point_action_advances_task(action)
    then
        return "task_refresh_pending", pending_key
    end
    if pending_key ~= "" and action_key ~= "" and pending_key ~= action_key
        and M.route_point_action_advances_task(action)
    then
        local deadline_at = tonumber(state.task_advancing_action_pending_deadline_at) or 0
        local pending_active = deadline_at <= 0 or (tonumber(current_time) or 0) <= deadline_at
        if pending_active then
            local pending_task = M.normalize_task_title_key(state.task_advancing_action_pending_task_name)
            local pending_detail = normalize_map_name(state.task_advancing_action_pending_task_detail)
            local current_task = M.normalize_task_title_key(M.current_task_log_name() or state.current_task_name)
            local current_detail = normalize_map_name(M.current_task_log_detail() or state.current_task_detail)
            local same_task = pending_task == nil or current_task == nil or pending_task == current_task
            local same_detail = pending_detail == nil or current_detail == nil or pending_detail == current_detail
            if same_task and same_detail then
                log_throttled(ctx, "route_point_action_skip_pending_other_" .. action_key, "info", LOG_THROTTLE_MS,
                    string.format(
                        "[Leveling] route point action skipped during pending task refresh | key=%s pending=%s task=%s detail=%s",
                        action_key,
                        pending_key,
                        tostring(current_task or ""),
                        tostring(current_detail or "")
                    ))
                return "task_refresh_pending_other", pending_key
            end
        end
    end

    local recipe_package_key = trim(action.recipe_package_key or "")
    local recipe_side_task_key = trim(action.recipe_side_task_key or "")
    if recipe_package_key ~= "" and recipe_side_task_key ~= ""
        and M.recipe_progress_side_completed(recipe_package_key, recipe_side_task_key)
    then
        return "recipe_side_completed", recipe_side_task_key
    end

    local min_level = tonumber(action.skip_when_player_level_at_least)
    local route_level = nil
    local route_progress = nil
    local route_level_text = nil
    local route_level_err = nil
    local treasure_key = trim(action.skip_when_treasure_completed_key or "")
    local treasures = type(state.treasure_persisted) == "table"
        and type(state.treasure_persisted.treasures) == "table"
        and state.treasure_persisted.treasures
        or nil
    local treasure_record = type(treasures) == "table" and treasures[treasure_key] or nil
    if treasure_key ~= "" and type(treasure_record) == "table" and treasure_record.completed == true then
        if min_level ~= nil and min_level > 0 then
            route_level, route_progress, route_level_text, route_level_err = M.refresh_route_point_action_player_level(ctx, current_time, false)
            if type(route_level) == "number" and route_level < min_level then
                return nil
            end
        end
        return "treasure_completed", treasure_key
    end

    if min_level ~= nil and min_level > 0 then
        local level, progress, text, err = route_level, route_progress, route_level_text, route_level_err
        if type(level) ~= "number" and err == nil then
            level, progress, text, err = M.refresh_route_point_action_player_level(ctx, current_time, false)
        end
        if type(level) == "number" and level >= min_level then
            return "player_level_reached", string.format(
                "level=%d progress=%s target=%d text=%s",
                level,
                progress ~= nil and tostring(progress) or "",
                math.floor(min_level),
                tostring(text or "")
            )
        end
        if err ~= nil then
            return nil, err
        end
    end

    return nil
end

function M.build_task_intent_candidate(kind, matched_source, matched_key, config, reason)
    return {
        kind = tostring(kind or ""),
        matched_source = tostring(matched_source or ""),
        matched_key = tostring(matched_key or ""),
        config = type(config) == "table" and config or nil,
        reason = tostring(reason or "")
    }
end

function M.route_point_action_intent_kind(action)
    local mode = tostring(type(action) == "table" and action.mode or "")
    if mode == "lift_transition" then
        return "route_point_boarding"
    end
    if mode == "npc_dialogue_point" then
        return "route_point_npc_dialogue"
    end
    if mode == "objective_button_flow_point" then
        return "route_point_objective"
    end
    if mode == "recorded_route_point" then
        return "route_point_recorded_route"
    end
    return ""
end

function M.current_route_point_active_intent()
    local has_task_target = type(state.task_target) == "table"
    local route_wait_until = tonumber(state.route_point_action_route_wait_reacquire_until) or 0
    local route_wait_key = tostring(state.route_point_action_route_wait_key or "")
    if route_wait_until > 0 and route_wait_key ~= "" then
        local action = M.find_route_point_action_by_key(route_wait_key)
        return M.build_task_intent_candidate(
            "route_point_recorded_route",
            "route_point_active",
            route_wait_key,
            action,
            "recorded_route_wait_active"
        )
    end

    local active_specs = {
        {
            key = tostring(state.route_point_action_active_key or ""),
            kind = "route_point_boarding"
        },
        {
            key = tostring(state.route_point_action_dialogue_active_key or ""),
            kind = "route_point_npc_dialogue"
        },
        {
            key = tostring(state.route_point_action_route_active_key or ""),
            kind = "route_point_recorded_route"
        },
        {
            key = tostring(state.route_point_action_objective_active_key or ""),
            kind = "route_point_objective"
        }
    }

    for _, item in ipairs(active_specs) do
        local active_key = tostring(type(item) == "table" and item.key or "")
        if active_key ~= "" then
            local action = M.find_route_point_action_by_key(active_key)
            if type(action) == "table"
                and (
                    (action.direct_without_task_target_only == true and has_task_target)
                    or (
                        action.drop_active_when_task_mismatch == true
                        and not M.route_point_action_matches_task(action)
                    )
                )
            then
                local kind = tostring(type(item) == "table" and item.kind or "")
                if kind == "route_point_boarding" then
                    M.clear_route_point_action_board_state()
                elseif kind == "route_point_npc_dialogue" then
                    M.clear_route_point_action_npc_dialogue_state()
                elseif kind == "route_point_recorded_route" then
                    M.clear_route_point_action_route_state()
                elseif kind == "route_point_objective" then
                    M.clear_route_point_action_objective_state()
                end
            else
                return M.build_task_intent_candidate(
                    tostring(item.kind or ""),
                    "route_point_active",
                    active_key,
                    action,
                    "active_route_point_action"
                )
            end
        end
    end

    return nil
end

function M.find_route_point_intent_candidate(ctx, current_time, player_x, player_y, player_z, opts)
    if type(M.ROUTE_POINT_ACTIONS) ~= "table" or #M.ROUTE_POINT_ACTIONS == 0 then
        return nil
    end

    opts = type(opts) == "table" and opts or {}
    local require_allow_without_task_target = opts.require_allow_without_task_target == true
    local require_wait_task_path_recover = opts.require_wait_task_path_recover == true
    local allow_during_task_button_refresh = opts.allow_during_task_button_refresh == true
    local require_allow_during_task_button_refresh = opts.require_allow_during_task_button_refresh == true
    local has_task_target = opts.has_target == true
        or type(state.task_target) == "table"

    if M.is_task_combat_or_post_loot_active() then
        return nil
    end
    if (state.require_task_button_refresh == true and not allow_during_task_button_refresh)
        or current_time < (tonumber(state.task_update_wait_until) or 0)
        or current_time < (tonumber(state.task_dialogue_flow_waiting_jump_until) or 0)
        or (tonumber(state.dialogue_escape_due_at) or 0) > 0
    then
        return nil
    end

    local persisted_candidate = M.find_persisted_recipe_route_point_candidate(
        ctx,
        current_time,
        player_x,
        player_y,
        player_z,
        opts
    )
    if type(persisted_candidate) == "table" then
        return persisted_candidate
    end

    local nearest_candidate = nil
    local nearest_candidate_distance = nil
    for _, action in ipairs(M.ROUTE_POINT_ACTIONS) do
        local kind = M.route_point_action_intent_kind(action)
        if kind ~= "" then
            local action_allows_without_task_target = type(action) == "table" and action.allow_without_task_target == true
            local action_allows_wait_task_path_recover = type(action) == "table" and action.allow_wait_task_path_recover == true
            local allow_candidate = true
            if require_allow_without_task_target and not action_allows_without_task_target then
                allow_candidate = false
            end
            if allow_candidate and require_wait_task_path_recover and not action_allows_wait_task_path_recover then
                allow_candidate = false
            end
            if allow_candidate
                and action.wait_task_path_recover_only == true
                and not require_wait_task_path_recover
            then
                allow_candidate = false
            end
            if allow_candidate
                and require_allow_during_task_button_refresh
                and action.allow_during_task_button_refresh ~= true
            then
                allow_candidate = false
            end
            if allow_candidate
                and state.require_task_button_refresh == true
                and action.allow_during_task_button_refresh ~= true
            then
                allow_candidate = false
            end
            if allow_candidate
                and action.direct_without_task_target_only == true
                and has_task_target
            then
                allow_candidate = false
            end
            if allow_candidate and M.route_point_action_matches_task(action) then
                local skip_reason = select(1, M.route_point_action_skip_reason(ctx, action, current_time))
                if skip_reason == nil then
                    local trigger = type(action) == "table" and action.trigger or nil
                    local dialogue = type(action) == "table" and action.dialogue or nil
                    local trigger_x = tonumber(trigger and trigger.x)
                    local trigger_y = tonumber(trigger and trigger.y)
                    local trigger_z = tonumber(trigger and trigger.z)
                    local direct_task_match = (action.direct_when_task_active == true
                        or action.activate_on_task_match == true)
                        and not (action.direct_without_task_target_only == true and has_task_target)
                    local nearest_task_dialogue = action.select_nearest_task_dialogue == true
                        or action.select_nearest_dialogue == true
                    local anchor_x = trigger_x
                    local anchor_y = trigger_y
                    local anchor_z = trigger_z
                    if nearest_task_dialogue and (anchor_x == nil or anchor_y == nil) then
                        anchor_x = tonumber(dialogue and dialogue.x)
                        anchor_y = tonumber(dialogue and dialogue.y)
                        anchor_z = tonumber(dialogue and dialogue.z)
                    end
                    local trigger_radius = math.max(80, tonumber(trigger and trigger.radius) or tonumber(action.trigger_radius) or 220)
                    local z_tolerance = math.max(0, tonumber(trigger and trigger.z_tolerance) or tonumber(dialogue and dialogue.z_tolerance) or 260)
                    if anchor_x ~= nil and anchor_y ~= nil then
                        local trigger_distance = distance_2d(player_x, player_y, anchor_x, anchor_y)
                        local z_gap = anchor_z ~= nil and type(player_z) == "number"
                            and math.abs((tonumber(player_z) or 0) - anchor_z)
                            or 0
                        if direct_task_match
                            or (trigger_x ~= nil and trigger_y ~= nil and trigger_distance <= trigger_radius and z_gap <= z_tolerance)
                        then
                            local map_match = select(1, M.route_point_action_matches_current_map(ctx, action, current_time))
                            local destination_match = select(1, M.route_point_action_destination_matches(action, player_x, player_y))
                            if map_match == true and destination_match == true then
                                local state_key = M.route_point_action_state_key(action)
                                local last_triggered_at = tonumber(state.map_transition_triggered[state_key]) or 0
                                local retry_ms = math.max(1000, tonumber(action.retry_ms) or 3000)
                                if last_triggered_at <= 0 or current_time - last_triggered_at >= retry_ms then
                                    local candidate = M.build_task_intent_candidate(
                                        kind,
                                        "route_point_candidate",
                                        tostring(action.key or action.label or ""),
                                        action,
                                        string.format(
                                            "trigger_distance=%.2f z_gap=%.2f direct=%s",
                                            trigger_distance,
                                            z_gap,
                                            direct_task_match and "true" or "false"
                                        )
                                    )
                                    if nearest_task_dialogue then
                                        if nearest_candidate_distance == nil
                                            or trigger_distance < nearest_candidate_distance
                                        then
                                            nearest_candidate = candidate
                                            nearest_candidate_distance = trigger_distance
                                        end
                                    else
                                        return candidate
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if type(nearest_candidate) == "table" then
        return nearest_candidate
    end

    return nil
end

function M.find_npc_near_point(ctx, point_x, point_y, search_radius, player_x, player_y, opts)
    local nav_mod = nav_api(ctx)
    if type(nav_mod) ~= "table" or type(nav_mod.enum_npcs) ~= "function" then
        return nil, "nav.enum_npcs is unavailable."
    end

    local items, enum_err = nav_mod.enum_npcs()
    if type(items) ~= "table" then
        return nil, enum_err or "EnumNPC failed."
    end

    local anchor_x = tonumber(point_x)
    local anchor_y = tonumber(point_y)
    if anchor_x == nil or anchor_y == nil then
        return nil, "NPC anchor point is unavailable."
    end

    local max_distance = math.max(120, tonumber(search_radius) or 420)
    local target_entity_id = nil
    local min_entity_id = nil
    if type(opts) == "table" then
        target_entity_id = as_number(opts.npc_entity_id or opts.npcEntityId or opts.entityId or opts.entityID)
        min_entity_id = as_number(opts.npc_entity_id_min or opts.npcEntityIdMin or opts.minEntityId)
    end
    local prefer_player_nearest = type(opts) == "table"
        and (opts.prefer_player_nearest == true or opts.prefer_anchor_nearest ~= true)
    local nearest = nil
    local best_anchor_distance = nil
    local best_player_distance = nil

    for _, item in ipairs(items) do
        local item_entity_id = type(item) == "table"
            and as_number(item.entityId or item.entityID or item.id or item.Id or item.ID)
            or nil
        if (target_entity_id == nil or item_entity_id == target_entity_id)
            and (min_entity_id == nil or (item_entity_id ~= nil and item_entity_id > min_entity_id))
        then
            local x, y, z = extract_position_from_item(ctx, item)
            if x ~= nil and y ~= nil then
                local anchor_distance = distance_2d(anchor_x, anchor_y, x, y)
                local player_distance = type(player_x) == "number" and type(player_y) == "number"
                    and distance_2d(player_x, player_y, x, y)
                    or anchor_distance
                local better = false
                if anchor_distance <= max_distance then
                    if prefer_player_nearest and type(player_distance) == "number" then
                        better = best_player_distance == nil
                            or player_distance < best_player_distance
                            or (
                                player_distance == best_player_distance
                                and (best_anchor_distance == nil or anchor_distance < best_anchor_distance)
                            )
                    else
                        better = best_anchor_distance == nil or anchor_distance < best_anchor_distance
                    end
                end
                if better then
                    nearest = {
                        item = item,
                        x = x,
                        y = y,
                        z = z,
                        entity_id = item_entity_id,
                        label = npc_label(item),
                        point_distance = anchor_distance,
                        distance = player_distance
                    }
                    best_anchor_distance = anchor_distance
                    best_player_distance = player_distance
                end
            end
        end
    end

    if nearest then
        return nearest, nil
    end

    if target_entity_id ~= nil then
        return nil, string.format("No NPC entityId=%s near point %.2f, %.2f within %.2f", tostring(target_entity_id), anchor_x, anchor_y, max_distance)
    end
    if min_entity_id ~= nil then
        return nil, string.format("No NPC entityId>%s near point %.2f, %.2f within %.2f", tostring(min_entity_id), anchor_x, anchor_y, max_distance)
    end
    return nil, string.format("No NPC near point %.2f, %.2f within %.2f", anchor_x, anchor_y, max_distance)
end

function M.arm_route_point_action_board(ctx, action, state_key, current_time, source)
    local board = type(action) == "table" and action.board or nil
    if type(board) ~= "table" then
        return false
    end

    state.route_point_action_active_key = tostring(action.key or action.label or "")
    state.route_point_action_active_state_key = tostring(state_key or "")
    state.route_point_action_board_entered_at = 0
    state.route_point_action_board_next_interact_at = tonumber(current_time) or now_ms(ctx)
    state.route_point_action_board_deadline_at = (tonumber(current_time) or now_ms(ctx))
        + math.max(6000, tonumber(board.timeout_ms) or 18000)

    logger(ctx).info(string.format(
        "[Leveling] route point action board armed | task=%s key=%s source=%s center=%.2f, %.2f, %.2f radius=%.2f timeout=%dms",
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(action.key or action.label or ""),
        tostring(source or "trigger"),
        tonumber(board.x) or 0,
        tonumber(board.y) or 0,
        tonumber(board.z) or 0,
        math.max(80, tonumber(board.radius) or 180),
        math.max(6000, tonumber(board.timeout_ms) or 18000)
    ))

    return true
end

function M.arm_route_point_action_npc_dialogue(ctx, action, state_key, current_time, source)
    local dialogue = type(action) == "table" and action.dialogue or nil
    if type(dialogue) ~= "table" then
        return false
    end

    state.route_point_action_dialogue_active_key = tostring(action.key or action.label or "")
    state.route_point_action_dialogue_active_state_key = tostring(state_key or "")
    state.route_point_action_dialogue_entered_at = 0
    state.route_point_action_dialogue_next_interact_at = tonumber(current_time) or now_ms(ctx)
    state.route_point_action_dialogue_deadline_at = (tonumber(current_time) or now_ms(ctx))
        + math.max(6000, tonumber(dialogue.timeout_ms) or 18000)
    state.route_point_action_dialogue_locked_entity_id = nil
    state.route_point_action_dialogue_locked_x = nil
    state.route_point_action_dialogue_locked_y = nil
    state.route_point_action_dialogue_locked_z = nil
    state.route_point_action_dialogue_locked_at = 0

    logger(ctx).info(string.format(
        "[Leveling] route point action npc dialogue armed | task=%s key=%s source=%s point=%.2f, %.2f, %.2f radius=%.2f timeout=%dms",
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(action.key or action.label or ""),
        tostring(source or "trigger"),
        tonumber(dialogue.x) or 0,
        tonumber(dialogue.y) or 0,
        tonumber(dialogue.z) or 0,
        math.max(80, tonumber(dialogue.radius) or 220),
        math.max(6000, tonumber(dialogue.timeout_ms) or 18000)
    ))

    return true
end

function M.arm_route_point_action_objective(ctx, action, state_key, current_time, source)
    local trigger = type(action) == "table" and action.trigger or nil
    local step = type(action) == "table" and action.step or nil
    local hotkey_vk = type(M.route_point_action_hotkey_vk) == "function" and M.route_point_action_hotkey_vk(action) or nil
    if type(trigger) ~= "table" or (type(step) ~= "table" and hotkey_vk == nil) then
        return false
    end

    state.route_point_action_objective_active_key = tostring(action.key or action.label or "")
    state.route_point_action_objective_active_state_key = tostring(state_key or "")
    state.route_point_action_objective_entered_at = tonumber(current_time) or now_ms(ctx)
    state.route_point_action_objective_next_probe_at = tonumber(current_time) or now_ms(ctx)
    state.route_point_action_objective_deadline_at = (tonumber(current_time) or now_ms(ctx))
        + math.max(6000, tonumber(action.timeout_ms) or 18000)

    logger(ctx).info(string.format(
        "[Leveling] route point action objective armed | task=%s key=%s source=%s point=%.2f, %.2f, %.2f radius=%.2f interact_radius=%.2f timeout=%dms",
        tostring(M.current_task_log_name() or state.current_task_name or ""),
        tostring(action.key or action.label or ""),
        tostring(source or "trigger"),
        tonumber(trigger.x) or 0,
        tonumber(trigger.y) or 0,
        tonumber(trigger.z) or 0,
        math.max(80, tonumber(trigger.radius) or 220),
        math.max(40, tonumber(action.interact_radius) or tonumber(step and step.hint_max_distance) or 120),
        math.max(6000, tonumber(action.timeout_ms) or 18000)
    ))

    return true
end

function M.arm_task_entry_action_after_route_point(ctx, current_time, action)
    local entry_action, task_name = M.current_task_entry_action_config({
        allow_deferred_entry_action = true
    })
    if type(entry_action) ~= "table" or tostring(entry_action.mode or "") ~= "world_map_send" then
        return false, "current task has no world_map_send entry action"
    end

    current_time = tonumber(current_time) or now_ms(ctx)
    local map_open_wait_ms = math.max(200, tonumber(entry_action.map_open_wait_ms) or 900)
    local timeout_ms = math.max(5000, tonumber(entry_action.timeout_ms) or 12000)

    clear_task_target_state()
    clear_runtime_objective_caches()
    M.clear_task_entry_action_state()

    state.require_task_button_refresh = false
    state.task_update_wait_until = 0
    state.last_task_button_click_at = current_time
    state.task_entry_action_button_click_at = current_time
    state.task_entry_action_center_clicked_at = 0
    state.task_entry_action_next_center_click_at = current_time + map_open_wait_ms
    state.task_entry_action_pre_clicked_at = 0
    state.task_entry_action_send_clicked_at = 0
    state.task_entry_action_locked_cfg = entry_action
    state.task_entry_action_locked_task_name = task_name
    state.task_entry_action_locked_key = tostring(entry_action.key or "")
    state.task_path_wait_until = math.max(
        tonumber(state.task_path_wait_until) or 0,
        current_time + map_open_wait_ms + 1000
    )
    state.next_task_button_click_at = math.max(
        tonumber(state.next_task_button_click_at) or 0,
        current_time + timeout_ms
    )
    state.next_task_refresh_at = math.max(
        tonumber(state.next_task_refresh_at) or 0,
        current_time + map_open_wait_ms
    )
    state.pause_combat_until = math.max(
        tonumber(state.pause_combat_until) or 0,
        current_time + POST_UI_PAUSE_MS
    )
    clear_pending_interaction()

    logger(ctx).info(string.format(
        "[Leveling] route point action armed task entry action | task=%s key=%s entry_key=%s wait=%dms",
        tostring(task_name or state.current_task_name or ""),
        tostring(type(action) == "table" and (action.key or action.label) or ""),
        tostring(entry_action.key or ""),
        tonumber(map_open_wait_ms) or 0
    ))
    return true, nil
end

function M.arm_task_entry_action_after_task_objective(ctx, current_time, objective_button)
    local entry_action, task_name = M.current_task_entry_action_config({
        allow_deferred_entry_action = true
    })
    if type(entry_action) ~= "table" or tostring(entry_action.mode or "") ~= "world_map_send" then
        return false, "current task has no world_map_send entry action"
    end

